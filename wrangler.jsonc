{
  // Cloudflare Workers (Workers Builds): serves the static site built into ./dist by `bun run build:production`.
  // Same Worker name as the reference site = this deploy replaces it at the same domain (docs/deploy-cloudflare.md).
  "name": "housyspace-web",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // `trailingSlash: "never"`: /es/ answers 307 to /es.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only pages pass through worker.js (host redirect, noindex on previews); build assets are served directly.
    "run_worker_first": ["/*", "!/_astro/*", "!/brand/*", "!/media/*", "!/pdf/*"]
  }
}
