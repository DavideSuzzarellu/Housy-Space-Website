---
/** Whole-number input (prices, areas) styled for dark backgrounds. */
interface Props {
  id: string;
  name: string;
  placeholder?: string;
  min?: number;
  step?: number;
  class?: string;
}

const { id, name, placeholder, min = 0, step = 1, class: className } = Astro.props;
---

<input
  id={id}
  name={name}
  type="number"
  inputmode="numeric"
  min={min}
  step={step}
  placeholder={placeholder}
  class:list={[
    "min-h-11 w-full border border-line bg-bg-deep px-3.5 py-2.5 text-sm text-fg transition-colors placeholder:text-muted/70 hover:border-muted",
    className,
  ]}
/>
