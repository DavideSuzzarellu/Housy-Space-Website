---
interface Props {
  tone?: "dark" | "accent";
  class?: string;
}

const { tone = "dark", class: className } = Astro.props;

const TONES = {
  dark: "bg-ink/80 text-fg",
  accent: "bg-turquoise font-medium text-ink",
} as const;
---

<span
  class:list={[
    "inline-block px-2.5 py-1.5 text-[0.6875rem] tracking-[0.12em] uppercase",
    TONES[tone],
    className,
  ]}
>
  <slot />
</span>
