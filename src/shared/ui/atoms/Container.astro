---
interface Props {
  /** `editorial`: the 1128 px column with fluid side padding of the about page (reference `nx-w`). */
  width?: "page" | "editorial";
  /** Layout-only extra classes. */
  class?: string;
}

const { width = "page", class: className } = Astro.props;
---

<div
  class:list={[
    "mx-auto",
    width === "editorial"
      ? "w-[min(1128px,100%-2*clamp(1rem,4vw,3.5rem))]"
      : "w-full max-w-280 px-5.5",
    className,
  ]}
>
  <slot />
</div>
