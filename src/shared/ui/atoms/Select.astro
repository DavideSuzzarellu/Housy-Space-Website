---
/** Native select styled for dark backgrounds. Label it with `FormField` or a `<label for>`. */
export interface SelectOption {
  readonly value: string;
  readonly label: string;
}

interface Props {
  id: string;
  name: string;
  options: readonly SelectOption[];
  /** Initially selected value. */
  value?: string;
  /** Associates the control with a form outside its ancestors. */
  form?: string;
  /** `bare`: borderless text on a glass cell (search bar); `glass`: outlined field on the glass panel. */
  variant?: "field" | "bare" | "glass";
  class?: string;
}

const { id, name, options, value, form, variant = "field", class: className } = Astro.props;

const VARIANTS = {
  field:
    "min-h-11 w-full border border-line bg-canvas px-3.5 py-2.5 text-sm text-fg transition-colors hover:border-muted",
  bare: "h-8.5 w-full cursor-pointer bg-transparent pt-1 pb-0.5 text-sm text-fg focus:outline-none [&_option]:bg-canvas",
  glass:
    "h-11.5 w-full min-w-0 border border-white/28 bg-transparent px-3 text-[0.8125rem] text-fg [&_option]:bg-canvas",
} as const;
---

<select id={id} name={name} form={form} class:list={[VARIANTS[variant], className]}>
  {options.map((option) => (
    <option value={option.value} selected={option.value === value}>
      {option.label}
    </option>
  ))}
</select>
