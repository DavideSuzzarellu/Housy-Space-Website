---
import ArrowUpRight from "./ArrowUpRight.astro";

/**
 * Link styled as a button (CTAs navigate), or a form submit button with the same look.
 * Turquoise fill sweeps in from the left on hover/focus with ink text (reference `.btn`).
 */
interface Common {
  variant?: "outline" | "solid" | "paper" | "accent";
  /** `sm`: compact control of proposal v3 (newsletter, 34 px); `big`: 61.5 px (reference `.btn.big`, "Mi búsqueda"); `xl`: 68 px home CTA; `wide`: block CTA (label left, arrow pushed right, arrow slides on hover). */
  size?: "sm" | "md" | "lg" | "big" | "xl" | "wide";
  /** Trailing up-right arrow (main CTAs of proposal v3). */
  arrow?: boolean;
  class?: string;
}

interface LinkProps extends Common {
  href: string;
  type?: never;
  /** Opens in a new tab; `newTabLabel` is announced to screen readers. */
  external?: boolean;
  newTabLabel?: string;
  /** Downloads the (same-origin) target instead of opening it; the value is the file name. */
  download?: string;
}

interface SubmitProps extends Common {
  /** `button`: a plain button (its action is bound by a script or a delegating parent). */
  type: "submit" | "button";
  href?: never;
  external?: never;
  newTabLabel?: never;
  download?: never;
}

type Props = LinkProps | SubmitProps;

const {
  href,
  type,
  variant = "outline",
  size = "md",
  arrow = false,
  external = false,
  newTabLabel,
  download,
  class: className,
} = Astro.props;

const VARIANTS = {
  outline: "border-current text-inherit",
  /** Turquoise outline with accent text (PDF download of the property side box). */
  accent: "border-turquoise text-accent",
  solid: "border-fg bg-fg text-canvas",
  /** Paper fill with dark text on any dark block or photo, whatever the surface roles say. */
  paper: "border-paper bg-paper text-dark",
} as const;

const SIZES = {
  sm: "justify-center min-h-8.5 gap-3.5 px-4.5 text-[0.625rem]",
  md: "justify-center min-h-11 gap-3.5 px-6.5 py-4 text-xs",
  lg: "justify-center min-h-11 gap-3.5 px-10 py-[1.3125rem] text-[0.8125rem] leading-[1.54]",
  big: "justify-center min-h-11 gap-3.5 px-10 py-5 text-[0.8125rem] leading-[1.5]",
  /** Home CTAs: 68 px tall, padding and type scale with the viewport. */
  xl: "justify-center min-h-17 gap-3.5 px-[clamp(1.625rem,3.4vw,3.25rem)] py-[1.3125rem] text-[clamp(0.75rem,1.05vw,0.875rem)] leading-[1.35]",
  wide: "min-h-11 justify-between gap-4 py-4.5 pr-6 pl-7 text-xs leading-[1.2] [&_svg]:h-3 [&_svg]:w-6.5 [&_svg]:transition-transform [&_svg]:duration-500 [&:hover_svg]:translate-x-1.5 [&:focus-visible_svg]:translate-x-1.5",
} as const;

const classes = [
  "relative isolate inline-flex cursor-pointer items-center overflow-hidden border text-center font-sans font-medium tracking-[0.12em] uppercase no-underline transition-colors duration-350",
  "before:absolute before:inset-0 before:-z-10 before:origin-left before:scale-x-0 before:bg-turquoise before:transition-transform before:duration-450 before:ease-brand",
  "hover:border-turquoise hover:text-ink hover:before:scale-x-100 focus-visible:border-turquoise focus-visible:text-ink focus-visible:before:scale-x-100",
  VARIANTS[variant],
  SIZES[size],
  className,
];
---

{type !== undefined ? (
  <button type={type} class:list={classes}>
    <slot />
    {arrow && <ArrowUpRight class="size-2.75" />}
  </button>
) : (
  <a
    href={href}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
    download={download}
    data-astro-prefetch={download === undefined ? undefined : "false"}
    class:list={classes}
  >
    <slot />
    {arrow && <ArrowUpRight class="size-2.75" />}
    {external && newTabLabel !== undefined && <span class="sr-only">{newTabLabel}</span>}
  </a>
)}
