---
/**
 * "Discover" style label with a rule that lengthens when the parent card (`group`) is
 * hovered or focused. Purely presentational: the parent link carries the action.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center gap-3 pt-2.5 text-[0.6875rem] font-medium tracking-[0.16em] text-turquoise uppercase",
    "after:h-px after:w-5.5 after:bg-current after:transition-[width] after:duration-450 after:ease-brand group-hover:after:w-11 group-focus-visible:after:w-11",
    className,
  ]}
>
  <slot />
</span>
