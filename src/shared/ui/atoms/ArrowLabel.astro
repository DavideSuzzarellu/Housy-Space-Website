---
import ArrowUpRight from "./ArrowUpRight.astro";

/**
 * "Discover" style label ending in a north-east arrow that nudges when the parent card (`group`)
 * is hovered or focused (reference `.sv-go`). Purely presentational: the parent link carries the action.
 */
interface Props {
  /** Reference card spacing: 4 px above the label instead of 10 px. */
  tight?: boolean;
  class?: string;
}

const { tight = false, class: className } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center gap-2.5 text-[0.6875rem] font-medium tracking-[0.16em] text-accent uppercase",
    tight ? "pt-1" : "pt-2.5",
    className,
  ]}
>
  <slot />
  <ArrowUpRight class="size-2.5 transition-transform duration-450 ease-brand group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-focus-visible:translate-x-0.5 group-focus-visible:-translate-y-0.5" />
</span>
