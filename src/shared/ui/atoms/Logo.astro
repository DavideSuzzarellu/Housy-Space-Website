---
import { withBase } from "@/shared/lib/basePath";

/**
 * Brand logo from SVG files (never re-typeset, AGENTS.md §11).
 * - official: `logo/housyspace-completo-oficial.svg` (light backgrounds).
 * - negative: the client's own white version (petrol roof), copied from the reference site.
 */
interface Props {
  variant?: "official" | "negative";
  /** Accessible name; pass "" when a parent link already names it. */
  alt: string;
  class?: string;
}

const { variant = "official", alt, class: className } = Astro.props;

const SOURCES = {
  official: "/brand/housyspace-completo-oficial.svg",
  negative: "/brand/housyspace-blanco-oficial.svg",
} as const;
---

<img
  src={withBase(SOURCES[variant])}
  alt={alt}
  width="295"
  height="99"
  class:list={["block", className]}
/>
