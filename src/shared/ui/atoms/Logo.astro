---
/**
 * Brand logo from SVG files (never re-typeset, AGENTS.md §11).
 * - official: `logo/housyspace-completo-oficial.svg` (light backgrounds).
 * - negative: monochrome white, derived ONLY by recoloring the official groups.
 */
interface Props {
  variant?: "official" | "negative";
  /** Accessible name; pass "" when a parent link already names it. */
  alt: string;
  class?: string;
}

const { variant = "official", alt, class: className } = Astro.props;

const SOURCES = {
  official: "/brand/housyspace-completo-oficial.svg",
  negative: "/brand/housyspace-monocromo-blanco.svg",
} as const;
---

<img src={SOURCES[variant]} alt={alt} width="295" height="99" class:list={["block", className]} />
