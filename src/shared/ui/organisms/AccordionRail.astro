---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { PHOTO_PICTURE } from "@/shared/lib/images";
import { panelPosition } from "./accordionRail";
import ArrowUpRight from "@/shared/ui/atoms/ArrowUpRight.astro";

/**
 * Photo accordion: one panel open at a time, advancing on its own (paused on hover, focus,
 * off-screen and reduced motion). Plain links, so every panel stays reachable without JS.
 */
export interface AccordionPanel {
  readonly number: string;
  readonly title: string;
  readonly tag?: string | undefined;
  readonly text?: string | undefined;
  readonly href: string;
  readonly image: ImageMetadata;
  /** `illustration` only: closed-bar colour (alternating) and the light tint of the open card. */
  readonly tone?: "a" | "b";
  readonly tint?: string;
  /** `illustration` only: accessible name of the panel link ("View service: ..."). */
  readonly linkLabel?: string;
}

interface Props {
  label: string;
  panels: readonly AccordionPanel[];
  /**
   * `photo`: one photo panel open, others thin bars (districts).
   * `illustration`: circular carousel, 7 panels visible, closed bars of the image colour,
   * open card in the image tint with arrows (home services).
   */
  variant?: "photo" | "illustration";
  /** `illustration` only. */
  previousLabel?: string;
  nextLabel?: string;
  pauseLabel?: string;
  playLabel?: string;
  roleDescription?: string;
}

const {
  label,
  panels,
  variant = "photo",
  previousLabel = "",
  nextLabel = "",
  pauseLabel = "",
  playLabel = "",
  roleDescription,
} = Astro.props;
const SIDE = 3;
---

{variant === "photo" ? (
  <ul
    data-services-accordion
    aria-label={label}
    class="flex h-110 gap-2 overflow-x-auto [scrollbar-width:none] md:h-130 md:gap-3 md:overflow-visible"
  >
    {panels.map((panel, index) => {
      return (
        <li
          data-panel
          data-active={index === 0 ? "true" : "false"}
          class="group/panel surface-dark relative w-9 shrink-0 overflow-hidden rounded-[1.25rem] bg-ink data-[active=true]:w-[calc(100%-5.5rem)] md:w-auto md:min-w-0 md:flex-1 md:shrink md:transition-[flex-grow] md:duration-700 md:ease-brand md:data-[active=true]:w-auto md:data-[active=true]:grow-7"
        >
          <a
            href={panel.href}
            class="block size-full text-white no-underline focus-visible:-outline-offset-4"
          >
            <Picture
              {...PHOTO_PICTURE}
              src={panel.image}
              alt=""
              widths={[400, 640]}
              sizes="(min-width: 768px) 40rem, 100vw"
              draggable="false"
              class="absolute inset-0 size-full scale-125 object-cover transition-transform duration-1200 ease-brand group-data-[active=true]/panel:scale-100"
            />
            <span
              aria-hidden="true"
              class="absolute inset-0 bg-ink/55 transition-opacity duration-700 group-data-[active=true]/panel:opacity-0"
            ></span>
            <span
              aria-hidden="true"
              class="absolute inset-0 bg-linear-to-t from-ink/95 via-ink/35 to-transparent opacity-0 transition-opacity duration-700 group-data-[active=true]/panel:opacity-100"
            ></span>
            <span
              aria-hidden="true"
              class="absolute inset-x-6 top-5 h-0.5 overflow-hidden rounded-full bg-white/20 opacity-0 group-data-[active=true]/panel:opacity-100 motion-reduce:hidden"
            >
              <span data-progress class="service-progress block h-full w-0 bg-taupe"></span>
            </span>
            <span
              aria-hidden="true"
              class="absolute inset-0 flex flex-col items-center justify-between py-6 transition-opacity delay-200 duration-300 group-data-[active=true]/panel:opacity-0 group-data-[active=true]/panel:delay-0"
            >
              <span class="text-[0.6875rem] font-bold text-taupe">{panel.number}</span>
              <span class="max-h-[calc(100%-2.5rem)] rotate-180 overflow-hidden text-[0.8125rem] font-bold whitespace-nowrap [writing-mode:vertical-rl] md:text-base">
                {panel.title}
              </span>
            </span>
            <span class="absolute bottom-0 left-0 w-[calc(100vw-7rem)] translate-y-5 p-5 pr-16 opacity-0 transition-[translate,opacity] duration-500 ease-brand group-data-[active=true]/panel:translate-y-0 group-data-[active=true]/panel:opacity-100 group-data-[active=true]/panel:delay-250 md:w-[min(38rem,62vw)] md:p-8 md:pr-22">
              <span
                aria-hidden="true"
                class="mb-2 flex items-center gap-2.5 text-[0.6875rem] font-bold tracking-[0.18em] text-taupe"
              >
                {panel.number}
                <span class="h-px w-6 bg-taupe"></span>
                {panel.tag}
              </span>
              <h3 class="text-[clamp(1.25rem,2.4vw,2rem)] leading-[1.1] font-extrabold text-white">
                {panel.title}
              </h3>
              {panel.text !== undefined && (
                <span class="mt-2.5 block max-w-120 text-[0.8125rem] leading-normal text-white/80">
                  {panel.text}
                </span>
              )}
            </span>
            <span
              aria-hidden="true"
              class="absolute right-4.5 bottom-5.5 grid size-10 place-items-center rounded-full bg-taupe text-ink opacity-0 transition-[opacity,rotate,background-color] duration-300 group-hover/panel:bg-stone group-data-[active=true]/panel:opacity-100 md:right-8 md:bottom-8 md:size-11"
            >
              <ArrowUpRight class="size-3" />
            </span>
          </a>
        </li>
      );
    })}
  </ul>
) : (
  <div
    data-rail-wrap
    role="region"
    aria-roledescription={roleDescription}
    aria-label={label}
    class="rail-wrap relative mx-auto w-full max-w-[1500px] p-5 min-[769px]:px-19"
  >
    <ul
      data-services-accordion
      data-circular
      class="rail flex h-110 gap-2 overflow-x-auto [scrollbar-width:none] min-[560px]:max-[768px]:h-120 min-[769px]:h-130 min-[769px]:gap-3 min-[769px]:overflow-visible"
    >
      {panels.map((panel, index) => (
        <li
          data-panel
          data-active={index === 0 ? "true" : "false"}
          data-pos={panelPosition(index, 0, panels.length, SIDE)}
          style={`--tint:${panel.tint ?? "transparent"}`}
          class:list={[
            "rail-panel group/panel relative h-full w-9 shrink-0 overflow-hidden rounded-[1.25rem] min-[560px]:max-[768px]:w-11.5 min-[769px]:w-auto",
            "data-[active=true]:w-[calc(100%-5.5rem)] data-[active=true]:bg-(--tint) min-[560px]:max-[768px]:data-[active=true]:w-[calc(100%-12rem)]",
            panel.tone === "b" ? "bg-forest-lift" : "bg-forest",
          ]}
        >
          <a
            href={panel.href}
            aria-label={panel.linkLabel}
            class="flex size-full flex-col text-dark no-underline focus-visible:-outline-offset-4"
          >
            <span
              aria-hidden="true"
              class="absolute inset-x-5 top-5 z-1 h-0.5 overflow-hidden rounded-full bg-dark/14 opacity-0 group-data-[active=true]/panel:opacity-100 motion-reduce:hidden min-[769px]:inset-x-6"
            >
              <span data-progress class="service-progress block h-full w-0 bg-taupe-tx"></span>
            </span>
            <span
              aria-hidden="true"
              class="absolute inset-0 flex flex-col items-center justify-between py-5 text-[#f5f2eb] transition-opacity delay-200 duration-300 group-data-[active=true]/panel:opacity-0 group-data-[active=true]/panel:delay-0 min-[769px]:py-6"
            >
              <span class="text-[0.6875rem] font-bold text-taupe">{panel.number}</span>
              <span class="rail-vertical max-h-[calc(100%-2.5rem)] rotate-180 overflow-hidden font-heading text-base font-bold tracking-[0.01em] uppercase [writing-mode:vertical-rl] max-[380px]:text-[0.9375rem] min-[769px]:max-h-[calc(100%-4.5rem)] min-[769px]:max-w-[calc(100%-1.5rem)] min-[769px]:leading-[1.18]">
                {panel.title}
              </span>
            </span>
            <span class="rail-expanded invisible order-1 flex min-w-0 flex-col items-start px-5 pt-7 opacity-0 transition-[opacity,visibility] duration-400 group-data-[active=true]/panel:visible group-data-[active=true]/panel:opacity-100 group-data-[active=true]/panel:delay-260 min-[769px]:px-8">
              <span
                aria-hidden="true"
                class="mb-2 flex items-center gap-2 text-[0.6875rem] font-bold tracking-[0.18em] text-taupe-tx uppercase min-[769px]:gap-2.5"
              >
                <span>{panel.number}</span>
                <span class="h-px w-4 bg-taupe-tx min-[769px]:w-6"></span>
                {panel.tag}
              </span>
              <h3 class="text-[1.625rem] leading-[1.1] font-extrabold tracking-[0.03em] text-dark uppercase min-[560px]:max-[768px]:text-[1.875rem] min-[769px]:text-[2.375rem]">
                {panel.title}
              </h3>
            </span>
            <Picture
              {...PHOTO_PICTURE}
              src={panel.image}
              alt=""
              widths={[400, 640, 1248]}
              sizes="(min-width: 769px) 748px, 100vw"
              draggable="false"
              class="order-2 mt-1.5 mb-2 min-h-0 w-full flex-1 object-contain opacity-0 group-data-[active=true]/panel:opacity-100"
            />
            <span
              aria-hidden="true"
              class="absolute right-4.5 bottom-5.5 grid size-10 place-items-center rounded-full bg-taupe text-dark opacity-0 transition-[opacity,rotate,background-color] duration-300 hover:rotate-45 hover:bg-stone group-data-[active=true]/panel:opacity-100 min-[769px]:right-8 min-[769px]:bottom-8 min-[769px]:size-11"
            >
              <ArrowUpRight class="size-4.5" />
            </span>
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-3 flex justify-end motion-reduce:hidden min-[769px]:absolute min-[769px]:top-[-3.5rem] min-[769px]:right-19 min-[769px]:mt-0">
      <button
        type="button"
        data-rail-toggle
        data-label-pause={pauseLabel}
        data-label-play={playLabel}
        aria-label={pauseLabel}
        class="rail-toggle inline-flex size-11 items-center justify-center rounded-full border border-dark/38 text-dark transition-colors duration-250 hover:border-dark hover:bg-dark hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-taupe"
      >
        <svg
          data-icon="pause"
          viewBox="0 0 24 24"
          class="size-4"
          fill="currentColor"
          aria-hidden="true"
        >
          <rect x="6" y="5" width="4" height="14" rx="1" />
          <rect x="14" y="5" width="4" height="14" rx="1" />
        </svg>
        <svg
          data-icon="play"
          viewBox="0 0 24 24"
          class="hidden size-4"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M8 5v14l11-7z" />
        </svg>
      </button>
    </div>
    <button
      type="button"
      data-rail-prev
      aria-label={previousLabel}
      class="rail-arrow left-3 max-[768px]:hidden"
    >
      <svg
        viewBox="0 0 24 24"
        class="size-5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M15 5l-7 7 7 7" />
      </svg>
    </button>
    <button
      type="button"
      data-rail-next
      aria-label={nextLabel}
      class="rail-arrow right-3 max-[768px]:hidden"
    >
      <svg
        viewBox="0 0 24 24"
        class="size-5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
)}

<style>
  /* Desktop: closed panels are 88 px bars; the open one takes the rest. Neighbours are ordered
     round the circle (data-pos) and the ones that left the visible set collapse to nothing. */
  @media (min-width: 769px) {
    .rail-wrap {
      container: rail / inline-size;
    }

    .rail-panel {
      flex: 0 0 88px;
      transition:
        flex 700ms cubic-bezier(0.22, 1, 0.36, 1),
        margin 700ms cubic-bezier(0.22, 1, 0.36, 1),
        opacity 500ms ease,
        filter 300ms ease;
    }

    .rail-panel[data-active="true"] {
      flex: 1 1 0%;
    }

    .rail-panel:hover:not([data-active="true"]) {
      filter: brightness(1.14);
    }

    .rail-panel[data-pos="-3"] {
      order: 0;
    }
    .rail-panel[data-pos="-2"] {
      order: 1;
    }
    .rail-panel[data-pos="-1"] {
      order: 2;
    }
    .rail-panel[data-pos="0"] {
      order: 3;
    }
    .rail-panel[data-pos="1"] {
      order: 4;
    }
    .rail-panel[data-pos="2"] {
      order: 5;
    }
    .rail-panel[data-pos="3"] {
      order: 6;
    }
    .rail-panel[data-pos="hl"] {
      order: -1;
    }
    .rail-panel[data-pos="hr"] {
      order: 9;
    }

    .rail-panel[data-pos="hl"],
    .rail-panel[data-pos="hr"] {
      flex: 0 0 0;
      margin-right: -12px;
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
      transition:
        flex 700ms cubic-bezier(0.22, 1, 0.36, 1),
        margin 700ms cubic-bezier(0.22, 1, 0.36, 1),
        opacity 500ms ease,
        visibility 0s linear 700ms;
    }

    /* Narrow carousels (< 900 px): five panels, so the bars share the width with the open one. */
    @container rail (max-width: 899px) {
      .rail-panel {
        flex: 1 1 0%;
      }

      .rail-panel[data-active="true"] {
        flex: 4 1 0%;
      }

      .rail-panel[data-pos="3"],
      .rail-panel[data-pos="-3"] {
        flex: 0 0 0;
        margin-right: -12px;
        opacity: 0;
        pointer-events: none;
        visibility: hidden;
      }
    }

    .rail-arrow {
      position: absolute;
      top: 50%;
      z-index: 3;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 52px;
      height: 52px;
      margin-top: -26px;
      padding: 0;
      border: 1px solid color-mix(in srgb, var(--color-dark) 38%, transparent);
      border-radius: 50%;
      background: transparent;
      color: var(--color-dark);
      cursor: pointer;
      transition:
        background 250ms ease,
        color 250ms ease,
        border-color 250ms ease;
    }

    .rail-arrow:hover,
    .rail-arrow:focus-visible {
      border-color: var(--color-dark);
      background: var(--color-dark);
      color: var(--color-paper);
    }

    .rail-arrow:focus-visible {
      outline: 2px solid var(--color-taupe);
      outline-offset: 3px;
    }

    .rail-vertical {
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-panel {
      transition: none !important;
    }
  }
</style>

<script>
  // The behaviour is a separate chunk: it is fetched only when the rail is about to be seen, so
  // the first paint of the home ships none of it.
  document.addEventListener("astro:page-load", () => {
    const root = document.querySelector<HTMLElement>("[data-services-accordion]");
    if (root === null) return;
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void import("./accordionRail.client").then((module) => module.initAccordion(root));
      },
      { rootMargin: "300px 0px" },
    );
    observer.observe(root);
  });
</script>
