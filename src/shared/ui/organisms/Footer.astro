---
import {
  CONTACT_PHONE,
  phoneDisplay,
  telHref,
  whatsappHref,
} from "@/features/agency/domain/contact";
import { Image } from "astro:assets";
import aicatSeal from "@/assets/brand/aicat.png";
import apeiSeal from "@/assets/brand/apei.png";
import type { Company } from "@/features/agency/domain/company";
import type { Locale } from "@/shared/i18n/config";
import { getDictionary } from "@/shared/i18n";
import { getLocalizedPath } from "@/shared/i18n/routes";
import { getFooterNavigation } from "@/shared/lib/navigation";
import Container from "@/shared/ui/atoms/Container.astro";
import Logo from "@/shared/ui/atoms/Logo.astro";
import ContactActions from "@/shared/ui/molecules/ContactActions.astro";

interface Props {
  locale: Locale;
  company: Company;
}

const { locale, company } = Astro.props;
const t = getDictionary(locale);
const columns = getFooterNavigation(locale);
const year = new Date().getFullYear();
// Confirmed company data only (AGENTS.md §1, §7). Phone is TODO(I4) in contact.ts.
---

<footer class="surface-dark bg-canvas pt-[clamp(3rem,5vw,4rem)] pb-10 text-[0.8125rem] text-muted max-md:pb-[calc(6rem+env(safe-area-inset-bottom))]">
  <Container>
    <section
      aria-labelledby="contact-block-heading"
      data-contact-block
      class="mb-9.5 flex flex-wrap items-center justify-between gap-x-10 gap-y-5 border-b border-line pb-8.5"
    >
      <div>
        <h2
          id="contact-block-heading"
          class="text-[clamp(2rem,7.2vw,6.5rem)] leading-[0.95] text-fg"
        >
          {t.footer.ctaHeading}
        </h2>
      </div>
      <ContactActions locale={locale} variant="footer" />
    </section>

    <div class="grid gap-8.5 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a
          href={getLocalizedPath("home", locale)}
          aria-label={t.a11y.homeLink}
          class="inline-block"
        >
          <Logo variant="negative" alt="" class="mb-3.5 h-14 w-auto" />
        </a>
        <dl class="grid gap-1">
          <div>
            <dt class="sr-only">{t.footer.companyLabel}</dt>
            <dd>{company.legalName}</dd>
          </div>
          <div class="flex gap-1">
            <dt>{t.footer.taxIdLabel}</dt>
            <dd>{company.taxId}</dd>
          </div>
          <div>
            <dt class="sr-only">{t.footer.addressLabel}</dt>
            <dd>
              <address class="not-italic">
                {company.address.street}
                <br />
                {company.address.postalCode} {company.address.city}
              </address>
            </dd>
          </div>
        </dl>
        <p class="mt-3 grid gap-1">
          <a href={telHref(CONTACT_PHONE)} class="hover:text-accent">
            {phoneDisplay(CONTACT_PHONE)}
          </a>
          <a
            href={whatsappHref(CONTACT_PHONE, t.contact.whatsappMessage)}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent"
          >
            {t.contact.whatsapp}
            <span class="sr-only"> {t.a11y.opensInNewTab}</span>
          </a>
        </p>
      </div>

      {columns.map((column) => (
        <div>
          <h2 class="mb-3 font-sans text-[0.6875rem] font-medium tracking-[0.16em] text-fg uppercase">
            {column.title}
          </h2>
          <ul class="grid gap-1.5">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="no-underline hover:text-accent">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-8.5 flex flex-wrap gap-x-[clamp(1.75rem,5vw,4rem)] gap-y-4.5 border-t border-line pt-6.5">
      <div class="flex items-center gap-3.5">
        <Image
          src={aicatSeal}
          alt={t.footer.aicatAlt}
          height={46}
          class="h-11.5 w-auto rounded-xs"
        />
        <p class="grid gap-0.5 leading-snug">
          <b class="text-[0.6875rem] font-medium tracking-[0.14em] text-fg">
            {t.footer.registeredTitle}
          </b>
          <span>{t.footer.registeredBody}</span>
          <span class="text-fg">AICAT nº {company.aicatNumber}</span>
        </p>
      </div>
      <div class="flex items-center gap-3.5">
        <Image src={apeiSeal} alt={t.footer.apeiAlt} height={48} class="h-12 w-auto opacity-90" />
        <p class="grid gap-0.5 leading-snug">
          <b class="text-[0.6875rem] font-medium tracking-[0.14em] text-fg">{t.footer.apeiTitle}</b>
          <span>{t.footer.apeiBody}</span>
          <span class="text-fg">{t.footer.apeiNumber}</span>
        </p>
      </div>
    </div>

    <div class="mt-6.5 grid gap-1 border-t border-line pt-5 text-xs">
      <p>
        © {year} {company.brandName}. {t.footer.rights}
      </p>
      <p>{t.footer.aiImagery}</p>
    </div>
  </Container>
</footer>
