---
import {
  COMPANY_EMAIL,
  CONTACT_PHONE,
  mailtoHref,
  phoneDisplay,
  telHref,
  whatsappHref,
} from "@/features/agency/domain/contact";
import { Image } from "astro:assets";
import aicatSeal from "@/assets/brand/aicat.png";
import apeiSeal from "@/assets/brand/apei.png";
import apeiExpert from "@/assets/brand/apei-experto.svg";
import type { Company } from "@/features/agency/domain/company";
import NewsletterForm from "@/features/leads/ui/NewsletterForm.astro";
import type { Locale } from "@/shared/i18n/config";
import { getDictionary } from "@/shared/i18n";
import { getLocalizedPath } from "@/shared/i18n/routes";
import { getFooterNavigation } from "@/shared/lib/navigation";
import Container from "@/shared/ui/atoms/Container.astro";
import Logo from "@/shared/ui/atoms/Logo.astro";
import ContactActions from "@/shared/ui/molecules/ContactActions.astro";

/**
 * Site footer of proposal v3 (2026-11-02): "¡Hablemos!" with the contact actions and social
 * profiles, newsletter, company data, three link columns and the AICAT and APEI seals as logos
 * (the AICAT seal shows the registration number, AGENTS.md §7).
 */
interface Props {
  locale: Locale;
  company: Company;
}

const { locale, company } = Astro.props;
const t = getDictionary(locale);
const columns = getFooterNavigation(locale);
const year = new Date().getFullYear();
const LINK = "hover:text-accent";
---

<footer class="surface-dark bg-canvas pt-[clamp(3rem,5vw,4rem)] pb-10 text-[0.8125rem] text-muted max-md:pb-[calc(6rem+env(safe-area-inset-bottom))]">
  <Container>
    <section
      aria-labelledby="contact-block-heading"
      data-contact-block
      class="mb-[clamp(0.875rem,1.8vw,1.25rem)] flex flex-wrap items-center justify-between gap-x-10 gap-y-5 border-b border-line pb-[clamp(1.625rem,3vw,2.5rem)]"
    >
      <h2
        id="contact-block-heading"
        class="text-[clamp(2.875rem,7.2vw,6.5rem)] leading-[0.95] text-fg"
      >
        {t.footer.ctaHeading}
      </h2>
      <ContactActions locale={locale} variant="footer" />
    </section>

    <NewsletterForm locale={locale} />

    <div class="grid gap-8.5 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a
          href={getLocalizedPath("home", locale)}
          aria-label={t.a11y.homeLink}
          class="inline-block"
        >
          <Logo variant="negative" alt="" class="mb-3.5 h-14 w-auto" />
        </a>
        <address class="grid gap-1 not-italic">
          <span>{company.legalName}</span>
          <span>
            {t.footer.taxIdLabel} {company.taxId}
          </span>
          <span>
            {company.address.street}
            <br />
            {company.address.postalCode} {company.address.city}
          </span>
          <span>{t.footer.hours}</span>
          <a href={telHref(CONTACT_PHONE)} class={LINK}>
            {phoneDisplay(CONTACT_PHONE)}
          </a>
          <a
            href={whatsappHref(CONTACT_PHONE, t.contact.whatsappMessage)}
            target="_blank"
            rel="noopener noreferrer"
            class={LINK}
          >
            {t.contact.whatsapp}
            <span class="sr-only"> {t.a11y.opensInNewTab}</span>
          </a>
          <a href={mailtoHref(COMPANY_EMAIL)} class={LINK}>
            {COMPANY_EMAIL}
          </a>
        </address>
      </div>

      {columns.map((column) => (
        <div>
          <h2 class="mb-3 font-sans text-[0.6875rem] font-medium tracking-[0.16em] text-fg uppercase">
            {column.title}
          </h2>
          <ul class="grid gap-1.5">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class={`no-underline ${LINK}`}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-8.5 flex flex-col items-start gap-x-[clamp(1.75rem,5vw,4rem)] gap-y-4.5 border-t border-line pt-6.5 sm:flex-row sm:flex-wrap">
      <Image
        src={aicatSeal}
        alt={t.footer.aicatAlt}
        width={190}
        loading="lazy"
        decoding="async"
        class="h-auto w-47.5 sm:mt-1.75"
      />
      <div class="flex flex-col items-start gap-2.25">
        <Image
          src={apeiSeal}
          alt={t.footer.apeiAlt}
          height={48}
          loading="lazy"
          decoding="async"
          class="h-10.25 w-auto opacity-90 sm:h-12"
        />
        <Image
          src={apeiExpert}
          alt={t.footer.apeiNumber}
          width={117}
          loading="lazy"
          decoding="async"
          class="h-auto w-25 opacity-90 sm:w-29.25"
        />
      </div>
    </div>

    <div class="mt-6.5 grid gap-1 border-t border-line pt-5 text-xs">
      <p>
        © {year} {company.brandName}. {t.footer.rights}
      </p>
      <p>{t.footer.aiImagery}</p>
    </div>
  </Container>
</footer>
