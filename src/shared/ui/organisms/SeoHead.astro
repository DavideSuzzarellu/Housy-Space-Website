---
import { LOCALE_META, type Locale } from "@/shared/i18n/config";
import type { Alternate } from "@/shared/i18n/routes";
import { isIndexableSite, robotsMetaContent } from "@/shared/lib/seo/indexability";
import { LOGO_PNG_FILE, publicPath } from "@/shared/lib/seo/structuredData";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** From `getAlternates()`; omit on pages that must not be indexed (e.g. 404). */
  alternates?: readonly Alternate[];
  /** Open Graph image: root-relative path (PNG) or absolute URL. */
  ogImagePath?: string;
  /** Open Graph type. Use `"article"` for blog posts. */
  ogType?: string;
  /** ISO 8601 string for `article:published_time` (only when `ogType="article"`). */
  publishedTime?: string;
  noindex?: boolean;
}

const {
  locale,
  title,
  description,
  alternates = [],
  ogImagePath = publicPath(import.meta.env.BASE_URL, LOGO_PNG_FILE),
  ogType = "website",
  publishedTime,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
// Only the production origin is indexable; any other copy of the site is noindex,nofollow.
const robots = robotsMetaContent(isIndexableSite(Astro.site), noindex);
const toAbsolute = (path: string): string => new URL(path, site).href;

const canonicalAlternate = alternates.find(
  (alternate) => alternate.hreflang !== "x-default" && alternate.locale === locale,
);
const canonicalUrl = canonicalAlternate ? toAbsolute(canonicalAlternate.path) : undefined;
const ogLocale = LOCALE_META[locale].ogLocale;
const ogLocaleAlternates = alternates
  .filter((alternate) => alternate.hreflang !== "x-default" && alternate.locale !== locale)
  .map((alternate) => LOCALE_META[alternate.locale].ogLocale);
---

<title>{title}</title>
<meta name="description" content={description} />
{robots && <meta name="robots" content={robots} />}
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
{alternates.map((alternate) => (
  <link rel="alternate" hreflang={alternate.hreflang} href={toAbsolute(alternate.path)} />
))}

<meta property="og:type" content={ogType} />
{ogType === "article" && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
<meta property="og:site_name" content="HousySpace" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={ogLocale} />
{ogLocaleAlternates.map((alternate) => (
  <meta property="og:locale:alternate" content={alternate} />
))}
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:image" content={toAbsolute(ogImagePath)} />
<meta name="twitter:card" content="summary_large_image" />
