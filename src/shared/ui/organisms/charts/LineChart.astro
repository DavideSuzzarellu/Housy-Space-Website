---
import { figureFormat } from "@/shared/lib/format";
/** Typed SVG line chart (AGENTS.md §2: no chart library, no client JS). */
export interface LineSeries {
  readonly name: string;
  readonly points: readonly (readonly [number, number])[];
  /** Current year, drawn dashed and labelled as provisional (§6.2). */
  readonly provisional?: { readonly x: number; readonly y: number } | null | undefined;
  readonly tone: "main" | "second" | "third";
}

interface Props {
  title: string;
  unit: string;
  series: readonly LineSeries[];
  provisionalLabel: string;
  source: string;
  sourceUrl?: string | undefined;
  locale: string;
}

const { title, unit, series, provisionalLabel, source, sourceUrl, locale } = Astro.props;

const W = 500;
const H = 260;
const PAD = { top: 14, right: 62, bottom: 26, left: 46 };
const all = series.flatMap((line) => [
  ...line.points,
  ...(line.provisional ? ([[line.provisional.x, line.provisional.y]] as const) : []),
]);
const xs = all.map(([x]) => x);
const ys = all.map(([, y]) => y);
const minX = Math.min(...xs);
const maxX = Math.max(...xs);
// Axis from a "nice" step below the data (as the reference), not from zero: lines stay readable.
const rawStep = (Math.max(...ys) - Math.min(...ys)) / 4 || 1;
const magnitude = 10 ** Math.floor(Math.log10(rawStep));
const step = ([1, 2, 2.5, 5, 10].find((m) => m * magnitude >= rawStep) ?? 10) * magnitude;
const minY = Math.floor(Math.min(...ys) / step) * step;
const maxY = Math.ceil(Math.max(...ys) / step) * step;
const x = (value: number) =>
  PAD.left + ((value - minX) / (maxX - minX || 1)) * (W - PAD.left - PAD.right);
const y = (value: number) =>
  H - PAD.bottom - ((value - minY) / (maxY - minY || 1)) * (H - PAD.top - PAD.bottom);
const path = (points: readonly (readonly [number, number])[]) =>
  points
    .map(([px, py], index) => `${index === 0 ? "M" : "L"}${x(px).toFixed(1)} ${y(py).toFixed(1)}`)
    .join("");
const TONES = {
  main: "stroke-ch-a stroke-[2.4]",
  second: "stroke-ch-b stroke-[1.8]",
  third: "stroke-ch-c stroke-[1.6] [stroke-dasharray:5_4]",
} as const;
const DOTS = { main: "fill-ch-a", second: "fill-ch-b", third: "fill-ch-c" } as const;
const SWATCH = { main: "bg-ch-a", second: "bg-ch-b", third: "bg-ch-c" } as const;
const GRID = Array.from(
  { length: Math.round((maxY - minY) / step) + 1 },
  (_, i) => minY + i * step,
);
const YEARS = Array.from({ length: Math.floor((maxX - minX) / 3) + 1 }, (_, i) => minX + i * 3);
const hasProvisional = series.some((line) => line.provisional);
const format = figureFormat(locale);
const latest = series
  .map((line) => `${line.name}: ${format.format(line.points.at(-1)?.[1] ?? 0)} ${unit}`)
  .join(", ");
---

<figure class="m-0 border border-line bg-card px-3.5 pt-3.5 pb-2.5">
  <figcaption class="mb-1.5 text-[0.6875rem] font-medium tracking-[0.04em]">{title}</figcaption>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label={`${title}. ${latest}`}
    class="block h-auto w-full"
  >
    {GRID.map((value) => (
      <>
        <line x1={PAD.left} x2={W - PAD.right} y1={y(value)} y2={y(value)} class="stroke-ch-grid" />
        <text x={PAD.left - 6} y={y(value) + 3} text-anchor="end" class="fill-ch-ax text-[10px]">
          {format.format(value)}
        </text>
      </>
    ))}
    {YEARS.map((year) => (
      <text x={x(year)} y={H - 8} text-anchor="middle" class="fill-ch-ax text-[10px]">
        {year}
      </text>
    ))}
    {series.map((line) => {
      const last = line.points.at(-1);
      const end = line.provisional ? ([line.provisional.x, line.provisional.y] as const) : last;
      return (
        <>
          <path
            d={path(line.points)}
            class:list={[
              "fill-none [stroke-linecap:round] [stroke-linejoin:round]",
              TONES[line.tone],
            ]}
          />
          {line.provisional && last && (
            <path
              d={path([last, [line.provisional.x, line.provisional.y]])}
              stroke-dasharray="4 4"
              class:list={["fill-none opacity-70", TONES[line.tone]]}
            />
          )}
          {end && (
            <>
              <circle cx={x(end[0])} cy={y(end[1])} r="2.6" class={DOTS[line.tone]} />
              <text
                x={x(end[0]) + 8}
                y={y(end[1]) + 3}
                class={`${DOTS[line.tone]} text-[10px] font-medium`}
              >
                {format.format(end[1])}
              </text>
            </>
          )}
        </>
      );
    })}
  </svg>
  <ul class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-[0.625rem] text-muted">
    {series.map((line) => (
      <li class="flex items-center gap-1.5">
        <span aria-hidden="true" class:list={["h-[3px] w-4", SWATCH[line.tone]]}></span>
        {line.name}
      </li>
    ))}
    {hasProvisional && <li>{provisionalLabel}</li>}
  </ul>
  <p class="mt-1.5 text-[0.625rem] text-muted">
    {sourceUrl === undefined ? (
      source
    ) : (
      <a
        href={sourceUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="underline underline-offset-2"
      >
        {source}
      </a>
    )}
  </p>
</figure>
