---
import { figureFormat } from "@/shared/lib/format";
/** Typed horizontal bars in plain HTML (AGENTS.md §2: no chart library, no client JS). */
export interface BarItem {
  readonly label: string;
  readonly value: number;
  readonly tone?: "main" | "second" | "third" | undefined;
}

interface Props {
  title: string;
  unit: string;
  items: readonly BarItem[];
  source: string;
  sourceUrl?: string | undefined;
  locale: string;
}

const { title, unit, items, source, sourceUrl, locale } = Astro.props;
const max = Math.max(...items.map((item) => item.value));
const format = figureFormat(locale);
const TONES = { main: "bg-accent", second: "bg-taupe", third: "bg-green-grey" } as const;
---

<figure class="m-0 border border-line bg-canvas p-4">
  <figcaption class="mb-3 text-xs font-bold tracking-[0.04em]">
    {title} ({unit})
  </figcaption>
  <ul class="grid gap-1.5">
    {items.map((item) => (
      <li class="grid grid-cols-[minmax(0,9rem)_1fr_auto] items-center gap-2 text-[0.625rem]">
        <span class="truncate" title={item.label}>
          {item.label}
        </span>
        <span class="h-2 bg-line">
          <span
            class:list={["block h-full", item.tone === undefined ? "bg-fg/35" : TONES[item.tone]]}
            style={`width:${((item.value / max) * 100).toFixed(1)}%`}
          ></span>
        </span>
        <b class="font-semibold">{format.format(item.value)}</b>
      </li>
    ))}
  </ul>
  <p class="mt-3 text-[0.625rem] text-muted">
    {sourceUrl === undefined ? (
      source
    ) : (
      <a
        href={sourceUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="underline underline-offset-2"
      >
        {source}
      </a>
    )}
  </p>
</figure>
