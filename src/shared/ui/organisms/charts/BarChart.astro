---
import { figureFormat } from "@/shared/lib/format";
/** Typed horizontal bars in plain HTML (AGENTS.md §2: no chart library, no client JS). */
export interface BarItem {
  readonly label: string;
  readonly value: number;
  readonly tone?: "main" | "second" | "third" | undefined;
}

interface Props {
  title: string;
  unit: string;
  items: readonly BarItem[];
  source: string;
  sourceUrl?: string | undefined;
  locale: string;
  /** `card`: paper box on a stone block; `rule`: open figure under a 1 px rule (reference index). */
  variant?: "card" | "rule";
  /** Word before the source line ("Source:"), shown when given. */
  sourcePrefix?: string | undefined;
}

const {
  title,
  unit,
  items,
  source,
  sourceUrl,
  locale,
  variant = "card",
  sourcePrefix,
} = Astro.props;
const max = Math.max(...items.map((item) => item.value));
const format = figureFormat(locale);
const TONES = { main: "bg-ch-a", second: "bg-ch-b", third: "bg-ch-c" } as const;
---

<figure
  class:list={[
    "m-0",
    variant === "card"
      ? "border border-line bg-card px-3.5 pt-3.5 pb-2.5"
      : "border-t border-line-strong pt-[18px]",
  ]}
>
  <figcaption
    class:list={[
      "font-medium tracking-[0.04em]",
      variant === "card" ? "mb-1.5 text-[0.6875rem]" : "mb-2.5 text-xs",
    ]}
  >
    {title} ({unit})
  </figcaption>
  <ul class="grid gap-2.5">
    {items.map((item) => (
      <li class="grid grid-cols-[minmax(0,8.5rem)_1fr] items-center gap-2.5 text-[0.625rem]">
        <span class="text-right leading-tight">{item.label}</span>
        <span class="flex items-center gap-2">
          <span
            class:list={["block h-4", item.tone === undefined ? "bg-ch-bar" : TONES[item.tone]]}
            style={`width:${((item.value / max) * 82).toFixed(1)}%`}
          ></span>
          <b class="font-medium">{format.format(item.value)}</b>
        </span>
      </li>
    ))}
  </ul>
  <p class="mt-1.5 text-[0.625rem] text-muted">
    {sourcePrefix !== undefined && `${sourcePrefix} `}
    {sourceUrl === undefined ? (
      source
    ) : (
      <a
        href={sourceUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="underline underline-offset-2"
      >
        {source}
      </a>
    )}
  </p>
</figure>
