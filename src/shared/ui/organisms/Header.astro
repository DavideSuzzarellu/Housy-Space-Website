---
import type { Locale } from "@/shared/i18n/config";
import { getDictionary } from "@/shared/i18n";
import { getLocalizedPath, type Alternate } from "@/shared/i18n/routes";
import { formatMessage } from "@/shared/lib/format";
import { getMainNavigation } from "@/shared/lib/navigation";
import { SITE_HEADER_TRANSITION_NAME } from "@/shared/lib/transitionNames";
import ArrowUpRight from "@/shared/ui/atoms/ArrowUpRight.astro";
import Logo from "@/shared/ui/atoms/Logo.astro";
import LanguageSwitcher from "@/shared/ui/molecules/LanguageSwitcher.astro";

/**
 * Site header (UI proposal v3). A petrol bar with the negative logo; transparent over a full-bleed
 * hero until the page scrolls (home). The horizontal menu shows whenever it fits beside the logo
 * and actions, measured in three densities (`navFit.ts`); otherwise it moves behind the "Menu"
 * button (drawer). Before the script measures (`data-nav="auto"`), CSS falls back to `xl`.
 */
interface Props {
  locale: Locale;
  alternates: readonly Alternate[];
  /** Transparent over a full-bleed hero until the page scrolls (home). */
  overlay?: boolean;
}

const { locale, alternates, overlay = false } = Astro.props;
const t = getDictionary(locale);
const items = getMainNavigation(locale);
const lastIndex = items.length - 1;

/** Visible while the horizontal menu is shown (a density, or the `xl` fallback before measuring). */
const SHOW_WITH_NAV =
  "group-data-[nav=auto]/header:xl:block group-data-[nav=full]/header:block group-data-[nav=tight]/header:block group-data-[nav=xtight]/header:block";
---

<!-- Own snapshot without cross-fade: the fixed header never flickers between pages (§3.3). -->
<header
  transition:name={SITE_HEADER_TRANSITION_NAME}
  transition:animate="none"
  data-header
  data-overlay={overlay ? "true" : "false"}
  data-theme={overlay ? "overlay" : "solid"}
  data-nav="auto"
  class:list={[
    "surface-dark",
    "group/header fixed inset-x-0 top-0 z-60 text-fg transition-[background-color,border-color] duration-400",
    "border-b border-stone/16 bg-bg-dark-1",
    "data-[theme=overlay]:border-transparent data-[theme=overlay]:bg-transparent",
    // Soft gradient keeps the negative logo legible over the video.
    "before:pointer-events-none before:absolute before:inset-x-0 before:top-0 before:-z-10 before:h-[calc(100%+4.375rem)] before:bg-linear-to-b before:from-ink/65 before:via-ink/30 before:to-ink/0 before:opacity-0 before:transition-opacity data-[theme=overlay]:before:opacity-100",
  ]}
>
  <div class="flex h-19 items-center gap-5 px-[clamp(1.125rem,3.2vw,3.25rem)] md:h-23">
    <a
      href={getLocalizedPath("home", locale)}
      aria-label={t.a11y.homeLink}
      class="relative block flex-none"
    >
      <Logo variant="negative" alt="" class="h-13.5 w-auto md:h-17" />
    </a>

    <nav
      data-main-nav
      aria-label={t.a11y.mainNavigation}
      class:list={["hidden min-w-0 flex-1", SHOW_WITH_NAV]}
    >
      <ul class="ml-auto flex w-max items-center gap-[clamp(1rem,1.5vw,1.625rem)] whitespace-nowrap group-data-[nav=tight]/header:gap-3.25 group-data-[nav=xtight]/header:gap-2.5">
        {items.map((item, index) => {
          const submenuId = `submenu-${index}`;
          return (
            <li class="group/item relative flex items-center" data-nav-item>
              <a
                href={item.href}
                class:list={[
                  "text-[0.6875rem] leading-none font-medium tracking-[0.1em] uppercase no-underline transition-colors",
                  "group-data-[nav=tight]/header:tracking-[0.05em] group-data-[nav=xtight]/header:text-[0.65625rem] group-data-[nav=xtight]/header:tracking-[0.03em]",
                  "hover:border-accent hover:text-accent focus-visible:text-accent",
                  // The last entry (Contact) is outlined: it closes the inline menu like a button.
                  index === lastIndex
                    ? "border border-current px-4 py-2.75 group-data-[nav=xtight]/header:px-2.75 group-data-[nav=xtight]/header:py-2.5"
                    : "border-b border-transparent py-3",
                ]}
              >
                {item.label}
              </a>
              {item.children.length > 0 && (
                <>
                  <button
                    type="button"
                    data-submenu-toggle
                    aria-expanded="false"
                    aria-controls={submenuId}
                    aria-label={formatMessage(t.a11y.openSubmenu, { label: item.label })}
                    class="ml-0.5 grid h-8 w-6 cursor-pointer place-items-center text-current group-data-[nav=xtight]/header:ml-px group-data-[nav=xtight]/header:w-4"
                  >
                    <span
                      aria-hidden="true"
                      class="size-1.5 -translate-y-0.5 rotate-45 border-r-[1.4px] border-b-[1.4px] border-current transition-transform duration-350 ease-brand group-data-[open=true]/item:translate-y-0.5 group-data-[open=true]/item:-rotate-135"
                    />
                  </button>
                  <div
                    id={submenuId}
                    class="invisible absolute top-full left-1/2 z-10 -translate-x-1/2 translate-y-2.5 pt-3.5 opacity-0 transition-[opacity,translate,visibility] duration-400 ease-brand group-focus-within/item:visible group-focus-within/item:translate-y-0 group-focus-within/item:opacity-100 group-hover/item:visible group-hover/item:translate-y-0 group-hover/item:opacity-100 group-data-[open=true]/item:visible group-data-[open=true]/item:translate-y-0 group-data-[open=true]/item:opacity-100"
                  >
                    <ul class="max-w-[min(21.25rem,calc(100vw-2rem))] min-w-62.5 border border-accent/20 bg-bg-dark-1/97 py-3 whitespace-normal shadow-2xl shadow-black/45 backdrop-blur-lg">
                      {item.children.map((child, childIndex) => (
                        <li>
                          <a
                            href={child.href}
                            class:list={[
                              "block px-5.5 py-2.5 text-sm leading-snug text-fg/90 no-underline transition-[color,background-color,padding] duration-300 hover:bg-turquoise/7 hover:pl-7 hover:text-accent focus-visible:text-accent",
                              childIndex === 0 && "font-medium text-white",
                            ]}
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="ml-auto flex flex-none items-center gap-3 md:gap-4">
      {alternates.length > 0 && (
        <div class="hidden sm:block">
          <LanguageSwitcher
            locale={locale}
            alternates={alternates}
            label={t.a11y.languageSwitcher}
          />
        </div>
      )}

      <!-- Only beside the "Menu" button: the inline menu already ends in Contact. -->
      <a
        href={getLocalizedPath("contact", locale)}
        class="hidden min-h-11.5 items-center gap-3 border border-fg bg-fg px-5 text-xs leading-none font-medium tracking-[0.14em] text-ink uppercase no-underline transition-colors group-data-[nav=auto]/header:xl:hidden group-data-[nav=full]/header:hidden group-data-[nav=tight]/header:hidden group-data-[nav=xtight]/header:hidden hover:border-accent hover:bg-turquoise focus-visible:border-accent focus-visible:bg-turquoise min-[35rem]:inline-flex"
      >
        {t.contact.letsTalk}
        <ArrowUpRight />
      </a>

      <button
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="site-drawer"
        class="flex min-h-11.5 cursor-pointer items-center gap-3 border border-current/40 px-4 py-3 text-xs font-medium tracking-[0.14em] uppercase transition-colors group-data-[nav=auto]/header:xl:hidden group-data-[nav=full]/header:hidden group-data-[nav=tight]/header:hidden group-data-[nav=xtight]/header:hidden hover:border-accent hover:text-accent"
      >
        <span>{t.a11y.openMenu}</span>
        <span aria-hidden="true" class="h-2.5 w-4.5 border-y-[1.5px] border-current"></span>
      </button>
    </div>
  </div>
</header>

<script>
  import { chooseNavMode, type NavDensity } from "./navFit";

  const SCROLLED_PX = 24;
  let frame = 0;
  let documentBound = false;

  const currentHeader = (): HTMLElement | null =>
    document.querySelector<HTMLElement>("[data-header]");

  function syncScrollState(): void {
    const header = currentHeader();
    if (header?.dataset["overlay"] === "true") {
      header.dataset["theme"] = window.scrollY > SCROLLED_PX ? "solid" : "overlay";
    }
    const bar = document.querySelector<HTMLElement>("[data-quick-actions]");
    if (bar !== null) {
      const visible = window.scrollY > window.innerHeight * 0.7;
      bar.dataset["visible"] = String(visible);
      bar.inert = !visible;
    }
  }

  function closeSubmenus(except?: Element): void {
    for (const item of document.querySelectorAll<HTMLElement>(
      "[data-nav-item][data-open='true']",
    )) {
      if (item === except) continue;
      item.dataset["open"] = "false";
      item.querySelector("[data-submenu-toggle]")?.setAttribute("aria-expanded", "false");
    }
  }

  /**
   * Measures the menu in each density against the space the header leaves it (the nav is
   * `flex-1`, so its width does not depend on its content) and keeps the roomiest that fits.
   */
  function fitNav(): void {
    const header = currentHeader();
    const nav = header?.querySelector<HTMLElement>("[data-main-nav]");
    const list = nav?.querySelector<HTMLElement>(":scope > ul");
    if (header === null || header === undefined || nav === null || nav === undefined) return;
    if (list === null || list === undefined) return;
    const previous = header.dataset["nav"];
    const widthIn = (density: NavDensity): number => {
      header.dataset["nav"] = density;
      return list.offsetWidth;
    };
    header.dataset["nav"] = "full";
    const available = nav.clientWidth;
    const mode = chooseNavMode(available, {
      full: widthIn("full"),
      tight: widthIn("tight"),
      xtight: widthIn("xtight"),
    });
    header.dataset["nav"] = mode;
    if (mode !== previous) {
      closeSubmenus();
      // The drawer only belongs to the compact header.
      if (mode !== "compact") document.dispatchEvent(new CustomEvent("site:nav-inline"));
    }
  }

  function schedule(): void {
    if (frame !== 0) return;
    frame = requestAnimationFrame(() => {
      frame = 0;
      syncScrollState();
      fitNav();
    });
  }

  document.addEventListener("astro:page-load", () => {
    for (const toggle of document.querySelectorAll<HTMLButtonElement>("[data-submenu-toggle]")) {
      toggle.addEventListener("click", () => {
        const item = toggle.closest<HTMLElement>("[data-nav-item]");
        if (item === null) return;
        const open = item.dataset["open"] !== "true";
        closeSubmenus(item);
        item.dataset["open"] = String(open);
        toggle.setAttribute("aria-expanded", String(open));
      });
    }
    if (!documentBound) {
      documentBound = true;
      window.addEventListener("scroll", schedule, { passive: true });
      window.addEventListener("resize", schedule, { passive: true });
      // Web fonts change the menu width: measure again once they are in.
      void document.fonts.ready.then(fitNav);
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        const open = document.querySelector<HTMLElement>("[data-nav-item][data-open='true']");
        closeSubmenus();
        open?.querySelector<HTMLButtonElement>("[data-submenu-toggle]")?.focus();
      });
      document.addEventListener("click", (event) => {
        if (event.target instanceof Element && event.target.closest("[data-nav-item]") === null) {
          closeSubmenus();
        }
      });
    }
    syncScrollState();
    fitNav();
  });
</script>
