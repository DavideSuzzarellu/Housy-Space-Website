---
import type { Locale } from "@/shared/i18n/config";
import { getDictionary } from "@/shared/i18n";
import { getLocalizedPath, type Alternate } from "@/shared/i18n/routes";
import { formatMessage } from "@/shared/lib/format";
import { getMainNavigation } from "@/shared/lib/navigation";
import { SITE_HEADER_TRANSITION_NAME } from "@/shared/lib/transitionNames";
import Logo from "@/shared/ui/atoms/Logo.astro";
import LanguageSwitcher from "@/shared/ui/molecules/LanguageSwitcher.astro";

/**
 * Site header (reference `.hdr`): always a dark teal bar with the white logo. Over a full-bleed
 * hero (home) it starts transparent with a dark top gradient and a bigger logo, and turns solid
 * over the first 60 px of scroll with a CSS scroll-driven animation (no JavaScript, see the style
 * block; without `animation-timeline` support it is simply the solid bar). The horizontal menu
 * shows from the `nav` breakpoint; below it the "Menu" button opens the drawer.
 */
interface Props {
  locale: Locale;
  alternates: readonly Alternate[];
  /** Transparent over a full-bleed hero until the page scrolls (home). */
  overlay?: boolean;
}

const { locale, alternates, overlay = false } = Astro.props;
const t = getDictionary(locale);
const items = getMainNavigation(locale);
const lastIndex = items.length - 1;
---

<!-- Own snapshot without cross-fade: the fixed header never flickers between pages (§3.3). -->
<header
  transition:name={SITE_HEADER_TRANSITION_NAME}
  transition:animate="none"
  data-header
  data-overlay={overlay ? "true" : "false"}
  class="site-header surface-dark group/header fixed inset-x-0 top-0 z-60 text-fg"
>
  <div class="flex h-(--bar-h) items-center gap-5 px-[clamp(1.125rem,3.2vw,3.25rem)]">
    <a
      href={getLocalizedPath("home", locale)}
      aria-label={t.a11y.homeLink}
      class="relative block flex-none"
    >
      <Logo variant="negative" alt="" class="h-(--logo-h) w-auto" />
    </a>

    <nav data-main-nav aria-label={t.a11y.mainNavigation} class="hidden min-w-0 flex-1 nav:block">
      <ul class="ml-auto flex w-max items-center gap-[clamp(0.625rem,min(1.5vw,calc((100vw-1330px)/7)),1.625rem)] whitespace-nowrap">
        {items.map((item, index) => {
          const submenuId = `submenu-${index}`;
          return (
            <li class="group/item relative flex items-center" data-nav-item>
              <a
                href={item.href}
                class:list={[
                  "text-[0.6875rem] leading-none font-medium tracking-[0.1em] uppercase no-underline transition-colors",
                  "hover:border-turquoise hover:text-accent focus-visible:text-accent",
                  // The last entry (Contact) is outlined: it closes the inline menu like a button.
                  index === lastIndex
                    ? "border border-current px-4 py-2.75"
                    : "border-b border-transparent py-3",
                ]}
              >
                {item.label}
              </a>
              {item.children.length > 0 && (
                <>
                  <button
                    type="button"
                    data-submenu-toggle
                    aria-expanded="false"
                    aria-controls={submenuId}
                    aria-label={formatMessage(t.a11y.openSubmenu, { label: item.label })}
                    class="ml-0.5 grid h-8 w-6 cursor-pointer place-items-center text-current"
                  >
                    <span
                      aria-hidden="true"
                      class="size-1.5 -translate-y-0.5 rotate-45 border-r-[1.4px] border-b-[1.4px] border-current transition-transform duration-350 ease-brand group-data-[open=true]/item:translate-y-0.5 group-data-[open=true]/item:-rotate-135"
                    />
                  </button>
                  <div
                    id={submenuId}
                    class="invisible absolute top-full left-1/2 z-10 -translate-x-1/2 translate-y-2.5 pt-3.5 opacity-0 transition-[opacity,translate,visibility] duration-400 ease-brand group-focus-within/item:visible group-focus-within/item:translate-y-0 group-focus-within/item:opacity-100 group-hover/item:visible group-hover/item:translate-y-0 group-hover/item:opacity-100 group-data-[open=true]/item:visible group-data-[open=true]/item:translate-y-0 group-data-[open=true]/item:opacity-100"
                  >
                    <ul class="max-w-[min(21.25rem,calc(100vw-2rem))] min-w-62.5 border border-turquoise/20 bg-panel/97 py-3 whitespace-normal shadow-[0_28px_60px_rgb(0_0_0/0.45)] backdrop-blur-lg">
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            class="block px-5.5 py-2.5 text-xs leading-snug font-medium tracking-[0.0233em] text-white no-underline transition-[color,background-color,padding] duration-300 hover:bg-turquoise/8 hover:pl-7 hover:text-accent focus-visible:text-accent"
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="ml-auto flex flex-none items-center gap-3 md:gap-4">
      {alternates.length > 0 && (
        <div class="hidden sm:block">
          <LanguageSwitcher
            locale={locale}
            alternates={alternates}
            label={t.a11y.languageSwitcher}
          />
        </div>
      )}

      <!-- Proposal v3 (2026-10-30): no "Let's talk" CTA; the drawer and the footer carry it. -->
      <button
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="site-drawer"
        class="flex min-h-11.5 cursor-pointer items-center gap-3 border border-current/40 px-4 py-3 text-xs font-medium tracking-[0.14em] uppercase transition-colors hover:border-turquoise hover:text-accent nav:hidden"
      >
        <span>{t.a11y.openMenu}</span>
        <span aria-hidden="true" class="h-2.5 w-4.5 border-y-[1.5px] border-current"></span>
      </button>
    </div>
  </div>
</header>

<style>
  /*
   * `--hdr-t` runs 0 (floating over the hero) to 1 (solid bar). Static default = 1: pages without
   * a hero, and browsers without scroll-driven animations, get the solid bar. Reference sizes:
   * solid bar 76/92 px with a 54/68 px logo; over the hero the logo is 76-90 px (mobile),
   * 108-132 px (tablet) and 86 px beside the inline menu (the bar is 114 px).
   */
  @property --hdr-t {
    syntax: "<number>";
    inherits: true;
    initial-value: 1;
  }

  .site-header {
    --hdr-t: 1;
    --logo-s: 3.375rem;
    --bar-s: 4.75rem;
    --logo-o: clamp(4.75rem, 20.5vw, 5.625rem);
    --bar-o: calc(var(--logo-o) + 2.75rem);
    --logo-h: calc(var(--logo-s) + (var(--logo-o) - var(--logo-s)) * (1 - var(--hdr-t)));
    --bar-h: calc(var(--bar-s) + (var(--bar-o) - var(--bar-s)) * (1 - var(--hdr-t)));
    background-color: color-mix(
      in srgb,
      var(--color-header) calc(var(--hdr-t) * 100%),
      transparent
    );
    box-shadow: 0 1px 0
      color-mix(in srgb, rgb(235 229 220 / 0.16) calc(var(--hdr-t) * 100%), transparent);
  }

  @media (min-width: 48rem) {
    .site-header {
      --logo-s: 4.25rem;
      --bar-s: 5.75rem;
      --logo-o: clamp(6.75rem, 9vw, 8.25rem);
    }
  }

  @media (min-width: 64rem) {
    .site-header {
      --logo-o: 5.375rem;
      --bar-o: 7.125rem;
    }
  }

  /* Soft gradient that keeps the white logo and menu legible over the video. */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: calc(100% + 4.375rem);
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgb(8 16 18 / 0.66),
      rgb(8 16 18 / 0.28) 55%,
      rgb(8 16 18 / 0)
    );
    opacity: calc(1 - var(--hdr-t));
  }

  @keyframes header-solid {
    to {
      --hdr-t: 1;
    }
  }

  @supports (animation-timeline: scroll()) {
    .site-header[data-overlay="true"] {
      --hdr-t: 0;
      animation: header-solid linear both;
    }

    /* Separate rule on purpose: a CSS minifier folds the timeline into the shorthand above, and
       browsers reject that, which would leave the bar transparent for good. */
    [data-header][data-overlay="true"] {
      animation-timeline: scroll(root);
      animation-range: 0 60px;
    }
  }
</style>

<script>
  let documentBound = false;

  function closeSubmenus(except?: Element): void {
    for (const item of document.querySelectorAll<HTMLElement>(
      "[data-nav-item][data-open='true']",
    )) {
      if (item === except) continue;
      item.dataset["open"] = "false";
      item.querySelector("[data-submenu-toggle]")?.setAttribute("aria-expanded", "false");
    }
  }

  document.addEventListener("astro:page-load", () => {
    for (const toggle of document.querySelectorAll<HTMLButtonElement>("[data-submenu-toggle]")) {
      toggle.addEventListener("click", () => {
        const item = toggle.closest<HTMLElement>("[data-nav-item]");
        if (item === null) return;
        const open = item.dataset["open"] !== "true";
        closeSubmenus(item);
        item.dataset["open"] = String(open);
        toggle.setAttribute("aria-expanded", String(open));
      });
    }
    if (documentBound) return;
    documentBound = true;
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const open = document.querySelector<HTMLElement>("[data-nav-item][data-open='true']");
      closeSubmenus();
      open?.querySelector<HTMLButtonElement>("[data-submenu-toggle]")?.focus();
    });
    document.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("[data-nav-item]") === null) {
        closeSubmenus();
      }
    });
  });
</script>
