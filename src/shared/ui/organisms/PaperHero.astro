---
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import Container from "@/shared/ui/atoms/Container.astro";
import Breadcrumbs from "@/shared/ui/molecules/Breadcrumbs.astro";

/**
 * Plain paper page head of the reference (`np6-hero`): breadcrumbs, accent kicker, very large
 * title and a subtitle. `size="xl"` is the contact page's oversize title (`ct6-h1`).
 */
interface Props {
  locale: Locale;
  title: string;
  kicker?: string | undefined;
  subtitle?: string | undefined;
  crumbs: readonly { readonly label: string; readonly href?: string }[];
  size?: "lg" | "xl";
}

const { locale, title, kicker, subtitle, crumbs, size = "lg" } = Astro.props;
const t = getDictionary(locale);
---

<section
  data-page-head
  class="flex min-h-[clamp(24rem,52svh,34rem)] flex-col justify-center bg-canvas py-[clamp(2.25rem,5vw,4.375rem)]"
>
  <Container>
    <Breadcrumbs
      items={crumbs}
      label={t.property.detail.breadcrumb}
      class="mb-[clamp(1.125rem,2.6vw,1.875rem)]"
    />
    {kicker !== undefined && (
      <p class="text-[0.6875rem] font-bold tracking-[0.24em] text-accent">{kicker}</p>
    )}
    <h1
      class:list={[
        "mt-[0.4em] text-balance leading-[0.98]",
        size === "xl"
          ? "text-[clamp(1.75rem,calc((100vw-2rem)/8.2),10.9375rem)]"
          : "max-w-[10.5em] text-[clamp(2.75rem,7.4vw,6.75rem)]",
      ]}
    >
      {title}
    </h1>
    {subtitle !== undefined && (
      <p
        class:list={[
          "mt-[clamp(1.125rem,2vw,1.75rem)] font-medium text-muted",
          size === "xl"
            ? "max-w-[30ch] text-[clamp(1.1875rem,2.5vw,2.25rem)] leading-[1.4] font-semibold tracking-[0.03em] text-fg"
            : "max-w-[42ch] text-[clamp(0.8125rem,1.15vw,1rem)] leading-[1.65] tracking-[0.09em]",
        ]}
      >
        {subtitle}
      </p>
    )}
  </Container>
</section>
