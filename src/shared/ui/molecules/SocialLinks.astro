---

<ul role="list" class:list={["flex items-center gap-1.5", className]}>
  {links.map((link) => (
    <li class="flex">
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex size-11.5 items-center justify-center text-fg transition-[color,translate] duration-350 ease-brand hover:-translate-y-0.5 hover:text-accent focus-visible:-translate-y-0.5 focus-visible:text-accent motion-reduce:transition-none motion-reduce:hover:translate-y-0"
      >
        <svg viewBox="0 0 100 100" class="size-9" aria-hidden="true" focusable="false">
          <path fill="currentColor" fill-rule="evenodd" d={ICONS[link.network]} />
        </svg>
        <span class="sr-only">
          {formatMessage(label, { network: link.name })} {newTabLabel}
        </span>
      </a>
    </li>
  ))}
</ul>
