import { formatMessage } from "@/shared/lib/format";

/**
 * Company social profiles as icon links (proposal v3, footer 2026-11-02): 36 px marks in 46 px
 * targets, drawn in the text colour of the surface they sit on.
 */
interface Props {
  links: readonly {
    readonly network: "instagram" | "linkedin";
    readonly name: string;
    readonly href: string;
  }[];
  /** Accessible name template with a `{network}` placeholder ("HousySpace on {network}"). */
  label: string;
  newTabLabel: string;
  class?: string;
}

const { links, label, newTabLabel, class: className } = Astro.props;

