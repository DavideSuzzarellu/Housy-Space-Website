---
/** Visible label + one form control (passed in the slot), linked by `controlId`. */
interface Props {
  label: string;
  /** `id` of the control in the slot. */
  controlId: string;
  class?: string;
}

const { label, controlId, class: className } = Astro.props;
---

<div class:list={["flex flex-col gap-1.5", className]}>
  <label for={controlId} class="text-xs tracking-[0.08em] text-muted">
    {label}
  </label>
  <slot />
</div>
