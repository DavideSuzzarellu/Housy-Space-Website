---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { PHOTO_PICTURE } from "@/shared/lib/images";
import ArrowLabel from "@/shared/ui/atoms/ArrowLabel.astro";

/**
 * Linked card with a photo, an index number, a title and a short text (services index of the
 * design canvas). `feature`: wider and taller, for the lead item of a grid.
 */
interface Props {
  href: string;
  image: ImageMetadata;
  title: string;
  text: string;
  /** Visible label of the card link ("Discover the service"). */
  cta: string;
  index: number;
  size?: "default" | "feature";
  headingLevel?: 2 | 3;
  class?: string;
}

const {
  href,
  image,
  title,
  text,
  cta,
  index,
  size = "default",
  headingLevel = 2,
  class: className,
} = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
const RATIO = { default: "aspect-[4/3]", feature: "aspect-[4/3] lg:aspect-[16/10]" } as const;
---

<a
  href={href}
  data-reveal
  class:list={[
    "group flex flex-col bg-card no-underline transition-colors hover:bg-card-hover",
    className,
  ]}
>
  <div class:list={["overflow-hidden", RATIO[size]]}>
    <Picture
      {...PHOTO_PICTURE}
      src={image}
      alt=""
      widths={[480, 800, 1200]}
      sizes={
        size === "feature" ? "(min-width: 1024px) 66vw, 100vw" : "(min-width: 1024px) 33vw, 100vw"
      }
      loading="lazy"
      class="size-full object-cover transition-transform duration-1400 ease-brand group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
    />
  </div>
  <div class="flex flex-1 flex-col gap-3 p-[clamp(1.25rem,2.4vw,1.75rem)]">
    <span aria-hidden="true" class="text-[0.6875rem] tracking-[0.16em] text-muted">
      {String(index).padStart(2, "0")}
    </span>
    <Heading class="text-[clamp(1.125rem,1.8vw,1.5rem)] leading-tight">{title}</Heading>
    <p class="text-sm text-muted">{text}</p>
    <ArrowLabel class="mt-auto pt-2">{cta}</ArrowLabel>
  </div>
</a>
