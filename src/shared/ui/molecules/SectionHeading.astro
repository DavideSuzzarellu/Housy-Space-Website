---
import Emphasis from "@/shared/ui/atoms/Emphasis.astro";

/** Editorial h2; `heading` may mark a light-weight part with `*asterisks*`. */
interface Props {
  id: string;
  heading: string;
  size?: "md" | "lg" | "data" | "xl" | "home";
  class?: string;
}

const { id, heading, size = "md", class: className } = Astro.props;

const SIZES = {
  md: "text-[clamp(1.5625rem,2.8vw,2.375rem)]",
  lg: "text-[clamp(1.75rem,4.2vw,3.5rem)] leading-[1.04]",
  data: "text-[clamp(1.875rem,3.4vw,2.75rem)] text-balance",
  /** Reference `--hs-h2-lg`: 28 px to 44 px at 3vw. */
  xl: "text-[clamp(1.75rem,3vw,2.75rem)]",
  /** Reference home (`--hs-home-h`): one scale for every home section heading. */
  home: "text-[clamp(1.6875rem,3.05vw,2.75rem)] leading-[1.08] tracking-[0.02em]",
} as const;
---

<h2 id={id} data-reveal class:list={[SIZES[size], className]}>
  <Emphasis text={heading} />
</h2>
