---
import Emphasis from "@/shared/ui/atoms/Emphasis.astro";

/** Editorial h2; `heading` may mark a light-weight part with `*asterisks*`. */
interface Props {
  id: string;
  heading: string;
  size?: "md" | "lg";
  class?: string;
}

const { id, heading, size = "md", class: className } = Astro.props;

const SIZES = {
  md: "text-[clamp(1.5rem,3.6vw,2.5rem)]",
  lg: "text-[clamp(1.75rem,4.2vw,3.5rem)] leading-[1.04]",
} as const;
---

<h2 id={id} data-reveal class:list={[SIZES[size], className]}>
  <Emphasis text={heading} />
</h2>
