---
import Eyebrow from "./Eyebrow.astro";

/** Eyebrow + editorial h2. */
interface Props {
  id: string;
  number: string;
  tag: string;
  heading: string;
  size?: "md" | "lg";
  eyebrowTone?: "accent" | "light";
  class?: string;
}

const {
  id,
  number,
  tag,
  heading,
  size = "md",
  eyebrowTone = "accent",
  class: className,
} = Astro.props;

const SIZES = {
  md: "text-[clamp(1.5rem,3.6vw,2.5rem)]",
  lg: "text-[clamp(1.75rem,4.2vw,3.5rem)] leading-[1.04]",
} as const;
---

<div class:list={["max-w-180", className]}>
  <Eyebrow number={number} tag={tag} tone={eyebrowTone} />
  <h2 id={id} data-reveal class:list={["mt-3", SIZES[size]]}>
    {heading}
  </h2>
</div>
