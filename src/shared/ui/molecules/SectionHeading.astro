---
import Eyebrow from "./Eyebrow.astro";

/** Eyebrow + editorial h2 with the growing turquoise accent rule. */
interface Props {
  id: string;
  number: string;
  tag: string;
  heading: string;
  size?: "md" | "lg";
  eyebrowTone?: "accent" | "light";
  class?: string;
}

const {
  id,
  number,
  tag,
  heading,
  size = "md",
  eyebrowTone = "accent",
  class: className,
} = Astro.props;

const SIZES = {
  md: "text-[clamp(2rem,5.4vw,3.375rem)]",
  lg: "text-[clamp(2.25rem,5.8vw,4.625rem)] leading-[1.04]",
} as const;
---

<div class:list={["max-w-180", className]}>
  <Eyebrow number={number} tag={tag} tone={eyebrowTone} />
  <h2 id={id} data-reveal class:list={["mt-3", SIZES[size]]}>
    {heading}
    <span
      aria-hidden="true"
      data-accent
      class="mt-4 block h-0.5 w-16 origin-left bg-turquoise"
    ></span>
  </h2>
</div>
