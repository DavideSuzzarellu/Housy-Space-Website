---
import Container from "@/shared/ui/atoms/Container.astro";

/** Page section: vertical rhythm + centered container, labelled by its heading. */
interface Props {
  id: string;
  labelledBy: string;
  /** Stable hook for tests/analytics (e.g. "services"). */
  name: string;
  spacing?: "default" | "spacious";
  surface?: "paper" | "stone" | "dark";
  class?: string;
}

const {
  id,
  labelledBy,
  name,
  spacing = "default",
  surface = "paper",
  class: className,
} = Astro.props;

const SPACING = {
  default: "py-[clamp(2.75rem,5vw,4.125rem)]",
  spacious: "py-[clamp(4.5rem,8vw,7.5rem)]",
} as const;

const SURFACES = {
  paper: "bg-canvas",
  stone: "surface-stone bg-canvas",
  dark: "surface-dark bg-canvas",
} as const;
---

<section
  id={id}
  aria-labelledby={labelledBy}
  data-section={name}
  class:list={["relative isolate", SPACING[spacing], SURFACES[surface], className]}
>
  <slot name="background" />
  <Container>
    <slot />
  </Container>
</section>
