---
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { formatPrice } from "@/shared/lib/format";

/** Price or "price on request" (AGENTS.md §5). Structurally compatible with the domain `Price`. */
interface Props {
  locale: Locale;
  price: { readonly kind: "amount"; readonly amount: number } | { readonly kind: "onRequest" };
  /** Appends "/month" (rentals). */
  perMonth?: boolean;
  class?: string;
}

const { locale, price, perMonth = false, class: className } = Astro.props;
const t = getDictionary(locale).property;
---

<p class:list={["text-[2rem] leading-none", className]}>
  {price.kind === "amount" ? (
    <>
      {formatPrice(price.amount, locale)}
      {perMonth && <small class="font-sans text-sm text-muted">{t.perMonth}</small>}
    </>
  ) : (
    <span class="text-2xl">{t.priceOnRequest}</span>
  )}
</p>
