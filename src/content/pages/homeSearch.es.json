      "band": false,
      "items": [
        {
          "kind": "h2",
          "text": "Cómo funciona"
        },
        {
          "kind": "steps",
          "items": [
            {
              "title": "Cuéntanos qué buscas",
              "text": "Indícanos dónde te gustaría vivir, tu presupuesto y qué características buscas en tu vivienda."
            },
            {
              "title": "Guardamos tu búsqueda",
              "text": "Registramos tus preferencias en nuestra base de datos para identificar viviendas que puedan encajar."
            },
            {
              "title": "Te avisamos antes",
              "text": "Si recibimos una vivienda que encaja con tu búsqueda, te contactamos antes de publicarla."
            }
          ]
        }
      ]
    },
