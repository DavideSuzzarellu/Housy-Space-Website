    {
      "surface": "stone",
      "band": false,
      "items": [
        {
          "kind": "h2",
          "text": "Come funziona"
        },
        {
          "kind": "steps",
          "items": [
            {
              "title": "Dicci cosa cerchi",
              "text": "Tipo di operazione, zona, budget e requisiti indispensabili. Rispondi passo dopo passo. Più sei preciso, meglio è."
            },
            {
              "title": "Salviamo la tua ricerca",
              "text": "Viene registrata nel nostro database di acquirenti, con la stessa struttura di una scheda immobile: operazione, tipo, zona, prezzo, superficie, camere e caratteristiche."
            },
            {
              "title": "Ti avvisiamo e ti accompagniamo",
              "text": "Quando entra un immobile adatto, un consulente ti contatta. Se vuoi, ti accompagniamo nelle visite e in tutto il processo."
            }
          ]
        }
      ]
    },
