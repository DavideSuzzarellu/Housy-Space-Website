        {
          "kind": "steps",
          "items": [
            {
              "title": "Raccontaci cosa cerchi",
              "text": "Indicaci dove ti piacerebbe vivere, il tuo budget e le caratteristiche che cerchi nella tua casa."
            },
            {
              "title": "Salviamo la tua ricerca",
              "text": "Registriamo le tue preferenze nel nostro database per individuare le case che possono fare al caso tuo."
            },
            {
              "title": "Ti avvisiamo prima",
              "text": "Se riceviamo una casa in linea con la tua ricerca, ti contattiamo prima di pubblicarla."
            }
          ]
        }
      ]
