  "sections": [
    {
      "surface": "stone",
      "band": false,
      "items": [
        {
          "kind": "h2",
          "text": "Com funciona"
        },
        {
          "kind": "steps",
          "items": [
            {
              "title": "Explica'ns què busques",
              "text": "Indica'ns on t'agradaria viure, el teu pressupost i quines característiques busques en el teu habitatge."
            },
            {
              "title": "Guardem la teva cerca",
              "text": "Registrem les teves preferències a la nostra base de dades per identificar habitatges que puguin encaixar."
            },
            {
              "title": "T'avisem abans",
              "text": "Si rebem un habitatge que encaixa amb la teva cerca, ens posem en contacte amb tu abans de publicar-lo."
            }
          ]
        }
      ]
    },
