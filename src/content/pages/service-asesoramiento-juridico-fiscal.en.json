              "items": [
                {
                  "title": "Property transfer tax (ITP)",
                  "text": "Generalitat. Second-hand homes."
                },
                {
                  "title": "Stamp duty (AJD)",
                  "text": "Generalitat. New builds or signing a mortgage."
                }
              ]
            }
          ]
        },
