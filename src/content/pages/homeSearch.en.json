{
  "title": "My search · HousySpace",
  "description": "Tell us what you're looking for in a property to buy or rent: we save it in our database and alert you when a matching listing comes in.",
  "head": {
    "heading": "Your next home *starts here*",
    "photo": false,
    "items": [
      {
        "kind": "tag",
        "text": "Find a home in Barcelona"
      },
      {
        "kind": "lead",
        "text": "Tell us what kind of home you are looking for and join our database. When we have a property that fits your preferences, we will contact you so you can see it before it is published."
      },
      {
        "kind": "buttons",
        "items": [
          {
            "label": "Start your search",
            "href": "#formulario",
            "solid": true
          }
        ]
      }
    ]
  },
  "sections": [
    {
      "surface": "stone",
      "band": false,
      "items": [
        {
          "kind": "h2",
          "text": "How it works"
        },
        {
          "kind": "steps",
          "items": [
            {
              "title": "Tell us what you are looking for",
              "text": "Tell us where you would like to live, your budget and the features you want in your home."
            },
            {
              "title": "We save your search",
              "text": "We record your preferences in our database to identify homes that may fit."
            },
            {
              "title": "We tell you first",
              "text": "If we receive a home that fits your search, we contact you before it is published."
            }
          ]
        }
      ]
    },
