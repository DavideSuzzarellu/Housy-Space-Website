{
  "title": "My search · HousySpace",
  "description": "Tell us what you're looking for in a property to buy or rent: we save it in our database and alert you when a matching listing comes in.",
  "head": {
    "heading": "I'm looking for a property",
    "photo": false,
    "items": [
      {
        "kind": "tag",
        "text": "Buy or rent"
      },
      {
        "kind": "lead",
        "text": "Tell us what you need. We save your search in our buyers database, using the same fields as our property listings, and alert you when something matching comes in."
      }
    ]
  },
  "sections": [
    {
      "surface": "stone",
      "band": false,
      "items": [
        {
          "kind": "h2",
          "text": "How it works"
        },
        {
          "kind": "steps",
          "items": [
            {
              "title": "Tell us what you're looking for",
              "text": "Operation, area, budget and must-haves. Answer step by step. The more specific, the better."
            },
            {
              "title": "We save your search",
              "text": "It's registered in our buyers database, with the same structure as a property listing: operation, type, area, price, size, bedrooms and features."
            },
            {
              "title": "We'll alert you and guide you",
              "text": "When a matching listing comes in, an adviser will get in touch. If you wish, we'll accompany you on viewings and throughout the whole process."
            }
          ]
        }
      ]
    },
