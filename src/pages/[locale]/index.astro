---
import type { GetStaticPaths } from "astro";
import { getHomeContent } from "@/features/agency/application/homeContent";
import BlogTeaser from "@/features/blog/ui/BlogTeaser.astro";
import HomeHero from "@/features/agency/ui/HomeHero.astro";
import HomePresentation from "@/features/agency/ui/HomePresentation.astro";
import HomePhilosophy from "@/features/agency/ui/HomePhilosophy.astro";
import ServicesAccordion from "@/features/agency/ui/ServicesAccordion.astro";
import LivingInBarcelona from "@/features/districts/ui/LivingInBarcelona.astro";
import { getReviewsSummary } from "@/features/reviews/application/reviews";
import { getPosts } from "@/features/blog/application/posts";
import { getFeaturedProperties } from "@/features/properties/application";
import FeaturedProperties from "@/features/properties/ui/FeaturedProperties.astro";
import ReviewsSection from "@/features/reviews/ui/ReviewsSection.astro";
import ValuationExplainer from "@/features/valuation/ui/ValuationExplainer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDictionary } from "@/shared/i18n";
import { LOCALES, type Locale } from "@/shared/i18n/config";
import { getAlternates } from "@/shared/i18n/routes";
import IntroGate from "@/shared/ui/motion/IntroGate.astro";
import IntroOverlay from "@/shared/ui/motion/IntroOverlay.astro";

export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({ params: { locale }, props: { locale } }))) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const alternates = getAlternates("home");
const featured = await getFeaturedProperties();
const content = await getHomeContent(locale);
const reviews = await getReviewsSummary();
const posts = (await getPosts()).slice(0, 3);
const PRESENTATION_ID = "presentacion";
---

<BaseLayout
  locale={locale}
  title={t.home.metaTitle}
  description={t.home.metaDescription}
  alternates={alternates}
  headerOverlay
>
  <IntroGate slot="head" />
  <IntroOverlay locale={locale} />
  <HomeHero locale={locale} content={content.hero} nextSectionId={PRESENTATION_ID} />
  <HomePresentation locale={locale} id={PRESENTATION_ID} content={content.presentation} />
  <FeaturedProperties locale={locale} properties={featured} content={content.featured} />
  <ValuationExplainer locale={locale} content={content.valuation} />
  <ServicesAccordion
    locale={locale}
    content={content.services}
    collaborators={content.collaborators}
  />
  <HomePhilosophy locale={locale} content={content.philosophy} />
  <ReviewsSection locale={locale} content={content.reviews} summary={reviews} />
  <LivingInBarcelona locale={locale} content={content.districts} />
  <BlogTeaser locale={locale} content={content.blog} posts={posts} />
</BaseLayout>
