---
import {
  COMPANY_EMAIL,
  CONTACT_PHONE,
  mailtoHref as plainMailtoHref,
  whatsappHref,
} from "@/features/agency/domain/contact";
import type { FormField } from "@/features/pages/infrastructure/pageSchema";
import type { Locale } from "@/shared/i18n/config";
import { getDictionary } from "@/shared/i18n";
import LeadField from "./LeadField.astro";

/**
 * The one lead form: fields come from content. Until the CRM receives forms (ROADMAP I3) it opens
 * WhatsApp or the mail client with the request already written; the visitor sends it.
 */
interface Props {
  locale: Locale;
  id: string;
  mode: "whatsapp" | "email";
  intro?: string | undefined;
  fields: readonly FormField[];
}

const { locale, id, mode, intro, fields } = Astro.props;
const t = getDictionary(locale).forms;
const target = mode === "whatsapp" ? whatsappHref(CONTACT_PHONE) : plainMailtoHref(COMPANY_EMAIL);
const isGrouped = fields.some((field) => field.kind === "group");
---

<form
  id={id}
  data-lead-form
  data-mode={mode}
  data-target={target}
  data-intro={intro}
  data-subject={t.emailSubject}
  data-sent={mode === "whatsapp" ? t.sentWhatsapp : t.sentEmail}
  novalidate
  class:list={["mt-6 grid gap-5", !isGrouped && "sm:grid-cols-2"]}
>
  {fields.map((field) =>
    field.kind === "group" ? (
      <fieldset class="grid gap-4 border-t border-line pt-6 sm:grid-cols-2">
        <legend class="float-left mb-1 w-full text-base font-bold text-fg sm:col-span-2">
          {field.title}
          {field.hint !== undefined && (
            <small class="mt-1 block text-xs font-normal tracking-[0.04em] text-muted">
              {field.hint}
            </small>
          )}
        </legend>
        {field.fields.map((leaf) => (
          <LeadField locale={locale} field={leaf} />
        ))}
      </fieldset>
    ) : (
      <LeadField locale={locale} field={field} />
    ),
  )}
  <p
    data-lead-status
    role="status"
    aria-live="polite"
    hidden
    class="border-l-2 border-accent py-1 pl-3 text-sm sm:col-span-2"
  ></p>
</form>

<script>
  import "./leadForm.client";
</script>
