---
import type { FormLeaf } from "@/features/pages/infrastructure/pageSchema";
import type { Locale } from "@/shared/i18n/config";
import { plainInline } from "@/shared/lib/inline";
import Button from "@/shared/ui/atoms/Button.astro";
import Inline from "@/shared/ui/atoms/Inline.astro";

/** One control of a `LeadForm`. `data-lead-field` marks what goes into the message. */
interface Props {
  locale: Locale;
  field: FormLeaf;
}

const { locale, field } = Astro.props;
const CONTROL =
  "min-h-13.5 w-full border border-line-strong bg-transparent px-4 py-2.5 text-[0.9375rem] font-normal tracking-[0.02em] text-fg transition-colors hover:border-petrol focus:border-petrol";
const LABEL =
  "flex flex-col gap-2 text-[0.6875rem] leading-[1.4] font-medium tracking-[0.14em] text-fg";
const CHIP =
  "relative flex min-h-10.5 cursor-pointer flex-col justify-center border border-line-strong px-4 py-2 text-[0.6875rem] tracking-[0.12em] transition-colors hover:border-petrol has-checked:border-petrol has-checked:bg-petrol has-checked:text-canvas has-focus-visible:outline-2 has-focus-visible:outline-offset-3 has-focus-visible:outline-accent";
/** Single-choice answers (buy / rent) are big cards, as in the reference. */
const CARD = "min-h-28 items-center text-center text-sm! tracking-[0.16em]!";
---

{field.kind === "field" && field.type === "consent" && (
  <label
    data-lead-field
    data-label={plainInline(field.label)}
    class="flex items-start gap-3 border border-line bg-card px-3.5 py-3 text-[0.6875rem] leading-normal text-fg-2 sm:col-span-2"
  >
    <input
      type="checkbox"
      name={field.name}
      required={field.required}
      class="mt-0.5 size-5 shrink-0 accent-turquoise"
    />
    <span>
      <Inline text={field.label} locale={locale} />
    </span>
  </label>
)}
{field.kind === "field" && field.type !== "consent" && (
  <label
    data-lead-field
    data-label={field.label}
    class:list={[LABEL, field.full && "sm:col-span-2"]}
  >
    <span>
      {field.label}
      {field.required && " *"}
    </span>
    {field.type === "select" ? (
      <select name={field.name} required={field.required} class={CONTROL}>
        <option value=""></option>
        {(field.options ?? []).map((option) => (
          <option>{option}</option>
        ))}
      </select>
    ) : field.type === "textarea" ? (
      <textarea name={field.name} rows="4" required={field.required} class={CONTROL}></textarea>
    ) : (
      <input
        type={field.type}
        name={field.name}
        required={field.required}
        placeholder={field.placeholder}
        class={CONTROL}
      />
    )}
  </label>
)}
{field.kind === "chips" && (
  <div
    data-lead-field
    data-label={field.label ?? field.name}
    data-when={field.when}
    hidden={field.when !== undefined}
    class="sm:col-span-2"
  >
    {field.label !== undefined && <p class="mb-2 text-xs text-muted">{field.label}</p>}
    <div class:list={["flex flex-wrap gap-2", field.radio && "grid grid-cols-2 gap-3"]}>
      {field.options.map((option) => (
        <label class:list={[CHIP, field.radio && CARD]}>
          <input
            type={field.radio ? "radio" : "checkbox"}
            name={field.name}
            value={option.value}
            data-label={option.label}
            required={field.required}
            class="absolute size-px opacity-0"
          />
          <b class="font-semibold">{option.label}</b>
          {option.hint !== undefined && <small class="opacity-80">{option.hint}</small>}
        </label>
      ))}
    </div>
  </div>
)}
{field.kind === "note" && (
  <p class="text-xs text-muted sm:col-span-2">
    <Inline text={field.text} locale={locale} />
  </p>
)}
{field.kind === "details" && (
  <details class="text-xs text-muted sm:col-span-2">
    <summary class="cursor-pointer font-medium text-accent">{field.summary}</summary>
    <p class="mt-2">
      <Inline text={field.text} locale={locale} />
    </p>
  </details>
)}
{field.kind === "submit" && (
  <div class="sm:col-span-2">
    <Button type="submit" variant="solid" size="lg">
      {field.label}
    </Button>
  </div>
)}
