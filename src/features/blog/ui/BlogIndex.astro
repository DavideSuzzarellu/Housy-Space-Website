---
import StreetGrid from "@/features/agency/ui/StreetGrid.astro";
import type { BlogPost } from "@/features/blog/application/posts";
import { BLOG_CATEGORIES } from "@/features/blog/domain/articleModel";
import type { PageContent } from "@/features/pages/application/pages";
import { groupItems } from "@/features/pages/application/pages";
import PageItems from "@/features/pages/ui/PageItems.astro";
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import Button from "@/shared/ui/atoms/Button.astro";
import Container from "@/shared/ui/atoms/Container.astro";
import Emphasis from "@/shared/ui/atoms/Emphasis.astro";
import Breadcrumbs from "@/shared/ui/molecules/Breadcrumbs.astro";
import PostCard from "./PostCard.astro";

/** Blog index (articles or the empty state): reference head, category filter, grid, owners CTA and newsletter. */
interface Props {
  locale: Locale;
  content: PageContent;
  posts: readonly BlogPost[];
  crumbs: readonly { readonly label: string; readonly href?: string }[];
}

const { locale, content, posts, crumbs } = Astro.props;
const t = getDictionary(locale);
const lead = content.head.items.find((item) => item.kind === "lead");
const tag = content.head.items.find((item) => item.kind === "tag");
const newsletter = content.sections.filter((section) => section.id === "newsletter");
const categories = BLOG_CATEGORIES.filter((category) =>
  posts.some((post) => post.data.category === category),
);
const CHIP =
  "min-h-8.5 cursor-pointer border border-fg/30 px-4 text-[0.6875rem] font-medium tracking-[0.14em] text-fg aria-pressed:border-fg aria-pressed:bg-fg aria-pressed:text-canvas";
---

<section
  data-page-head
  class="relative isolate overflow-clip bg-canvas pt-9.5 pb-[clamp(1.875rem,5vh,3.25rem)]"
>
  <StreetGrid placement="heading" />
  <Container class="flex flex-col items-center text-center">
    <Breadcrumbs
      items={crumbs}
      label={t.property.detail.breadcrumb}
      tone="compact"
      class="mb-[clamp(1.25rem,5vh,3.375rem)] self-start"
    />
    {tag?.kind === "tag" && (
      <p class="mb-3 text-[0.6875rem] tracking-[0.16em] text-accent">{tag.text}</p>
    )}
    <h1 class="text-[clamp(3.5rem,10vw,9.375rem)] leading-[0.9] font-extrabold [&_em]:font-[inherit] after:mx-auto after:mt-[clamp(1.125rem,2.6vh,1.75rem)] after:block after:h-[3px] after:w-16 after:bg-turquoise after:content-['']">
      <Emphasis text={content.head.heading} />
    </h1>
    {lead?.kind === "lead" && (
      <p class="mt-[clamp(0.875rem,2vh,1.375rem)] text-[1.17rem] normal-case leading-[1.5]">
        {lead.text}
      </p>
    )}
    <a
      href="#articulos"
      class="mt-[clamp(1.125rem,2.6vh,1.75rem)] inline-flex items-center gap-2 border-b border-fg pb-1.25 text-[0.71875rem] leading-[1.3] font-semibold tracking-[0.16em] text-fg no-underline"
    >
      {t.blog.explore}
      <svg
        viewBox="0 0 12 12"
        aria-hidden="true"
        focusable="false"
        class="size-3 flex-none fill-none stroke-current stroke-[1.4]"
      >
        <path d="M6 1v10M2 7l4 4 4-4"></path>
      </svg>
    </a>
  </Container>
</section>

<section
  id="articulos"
  aria-labelledby="blog-list-heading"
  class="bg-canvas py-[clamp(2.75rem,4vw,3.5rem)]"
>
  <Container>
    <h2
      id="blog-list-heading"
      class="mb-4.5 text-[clamp(1.75rem,2.64vw,2.375rem)] [&_em]:font-[inherit] after:mt-4 after:block after:h-0.5 after:w-16 after:bg-turquoise after:content-['']"
    >
      <Emphasis text={t.blog.listHeading} />
    </h2>
    <div class="mb-9 border-t border-line pt-4.5">
      {categories.length > 1 && (
        <div
          role="group"
          aria-label={t.blog.filterLabel}
          data-blog-filter
          class="flex flex-wrap gap-2"
        >
          <button type="button" data-filter="" aria-pressed="true" class={CHIP}>
            {t.blog.all}
          </button>
          {categories.map((category) => (
            <button type="button" data-filter={category} aria-pressed="false" class={CHIP}>
              {t.blog.categories[category]}
            </button>
          ))}
        </div>
      )}
    </div>
    {posts.length === 0 ? (
      <p data-blog-empty class="max-w-[68ch] border-l-2 border-turquoise py-1 pl-3 text-muted">
        {t.home.blog.empty}
      </p>
    ) : (
      <div
        data-blog-grid
        class="group/grid grid gap-x-[clamp(1.125rem,2.4vw,2.25rem)] gap-y-[clamp(2.25rem,4vw,3.5rem)] min-[700px]:grid-cols-2 min-[1100px]:grid-cols-6 min-[1100px]:[&>*]:col-span-2 min-[1100px]:[&>[data-new]]:col-span-3 min-[1100px]:group-data-filtered/grid:[&>[data-new]]:col-span-2"
      >
        {posts.map((post, index) => (
          <PostCard post={post} locale={locale} index={index} fresh={index < 2} />
        ))}
      </div>
    )}
  </Container>
</section>

<section
  aria-labelledby="blog-cta-heading"
  class="surface-dark bg-canvas py-[clamp(2.75rem,4.6vw,4.1875rem)] text-fg"
>
  <Container class="grid items-center gap-x-10 gap-y-7 min-[900px]:grid-cols-[1fr_auto]">
    <div>
      <p class="mb-2.5 text-[0.6875rem] tracking-[0.16em] text-accent">{t.blog.ownersKicker}</p>
      <h2
        id="blog-cta-heading"
        class="text-[clamp(1.75rem,2.64vw,2.375rem)] [&_em]:block [&_em]:font-[inherit]"
      >
        <Emphasis text={t.blog.ctaHeading} />
      </h2>
      <p class="mt-3 max-w-[34.5rem] text-[clamp(0.9375rem,1.12vw,1.008rem)] leading-[1.55] text-muted">
        {t.blog.ctaText}
      </p>
    </div>
    <div class="flex flex-col gap-2.5 min-[900px]:w-66">
      <Button
        href={getLocalizedPath("valuation", locale)}
        variant="accent"
        size="wide"
        arrow
        class="bg-turquoise px-6.5! py-4! text-ink! whitespace-nowrap"
      >
        {t.blog.ctaValue}
      </Button>
      <Button
        href={getLocalizedPath("contact", locale)}
        variant="outline"
        size="wide"
        arrow
        class="px-6.5! py-4! whitespace-nowrap"
      >
        {t.blog.ctaTalk}
      </Button>
    </div>
  </Container>
</section>

{newsletter.map((section) => (
  <section id={section.id} class="bg-canvas py-[clamp(2.75rem,5vw,4.125rem)]">
    <Container>
      <PageItems locale={locale} units={groupItems(section.items)} />
    </Container>
  </section>
))}

<script>
  document.addEventListener("astro:page-load", () => {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-blog-filter] button")];
    const grid = document.querySelector<HTMLElement>("[data-blog-grid]");
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const category = button.dataset["filter"] ?? "";
        buttons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
        grid?.toggleAttribute("data-filtered", category !== "");
        document.querySelectorAll<HTMLElement>("[data-post-card]").forEach((card) => {
          card.hidden = category !== "" && card.dataset["category"] !== category;
        });
      });
    });
  });
</script>
