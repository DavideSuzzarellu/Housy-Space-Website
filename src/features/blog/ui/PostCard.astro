---
import { Picture } from "astro:assets";
import type { BlogPost } from "@/features/blog/application/posts";
import { formatDate } from "@/shared/lib/format";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import { PHOTO_PICTURE } from "@/shared/lib/images";
import { morph } from "@/shared/ui/motion/transitions";

/** Article card of the home teaser and the blog index. */
interface Props {
  post: BlogPost;
  locale: Locale;
  /**
   * `stack`: image above the text. `teaser`: home layout of the reference, a row (image 42%)
   * with a hairline under 900 px that stacks from 900 px, with the meta line in uppercase.
   */
  layout?: "stack" | "teaser";
}

const { post, locale, layout = "stack" } = Astro.props;
const teaser = layout === "teaser";
---

<a
  href={getLocalizedPath("blogPost", locale, { slug: post.id })}
  data-post-card
  data-category={post.data.category}
  class:list={[
    "group text-inherit no-underline",
    teaser
      ? "grid grid-cols-[42%_1fr] items-center gap-5 border-b border-line pb-6.5 last:border-b-0 min-[900px]:grid-cols-1 min-[900px]:items-start min-[900px]:gap-4.5 min-[900px]:border-b-0 min-[900px]:pb-0"
      : "block",
  ]}
>
  <div
    class="aspect-4/3 overflow-hidden bg-bg-deep"
    transition:name={`post-${post.id}-image`}
    transition:animate={morph}
  >
    <Picture
      {...PHOTO_PICTURE}
      src={post.data.image}
      alt={post.data.imageAlt}
      widths={[480, 800]}
      sizes="(min-width: 768px) 24rem, 100vw"
      class="size-full object-cover transition-transform duration-1200 ease-brand group-hover:scale-105"
    />
  </div>
  <div>
    <p
      class:list={[
        "text-[0.6875rem] tracking-[0.14em]",
        teaser ? "mb-1.5 grid gap-[3px] uppercase" : "mt-4 flex flex-wrap gap-x-3.5 gap-y-1",
      ]}
    >
      <span class="text-accent">{post.data.category}</span>
      <time datetime={post.data.date.toISOString()} class="text-muted">
        {formatDate(post.data.date, locale)}
      </time>
    </p>
    <h3
      lang={post.data.language}
      class:list={[
        teaser
          ? "m-0 text-[clamp(1.25rem,1.7vw,1.5rem)] leading-[1.12]"
          : "mt-2 text-[clamp(1.125rem,1.7vw,1.375rem)]",
      ]}
    >
      {post.data.title}
    </h3>
  </div>
</a>
