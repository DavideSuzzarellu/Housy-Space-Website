---
import { Picture } from "astro:assets";
import { render } from "astro:content";
import StreetGrid from "@/features/agency/ui/StreetGrid.astro";
import type { BlogPost } from "@/features/blog/application/posts";
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import { formatDate } from "@/shared/lib/format";
import { PHOTO_PICTURE } from "@/shared/lib/images";
import { postTransitionName } from "@/shared/lib/transitionNames";
import { morph } from "@/shared/ui/motion/transitions";
import Button from "@/shared/ui/atoms/Button.astro";
import Container from "@/shared/ui/atoms/Container.astro";
import Breadcrumbs from "@/shared/ui/molecules/Breadcrumbs.astro";
import PostValuation from "./PostValuation.astro";

/** One article. `lang` marks its real language when it differs from the page's locale. */
interface Props {
  post: BlogPost;
  locale: Locale;
}

const { post, locale } = Astro.props;
const dictionary = getDictionary(locale);
const { Content } = await render(post);
const crumbs = [
  { label: dictionary.property.detail.home, href: getLocalizedPath("home", locale) },
  { label: dictionary.nav.blog, href: getLocalizedPath("blog", locale) },
  { label: post.data.title },
];
---

<article lang={post.data.language} data-post>
  <header class="relative isolate overflow-clip bg-canvas pt-9.5 pb-[clamp(2.5rem,4.4vw,3.9375rem)]">
    <StreetGrid placement="heading" />
    <Container>
      <Breadcrumbs
        items={crumbs}
        label={dictionary.property.detail.breadcrumb}
        tone="compact"
        class="mb-[clamp(1.25rem,5vh,2.8125rem)]"
      />
      <div class="max-w-215">
        <h1 class="text-[clamp(1.875rem,3.47vw,3.125rem)] leading-[1.08] font-black">
          {post.data.title}
        </h1>
        <p class="mt-[clamp(1rem,1.5vw,1.35rem)] max-w-180 text-[clamp(1.0625rem,1.35vw,1.215rem)] leading-[1.6] text-mid normal-case">
          {post.data.description}
        </p>
        <p
          data-post-meta
          class="mt-[clamp(1.25rem,1.9vw,1.6875rem)] flex flex-wrap gap-y-1 border-t border-line pt-3.5 text-[0.6875rem] leading-[1.4] font-medium tracking-[0.14em] text-muted"
        >
          <span class="border-r border-line pr-3.5 text-accent">{post.data.category}</span>
          <time
            datetime={post.data.date.toISOString()}
            class:list={["px-3.5", post.data.author !== undefined && "border-r border-line"]}
          >
            {formatDate(post.data.date, locale)}
          </time>
          {post.data.author !== undefined && <span class="pl-3.5">{post.data.author}</span>}
        </p>
      </div>
    </Container>
  </header>
  <Container>
    <Picture
      {...PHOTO_PICTURE}
      src={post.data.image}
      alt={post.data.imageAlt}
      widths={[800, 1400]}
      sizes="(min-width: 1120px) 70rem, 100vw"
      priority
      class="aspect-4/3 w-full object-cover min-[700px]:aspect-[1076/414]"
      transition:name={postTransitionName(post.id, "image")}
      transition:animate={morph}
    />
    <div class="blog-body mx-auto max-w-175 pt-[clamp(2.25rem,3.4vw,3.375rem)] pb-[clamp(2.25rem,5vw,3.5rem)]">
      <Content />
    </div>
    <div class="mx-auto max-w-175 pb-[clamp(2rem,3vw,2.5rem)]">
      <Button href={getLocalizedPath("blog", locale)}>{dictionary.blog.back}</Button>
    </div>
  </Container>
  <PostValuation locale={locale} />
</article>
