---
import { getImage, Picture } from "astro:assets";
import { render } from "astro:content";
import { COMPANY } from "@/features/agency/domain/company";
import { buildArticleJsonLd } from "@/features/blog/application/blogJsonLd";
import type { BlogPost } from "@/features/blog/application/posts";
import { readingMinutes } from "@/features/blog/domain/markdown";
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import { formatDate, formatMessage } from "@/shared/lib/format";
import { PHOTO_PICTURE } from "@/shared/lib/images";
import Button from "@/shared/ui/atoms/Button.astro";
import Container from "@/shared/ui/atoms/Container.astro";
import JsonLd from "@/shared/ui/atoms/JsonLd.astro";
import Breadcrumbs from "@/shared/ui/molecules/Breadcrumbs.astro";
import PostCta from "./PostCta.astro";
import PostSources from "./PostSources.astro";
import PostToc from "./PostToc.astro";

/** One article. `lang` marks its real language when it differs from the page's locale. */
interface Props {
  post: BlogPost;
  locale: Locale;
}

const { post, locale } = Astro.props;
const dictionary = getDictionary(locale);
const { Content, headings } = await render(post);
const crumbs = [
  { label: dictionary.property.detail.home, href: getLocalizedPath("home", locale) },
  { label: dictionary.nav.blog, href: getLocalizedPath("blog", locale) },
  { label: post.data.title },
];
const minutes = readingMinutes(post.body ?? "");
const site = Astro.site ?? new URL(Astro.url.origin);
const image = await getImage({ src: post.data.image, width: 1400, format: "webp" });
// An article is indexed only in its own language, so its canonical is that language's URL.
const jsonLd = buildArticleJsonLd({
  article: post.data,
  categoryName: getDictionary(post.data.language).blog.categories[post.data.category],
  url: new URL(getLocalizedPath("blogPost", post.data.language, { slug: post.id }), site).href,
  imageUrl: new URL(image.src, site).href,
  siteUrl: site.href,
  company: COMPANY,
});
---

<article lang={post.data.language} data-post>
  <JsonLd data={jsonLd} />
  <header class="bg-canvas pt-8 pb-8">
    <Container>
      <Breadcrumbs items={crumbs} label={dictionary.property.detail.breadcrumb} class="mb-7" />
      <p class="flex flex-wrap gap-x-3.5 gap-y-1 text-[0.6875rem] tracking-[0.14em]">
        <span class="text-accent">{dictionary.blog.categories[post.data.category]}</span>
        <time datetime={post.data.date.toISOString()} class="text-muted">
          {formatDate(post.data.date, locale)}
        </time>
        {post.data.updatedAt !== undefined && (
          <time datetime={post.data.updatedAt.toISOString()} data-post-updated class="text-muted">
            {formatMessage(dictionary.blog.updated, {
              date: formatDate(post.data.updatedAt, locale),
            })}
          </time>
        )}
        <span data-post-reading-time class="text-muted">
          {formatMessage(dictionary.blog.readingTime, { minutes })}
        </span>
      </p>
      <h1 class="mt-3 max-w-[24ch] text-[clamp(1.75rem,4.4vw,3.25rem)]">{post.data.title}</h1>
      <p class="mt-4 max-w-[62ch] text-muted">{post.data.description}</p>
    </Container>
  </header>
  <Container>
    <Picture
      {...PHOTO_PICTURE}
      src={post.data.image}
      alt={post.data.imageAlt}
      widths={[800, 1400]}
      sizes="(min-width: 1120px) 70rem, 100vw"
      priority
      class="aspect-16/9 w-full object-cover"
    />
    <div class="mx-auto max-w-180 pt-[clamp(1.75rem,4vw,2.5rem)]">
      <PostToc locale={locale} headings={headings} />
    </div>
    <div class="blog-body mx-auto max-w-180 py-[clamp(2.25rem,5vw,3.5rem)]">
      <Content />
    </div>
    <div class="mx-auto grid max-w-180 gap-10 pb-[clamp(2.75rem,5vw,4.125rem)]">
      <PostSources locale={locale} sources={post.data.sources} />
      <PostCta locale={locale} objective={post.data.cta} />
      <div>
        <Button href={getLocalizedPath("blog", locale)}>{dictionary.blog.back}</Button>
      </div>
    </div>
  </Container>
</article>
