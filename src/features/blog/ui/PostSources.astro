---
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { formatDate, formatMessage } from "@/shared/lib/format";

/** Visible list of the official sources an article relies on (E-E-A-T). Hidden when empty. */
interface Props {
  locale: Locale;
  sources: readonly { readonly label: string; readonly url: string; readonly checkedAt: Date }[];
}

const { locale, sources } = Astro.props;
const copy = getDictionary(locale).blog;
---

{sources.length > 0 && (
  <section id="fuentes" aria-labelledby="fuentes-heading" data-post-sources>
    <h2 id="fuentes-heading" class="text-[clamp(1.125rem,2vw,1.375rem)]">
      {copy.sourcesTitle}
    </h2>
    <ul class="mt-3 grid gap-2 text-sm">
      {sources.map((source) => (
        <li>
          <a
            href={source.url}
            rel="noopener noreferrer"
            target="_blank"
            class="text-accent underline underline-offset-4"
          >
            {source.label}
          </a>
          <span class="text-muted">
            {" · "}
            {formatMessage(copy.sourceChecked, { date: formatDate(source.checkedAt, locale) })}
          </span>
        </li>
      ))}
    </ul>
  </section>
)}
