---
import type { BlogPost } from "@/features/blog/application/posts";
import type { HomeContent } from "@/features/agency/application/homeContent";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import Button from "@/shared/ui/atoms/Button.astro";
import Container from "@/shared/ui/atoms/Container.astro";
import SectionHeading from "@/shared/ui/molecules/SectionHeading.astro";
import PostCard from "./PostCard.astro";

/**
 * Latest articles (reference `#blog`). The reference always shows one article; with none published
 * yet this section does not render (the blog page has its own empty state), like the reviews.
 */
interface Props {
  locale: Locale;
  content: HomeContent["blog"];
  posts: readonly BlogPost[];
}

const { locale, content, posts } = Astro.props;
---

{posts.length > 0 && (
  <section
    id="blog"
    aria-labelledby="blog-heading"
    data-section="blog"
    class="defer-render bg-canvas py-[clamp(2.375rem,6.2vh,3.625rem)]"
  >
    <Container>
      <SectionHeading id="blog-heading" heading={content.heading} size="home" class="mb-5" />
      <div class="grid gap-[30px] min-[900px]:grid-cols-3 min-[900px]:gap-[clamp(1.75rem,3vw,2.75rem)]">
        {posts.map((post) => (
          <PostCard post={post} locale={locale} layout="teaser" />
        ))}
      </div>
      <div class="mt-[clamp(1.25rem,3vh,1.875rem)] flex justify-center">
        <Button href={getLocalizedPath("blog", locale)} variant="solid" size="big" arrow>
          {content.ctaLabel}
        </Button>
      </div>
    </Container>
  </section>
)}
