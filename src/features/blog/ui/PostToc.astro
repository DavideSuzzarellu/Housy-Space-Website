---
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";

/** Table of contents from the article's H2 headings (build time, no JS). Hidden under 3 items. */
interface Props {
  locale: Locale;
  headings: readonly { readonly slug: string; readonly text: string; readonly depth: number }[];
}

const { locale, headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2);
const title = getDictionary(locale).blog.tocTitle;
---

{items.length >= 3 && (
  <nav aria-label={title} data-post-toc class="border-y border-line py-4">
    <details open>
      <summary class="cursor-pointer text-[0.6875rem] font-bold tracking-[0.14em] text-muted">
        {title}
      </summary>
      <ol class="mt-3 grid list-decimal gap-1.5 pl-5 text-sm">
        {items.map((item) => (
          <li>
            <a href={`#${item.slug}`} class="text-accent underline underline-offset-4">
              {item.text}
            </a>
          </li>
        ))}
      </ol>
    </details>
  </nav>
)}
