---
/** One titled block of the property detail (description, features, map...). */
interface Props {
  id: string;
  heading: string;
  class?: string;
}

const { id, heading, class: className } = Astro.props;
---

<section aria-labelledby={id} class:list={["mt-9", className]}>
  <h2
    id={id}
    class="mb-2.5 text-[1.4375rem] leading-[1.15] font-bold after:mt-4 after:block after:h-0.5 after:w-16 after:bg-turquoise after:content-['']"
  >
    {heading}
  </h2>
  <slot />
</section>
