---
import { Picture } from "astro:assets";
import headPhoto from "@/assets/home/prop-cabecera-1672.webp";
import type { CatalogModel } from "@/features/properties/application/catalog";
import {
  CATALOG_PARAMS,
  CATALOG_VIEWS,
  SORT_PARAM_VALUES,
} from "@/features/properties/application/catalogQuery";
import { CATALOG_SORTS } from "@/features/properties/domain/catalog";
import type { DetailOperation } from "@/features/properties/domain/property";
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import { formatMessage } from "@/shared/lib/format";
import { PHOTO_PICTURE } from "@/shared/lib/images";
import { serializeJsonForScript } from "@/shared/lib/seo/jsonLd";
import Button from "@/shared/ui/atoms/Button.astro";
import Container from "@/shared/ui/atoms/Container.astro";
import MediaCredit from "@/shared/ui/atoms/MediaCredit.astro";
import Select from "@/shared/ui/atoms/Select.astro";
import CatalogFilters from "./CatalogFilters.astro";
import PropertyCard from "./PropertyCard.astro";

/**
 * Property catalog (AGENTS.md §6 item 18): filters, sort, list / list + map / map views.
 * Every listing is rendered server-side (zero JS needed to browse); the island filters and
 * reorders those cards from the URL and loads the map only when a map view is chosen.
 * Each ref appears once, so the card ↔ detail transition names stay unique.
 * The default slot (breadcrumbs and heading) goes in the dark head, above the filters.
 */
interface Props {
  locale: Locale;
  operation: DetailOperation;
  model: CatalogModel;
}

const { locale, operation, model } = Astro.props;
const dictionary = getDictionary(locale);
const t = dictionary.catalog;
const FORM_ID = "catalog-filters";

const total = model.entries.length;
const countText = total === 1 ? t.countOne : formatMessage(t.countOther, { count: total });
const sortOptions = CATALOG_SORTS.map((sort) => ({
  value: SORT_PARAM_VALUES[sort],
  label: t.sort[sort],
}));
---

<div
  data-catalog
  data-view="list"
  data-count-one={t.countOne}
  data-count-other={t.countOther}
  data-cluster-label={t.clusterLabel}
  data-approximate-label={t.approximateSuffix}
  class="group/catalog"
>
  <section class="surface-dark relative isolate flex min-h-[calc(min(62svh,560px)-5.75rem)] items-end overflow-hidden bg-canvas">
    <Picture
      {...PHOTO_PICTURE}
      src={headPhoto}
      alt=""
      widths={[640, 900, 1672]}
      sizes="100vw"
      priority
      class="absolute inset-0 -z-20 size-full object-cover object-[50%_45%]"
    />
    <span
      aria-hidden="true"
      class="absolute inset-0 -z-10 bg-linear-to-r from-ink/60 via-ink/25 via-45% to-transparent to-70%"
    ></span>
    <span
      aria-hidden="true"
      class="absolute inset-0 -z-10 bg-linear-to-b from-ink/50 via-ink/10 via-30% to-ink/60"
    ></span>
    <Container class="pt-9 pb-9 md:pb-12">
      <slot />
      <CatalogFilters
        locale={locale}
        operation={operation}
        options={model.options}
        formId={FORM_ID}
      />
    </Container>
    <MediaCredit tone="onImage" class="absolute right-4 bottom-3">
      {dictionary.media.conceptualImage}
    </MediaCredit>
  </section>

  <Container class="pt-8.5 pb-17.5">
    <div
      data-catalog-results
      class="mb-5.5 flex scroll-mt-24 flex-wrap items-center gap-x-4.5 gap-y-3 border-b border-line py-4"
    >
      <p
        data-catalog-count
        aria-live="polite"
        class="mr-auto font-heading text-[1.375rem] leading-[1.2]"
      >
        {countText}
      </p>
      <button
        type="button"
        data-catalog-clear-area
        hidden
        class="inline-flex cursor-pointer items-center gap-2 border border-accent px-3 py-2 text-[0.625rem] font-medium text-accent"
      >
        {t.areaChip} <span aria-hidden="true">✕</span>
      </button>
      <label for="catalog-sort" class="sr-only">
        {t.sortLabel}
      </label>
      <Select
        id="catalog-sort"
        name={CATALOG_PARAMS.sort}
        form={FORM_ID}
        variant="toolbar"
        options={sortOptions}
        value={SORT_PARAM_VALUES.recent}
      />
      <div role="group" aria-label={t.viewLabel} class="flex">
        {CATALOG_VIEWS.map((view) => (
          <button
            type="button"
            data-catalog-view={view}
            aria-pressed={view === "list" ? "true" : "false"}
            class:list={[
              "-ml-px cursor-pointer border border-taupe px-3.5 py-2.75 text-xs font-medium tracking-[0.08em] text-fg uppercase first:ml-0 aria-pressed:border-fg aria-pressed:bg-fg aria-pressed:text-canvas",
              view === "split" && "max-[899px]:hidden",
            ]}
          >
            {t.views[view]}
          </button>
        ))}
      </div>
    </div>

    <div class="grid gap-5.5 pb-17.5 min-[900px]:group-data-[view=split]/catalog:grid-cols-[minmax(0,1fr)_minmax(0,1.08fr)] min-[900px]:group-data-[view=split]/catalog:gap-6.5">
      <div class="group-data-[view=map]/catalog:hidden">
        {total === 0 ? (
          <p class="border-l-2 border-accent py-1 pl-3 text-sm text-muted">{t.emptyCatalog}</p>
        ) : (
          <ul
            data-catalog-list
            class="grid gap-7 min-[700px]:grid-cols-2 min-[900px]:group-data-[view=split]/catalog:grid-cols-1 min-[1200px]:gap-8.5 min-[1500px]:group-data-[view=split]/catalog:grid-cols-2 min-[1500px]:group-data-[view=split]/catalog:gap-5"
          >
            {model.properties.map((property) => (
              <li data-catalog-ref={property.ref} class="flex">
                <PropertyCard
                  property={property}
                  locale={locale}
                  ctaLabel={t.cardCta}
                  operation={operation}
                  variant="catalog"
                />
              </li>
            ))}
          </ul>
        )}
        <div
          data-catalog-empty
          hidden
          class="flex flex-col items-center gap-3 border border-dashed border-taupe px-6 py-11 text-center text-muted"
        >
          <p>{t.empty}</p>
          <p>{t.emptyHint}</p>
          <div class="mt-2 flex flex-wrap justify-center gap-3 text-fg">
            <span data-catalog-clear class="contents">
              <Button type="button">{t.clear}</Button>
            </span>
            <Button href={getLocalizedPath("mySearch", locale)}>{t.mySearch}</Button>
          </div>
        </div>
      </div>

      <div class="hidden self-start group-data-[view=map]/catalog:block group-data-[view=split]/catalog:block min-[900px]:group-data-[view=split]/catalog:sticky min-[900px]:group-data-[view=split]/catalog:top-[calc(5.75rem+12px)]">
        <div class="relative isolate border border-line">
          <div
            data-catalog-map
            role="region"
            aria-label={t.mapLabel}
            class="catalog-map relative z-0 h-[68svh] min-h-105 bg-bg-deep group-data-[view=map]/catalog:h-[min(78svh,760px)] min-[900px]:group-data-[view=split]/catalog:h-[calc(100svh-5.75rem-30px)]"
          >
            <p class="grid h-full place-items-center p-6 text-center text-sm text-muted">
              {t.mapLoading}
            </p>
          </div>
          <button
            type="button"
            data-catalog-search-area
            hidden
            class="surface-dark absolute top-3.5 left-1/2 z-500 -translate-x-1/2 cursor-pointer border border-accent bg-ink px-4 py-2.5 text-[0.625rem] font-medium tracking-[0.06em] text-fg"
          >
            {t.searchArea}
          </button>
          <p class="pointer-events-none absolute bottom-6 left-2.5 z-500 flex items-center gap-1.75 bg-glass px-3 py-2 text-[0.625rem] text-fg">
            <span
              aria-hidden="true"
              class="catalog-legend-area inline-block size-3 rounded-full"
            ></span>
            {t.mapApproximate}
          </p>
        </div>
      </div>
    </div>
    <p class="my-3.5 max-w-[68ch] border-l-2 border-accent py-1 pl-3 text-[0.6875rem] text-muted">
      {t.mapNote}
    </p>
  </Container>

  <script
    is:inline
    type="application/json"
    data-catalog-entries
    set:html={serializeJsonForScript(model.entries)}
  />
</div>

<script>
  import "./catalog.client";
</script>
