---
import type { HomeContent } from "@/features/agency/application/homeContent";
import type { Property } from "@/features/properties/domain/property";
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import Button from "@/shared/ui/atoms/Button.astro";
import SectionHeading from "@/shared/ui/molecules/SectionHeading.astro";
import Section from "@/shared/ui/molecules/Section.astro";
import PropertyGrid from "./PropertyGrid.astro";

/** Featured properties: real Mobilia listings (`portadaWeb`, else latest). */
interface Props {
  locale: Locale;
  properties: readonly Property[];
  content: HomeContent["featured"];
}

const { locale, properties, content } = Astro.props;
const copy = getDictionary(locale).home.featured;
---

<Section id="propiedades" labelledBy="featured-heading" name="featured" surface="stone">
  <SectionHeading
    id="featured-heading"
    heading={content.heading}
    class="mb-[clamp(1.25rem,2.4vw,2rem)]"
  />
  {properties.length > 0 ? (
    <PropertyGrid locale={locale} properties={properties} ctaLabel={copy.cardCta} />
  ) : (
    <p class="border-l-2 border-accent py-1 pl-3 text-sm text-muted">{copy.empty}</p>
  )}
  <div class="mt-10.5 flex justify-center">
    <Button href={getLocalizedPath("sale", locale)} variant="solid" size="lg" arrow>
      {content.ctaLabel}
    </Button>
  </div>
</Section>
