---
import { Picture } from "astro:assets";
import { PHOTO_PICTURE } from "@/shared/lib/images";

/**
 * One way to ask for a valuation (reference `.vz-row`): photo, kicker, title, line, action and a
 * round arrow. A link (blog block) or, with `popoverTarget`, a button that opens a pop-up. `facts`
 * adds the three-point list of the reference's valuation page and widens the row to four columns.
 */
interface Props {
  photo: ImageMetadata;
  alt: string;
  tag: string;
  title: string;
  text: string;
  cta: string;
  /** Dark variant (the advisor option). */
  dark?: boolean;
  /** Background of the light row: `card` on a stone block (blog), `stone` on paper (reference `.vz-row`). */
  tone?: "card" | "stone";
  /** `home`: the home block's wider photo column and larger title (reference `.vz-row` at 1440). */
  size?: "compact" | "home";
  facts?: readonly string[] | undefined;
  href?: string | undefined;
  /** Id of the pop-up this row opens (renders a button instead of a link). */
  popoverTarget?: string | undefined;
}

const {
  photo,
  alt,
  tag,
  title,
  text,
  cta,
  dark = false,
  tone = "card",
  size = "compact",
  facts,
  href,
  popoverTarget,
} = Astro.props;
const Row = popoverTarget === undefined ? "a" : "button";
const withFacts = facts !== undefined;
const home = size === "home";
---

<Row
  href={popoverTarget === undefined ? href : undefined}
  type={popoverTarget === undefined ? undefined : "button"}
  popovertarget={popoverTarget}
  class:list={[
    "group grid w-full grid-cols-[7.5rem_minmax(0,1fr)] items-stretch gap-3.5 rounded-2xl p-1.5 pr-3.5 text-left text-fg no-underline",
    "min-[600px]:pr-[clamp(1rem,1.9vw,1.625rem)]",
    !home &&
      "min-[600px]:grid-cols-[clamp(8.75rem,12.4vw,11rem)_minmax(0,1fr)_auto] min-[600px]:gap-[clamp(0.875rem,1.6vw,1.375rem)]",
    withFacts &&
      "gap-4 max-[899px]:[&>[data-facts]]:col-span-full min-[600px]:max-[899px]:grid-cols-[12.5rem_minmax(0,1fr)_auto] min-[600px]:max-[899px]:gap-[clamp(1rem,1.8vw,1.625rem)] min-[900px]:grid-cols-[clamp(11.875rem,17vw,14.75rem)_minmax(0,1.25fr)_minmax(0,0.85fr)_auto] min-[900px]:gap-[clamp(1.125rem,2.2vw,2.125rem)]",
    home &&
      "gap-4 min-[600px]:grid-cols-[12.5rem_minmax(0,1fr)_auto] min-[600px]:gap-[clamp(1rem,1.8vw,1.625rem)] min-[900px]:grid-cols-[clamp(10.625rem,16vw,14.25rem)_minmax(0,1fr)_auto]",
    "cursor-pointer transition-[translate,box-shadow] duration-450 ease-brand hover:-translate-y-0.75 hover:shadow-[0_14px_30px_-18px_rgb(22_43_42/0.55)] focus-visible:-translate-y-0.75",
    dark ? "surface-dark bg-canvas" : tone === "stone" ? "bg-stone" : "bg-card",
  ]}
>
  <span
    class:list={[
      "block min-h-37.5 overflow-hidden rounded-[11px] bg-stone",
      withFacts
        ? "min-[600px]:min-h-42.5 min-[900px]:min-h-[clamp(10.625rem,24vh,13.375rem)]"
        : "min-[600px]:min-h-[clamp(10.625rem,14.4vw,12.875rem)]",
      home && "min-[600px]:min-h-42.5",
    ]}
  >
    <Picture
      {...PHOTO_PICTURE}
      src={photo}
      alt={alt}
      widths={[240, 480]}
      sizes="(min-width: 900px) 15rem, 30vw"
      class="size-full object-cover transition-transform duration-900 ease-brand group-hover:scale-105"
    />
  </span>
  <span class="block self-center py-1.5 max-[599px]:py-2">
    <span
      class:list={[
        "mb-1.5 block text-[0.65625rem] leading-[1.4] font-semibold tracking-[0.18em]",
        /* accent is 4.3:1 on stone: petrol keeps the small kicker AA there */
        !dark && tone === "stone" ? "text-petrol" : "text-accent",
      ]}
    >
      {tag}
    </span>
    <span
      class:list={[
        "block leading-[1.15] font-extrabold text-fg",
        withFacts && "text-[clamp(1.125rem,1.65vw,1.6875rem)]",
        home && "text-[clamp(1.125rem,1.65vw,1.5rem)] tracking-[0.03em]",
        !withFacts && !home && "text-[1.1875rem]",
      ]}
    >
      {title}
    </span>
    <span
      class:list={[
        "mt-2.25 block text-[0.84375rem] leading-[1.55] tracking-[0.03em] normal-case",
        withFacts && "min-[900px]:max-w-[52ch]",
        dark ? "text-fg-2" : "text-mid",
      ]}
    >
      {text}
    </span>
    <span class="mt-3.25 inline-block bg-[linear-gradient(currentColor,currentColor)] bg-[length:100%_1px] bg-bottom bg-no-repeat pb-1 text-[0.71875rem] leading-[1.4] font-bold tracking-[0.14em] text-fg">
      {cta}
    </span>
  </span>
  {withFacts && (
    <span data-facts class="block self-center max-[899px]:px-2 max-[899px]:pb-2">
      {facts.map((fact) => (
        <span class="relative block border-t border-fg/16 py-2 pl-4 text-[0.71875rem] leading-[1.45] font-semibold tracking-[0.07em] text-fg before:absolute before:top-[1.25em] before:left-0 before:h-0.5 before:w-2 before:bg-accent before:content-['']">
          {fact}
        </span>
      ))}
    </span>
  )}
  <span
    aria-hidden="true"
    class:list={[
      "hidden size-12.5 place-items-center self-center rounded-full transition-transform duration-350 group-hover:rotate-45 min-[600px]:grid",
      dark ? "bg-turquoise text-ink" : "bg-dark text-paper",
    ]}
  >
    <svg
      viewBox="0 0 12 12"
      focusable="false"
      class="size-3.5 fill-none stroke-current stroke-[1.4]"
    >
      <path d="M2 10 10 2M3.5 2H10v6.5"></path>
    </svg>
  </span>
</Row>
