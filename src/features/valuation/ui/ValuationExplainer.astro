---
import advisorPhoto from "@/assets/valoracion/asesor-960.webp";
import onlinePhoto from "@/assets/valoracion/online-960.webp";
import type { HomeContent } from "@/features/agency/application/homeContent";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import Container from "@/shared/ui/atoms/Container.astro";
import Emphasis from "@/shared/ui/atoms/Emphasis.astro";
import ValuationOption from "./ValuationOption.astro";

/**
 * Home valuation block (reference `.vz6`): the question on the left, the two ways to value on the
 * right (online and with an advisor). The valuation itself is an external iframe on the valuation
 * page: this site never computes figures (AGENTS.md §6 item 12).
 */
interface Props {
  locale: Locale;
  content: HomeContent["valuation"];
}

const { locale, content } = Astro.props;
---

<section
  id="valoracion"
  aria-labelledby="valuation-heading"
  data-section="valuation"
  class="defer-render bg-canvas py-[clamp(2.75rem,7.4vh,4.5rem)]"
>
  <Container class="grid items-center gap-6 min-[900px]:grid-cols-[auto_minmax(0,1fr)] min-[900px]:gap-[clamp(1.75rem,3.6vw,3.125rem)]">
    <div data-reveal>
      <p class="mb-[clamp(0.75rem,1.3vw,1.125rem)] text-[0.6875rem] leading-[1.4] font-semibold tracking-[0.16em] text-accent">
        {content.kicker}
      </p>
      <h2
        id="valuation-heading"
        class="text-[clamp(1.6875rem,3.05vw,2.75rem)] leading-[1.08] tracking-[0.02em] after:mt-[clamp(1.125rem,2vw,1.625rem)] after:mb-[clamp(1rem,1.8vw,1.375rem)] after:block after:h-0.5 after:w-14 after:bg-turquoise after:content-[''] max-[599px]:[&_em]:block min-[900px]:[&_em]:block"
      >
        <Emphasis text={content.heading} />
      </h2>
      <p class="text-[clamp(0.9375rem,1.12vw,1.03125rem)] leading-[1.55] tracking-[0.03em] text-fg-2 normal-case">
        {content.lead}
      </p>
    </div>
    <div class="grid auto-rows-fr gap-3">
      <ValuationOption
        photo={onlinePhoto}
        alt=""
        tag={content.online.tag}
        title={content.online.title}
        text={content.online.text}
        cta={content.online.action}
        href={getLocalizedPath("valuation", locale)}
        tone="stone"
        size="home"
      />
      <ValuationOption
        photo={advisorPhoto}
        alt=""
        tag={content.advisor.tag}
        title={content.advisor.title}
        text={content.advisor.text}
        cta={content.advisor.action}
        href={getLocalizedPath("contact", locale)}
        size="home"
        dark
      />
    </div>
  </Container>
</section>
