---
import { Picture } from "astro:assets";
import type { HomeContent } from "@/features/agency/application/homeContent";
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import { PHOTO_PICTURE } from "@/shared/lib/images";
import Button from "@/shared/ui/atoms/Button.astro";
import MediaCredit from "@/shared/ui/atoms/MediaCredit.astro";
import SectionHeading from "@/shared/ui/molecules/SectionHeading.astro";
import Section from "@/shared/ui/molecules/Section.astro";

/**
 * Valuation banner over a full-bleed photo. The valuation itself is an external iframe on the
 * valuation page: this site never computes figures (AGENTS.md §6 item 12).
 */
interface Props {
  locale: Locale;
  content: HomeContent["valuation"];
}

const { locale, content } = Astro.props;
const copy = getDictionary(locale).home.valuation;
---

<Section
  id="valoracion"
  labelledBy="valuation-heading"
  name="valuation"
  spacing="spacious"
  surface="dark"
  class="grid min-h-[clamp(27.5rem,50vw,38.75rem)] items-center overflow-hidden"
>
  <figure slot="background" class="absolute inset-0 -z-10 m-0">
    <Picture
      {...PHOTO_PICTURE}
      src={content.image}
      alt={content.imageAlt}
      widths={[800, 1400]}
      sizes="100vw"
      class="size-full object-cover"
    />
    <span
      aria-hidden="true"
      class="absolute inset-0 bg-linear-to-b from-ink/35 to-ink/80 md:bg-linear-to-r md:from-ink/80 md:via-ink/50 md:to-ink/10"
    ></span>
    <figcaption class="absolute right-4 bottom-2.5">
      <MediaCredit tone="onImage">{copy.caption}</MediaCredit>
    </figcaption>
  </figure>
  <SectionHeading id="valuation-heading" heading={content.heading} size="lg" class="max-w-[13em]" />
  <p
    data-reveal
    class="mt-4 mb-[clamp(1.625rem,3vw,2.375rem)] max-w-[34ch] text-[clamp(1rem,1.3vw,1.25rem)] leading-normal text-fg/90"
  >
    {content.lead}
  </p>
  <div data-reveal>
    <Button href={getLocalizedPath("valuation", locale)} variant="solid" size="lg" arrow>
      {content.ctaLabel}
    </Button>
  </div>
</Section>
