---
import type { ImageMetadata } from "astro";
import financial from "@/assets/home/services/financial.webp";
import legalTax from "@/assets/home/services/legal-tax.webp";
import advisory from "@/assets/home/services/advisory.webp";
import investment from "@/assets/home/services/investment.webp";
import personalShopper from "@/assets/home/services/personal-shopper.webp";
import renovations from "@/assets/home/services/renovations.webp";
import rental from "@/assets/home/services/rental.webp";
import sale from "@/assets/home/services/sale.webp";
import valuation from "@/assets/home/services/valuation.webp";
import type { HomeContent } from "@/features/agency/application/homeContent";
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import { getServiceSlug, type ServiceKey } from "@/shared/i18n/services";
import Button from "@/shared/ui/atoms/Button.astro";
import Container from "@/shared/ui/atoms/Container.astro";
import SectionHeading from "@/shared/ui/molecules/SectionHeading.astro";
import AccordionRail from "@/shared/ui/organisms/AccordionRail.astro";

/** Services accordion and the collaborators block of the home (proposal v3). */
interface Props {
  locale: Locale;
  content: HomeContent["services"];
  collaborators: HomeContent["collaborators"];
}

const { locale, content, collaborators } = Astro.props;
const t = getDictionary(locale);

const PANELS: readonly { readonly service: ServiceKey; readonly image: ImageMetadata }[] = [
  { service: "saleBrokerage", image: sale },
  { service: "valuation", image: valuation },
  { service: "legalTax", image: legalTax },
  { service: "renovations", image: renovations },
  { service: "advisory", image: advisory },
  { service: "financial", image: financial },
  { service: "personalShopper", image: personalShopper },
  { service: "investment", image: investment },
  { service: "rentalManagement", image: rental },
];
const panels = PANELS.map((panel, index) => ({
  number: String(index + 1).padStart(2, "0"),
  title: t.serviceNames[panel.service],
  href: getLocalizedPath("serviceDetail", locale, {
    service: getServiceSlug(panel.service, locale),
  }),
  image: panel.image,
}));
---

<section
  id="servicios"
  aria-labelledby="services-heading"
  data-section="services"
  class="surface-stone overflow-hidden bg-canvas py-[clamp(2.75rem,5vw,4.125rem)]"
>
  <Container>
    <SectionHeading
      id="services-heading"
      heading={content.heading}
      class="mb-[clamp(1.5rem,3vw,2.5rem)]"
    />
    <AccordionRail label={t.home.services.regionLabel} panels={panels} />

    <div
      data-reveal
      class="mt-[clamp(1.625rem,3vw,2.5rem)] grid justify-items-center gap-4 text-center"
    >
      <p class="max-w-[26ch] text-[clamp(1rem,1.7vw,1.375rem)] leading-tight font-medium text-balance text-fg">
        {collaborators.text}
      </p>
      <Button href={getLocalizedPath("about", locale)} arrow>
        {collaborators.ctaLabel}
      </Button>
    </div>
  </Container>
</section>
