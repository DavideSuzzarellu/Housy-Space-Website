---
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import Button from "@/shared/ui/atoms/Button.astro";
import Container from "@/shared/ui/atoms/Container.astro";

/**
 * "In figures" timeline of the about page (reference `np6-ruta`): years of experience, years of
 * HousySpace with the figures since opening in a chamfered panel, and "today". The entries come
 * from the content file (`title` = figure, `kicker` = unit, `text` = caption); the figures of the
 * panel are dictionary text, shown rounded with a "+" (AGENTS.md §11.5).
 */
interface Props {
  locale: Locale;
  label: string;
  entries: readonly {
    readonly title: string;
    readonly kicker?: string | undefined;
    readonly text: string;
  }[];
}

const { locale, label, entries } = Astro.props;
const stats = getDictionary(locale).about.stats;
const FIGURES = [stats.volume, stats.properties, stats.rentals] as const;
const LABEL = "text-[0.6875rem] leading-[1.4] font-bold tracking-[0.24em] text-accent";
const CAPTION =
  "text-[clamp(0.8125rem,1.02vw,0.90625rem)] leading-[1.55] tracking-[0.005em] text-fg normal-case";
---

<section id="experiencia" class="bg-white pb-[clamp(2.375rem,6.2vh,3.625rem)] normal-case">
  <Container width="editorial">
    <h3 class:list={["mb-[clamp(0.875rem,1.8vw,1.375rem)] uppercase", LABEL]}>{label}</h3>
    <ol class="grid [--dot:14px] [--nh:clamp(2.25rem,4.2vw,3.75rem)]">
      {entries.map((entry, i) => {
        const last = i === entries.length - 1;
        return (
          <li
            class:list={[
              "relative min-w-0 pl-[clamp(2rem,3.2vw,3.125rem)]",
              !last &&
                "pb-[clamp(1.625rem,3vw,2.75rem)] min-[900px]:pb-[clamp(0.75rem,3vh,2.5rem)]",
              "before:absolute before:top-[calc(var(--nh)/2-var(--dot)/2)] before:left-0 before:size-[var(--dot)] before:rounded-full before:bg-canvas before:shadow-[inset_0_0_0_2px_var(--color-fg)] before:content-['']",
              last && "before:bg-accent before:shadow-[inset_0_0_0_2px_var(--color-accent)]",
              !last &&
                "after:absolute after:top-[calc(var(--nh)/2)] after:-bottom-[calc(var(--nh)/2)] after:left-[calc(var(--dot)/2-0.5px)] after:w-px after:bg-turquoise/60 after:content-['']",
            ]}
          >
            <div class="flex flex-wrap items-baseline gap-x-[clamp(1rem,2vw,1.75rem)] gap-y-1.5">
              <div class="flex flex-none items-baseline gap-2.5">
                <b
                  class:list={[
                    "block text-[length:var(--nh)] leading-none font-extrabold tracking-[-0.03em] tabular-nums uppercase",
                    last ? "text-accent" : "text-fg",
                  ]}
                >
                  {entry.title}
                </b>
                {entry.kicker !== undefined && (
                  <span class="text-[clamp(0.65625rem,0.85vw,0.78125rem)] font-bold tracking-[0.22em] text-taupe-tx uppercase">
                    {entry.kicker}
                  </span>
                )}
              </div>
              <p class={["max-w-[40ch]", CAPTION].join(" ")}>{entry.text}</p>
            </div>
            {i === 1 && (
              <div class="cut-line mt-[clamp(0.875rem,1.6vw,1.375rem)] px-[clamp(1.125rem,2.4vw,2.125rem)] py-[clamp(1.125rem,2.2vw,1.875rem)] [--cut:16px]">
                <p class:list={["mb-[clamp(0.75rem,1.4vw,1.125rem)] uppercase", LABEL]}>
                  {stats.sinceOpening}
                </p>
                <ul
                  class="grid gap-x-[clamp(1rem,2.4vw,2.25rem)] gap-y-[clamp(0.875rem,2vw,1.75rem)] min-[700px]:grid-cols-3"
                  role="list"
                >
                  {FIGURES.map((figure) => (
                    <li class="min-w-0">
                      <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-0.5">
                        <b class="text-[clamp(2rem,3.6vw,3.25rem)] leading-none font-extrabold tracking-[-0.03em] text-accent tabular-nums">
                          {figure.value}
                        </b>
                        <span class="text-[clamp(0.65625rem,0.85vw,0.78125rem)] font-bold tracking-[0.22em] text-taupe-tx uppercase">
                          {figure.unit}
                        </span>
                      </div>
                      <p class={["mt-1.5 max-w-[26ch]", CAPTION].join(" ")}>{figure.label}</p>
                    </li>
                  ))}
                </ul>
                <div class="mt-[clamp(1rem,2vw,1.625rem)] flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-turquoise/60 pt-[clamp(0.875rem,1.6vw,1.25rem)]">
                  <p class={["max-w-[46ch]", CAPTION].join(" ")}>{stats.operationsNote}</p>
                  <Button
                    href={getLocalizedPath("sale", locale)}
                    variant="solid"
                    arrow
                    class="leading-[1.2] py-[0.9375rem]! max-[699px]:w-full"
                  >
                    {stats.cta}
                  </Button>
                </div>
              </div>
            )}
          </li>
        );
      })}
    </ol>
  </Container>
</section>
