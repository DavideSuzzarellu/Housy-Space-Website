---
import type { ImageMetadata } from "astro";
import chimenea from "@/assets/home/det-chimenea-720.jpg";
import cielo from "@/assets/home/det-cielo-1400.jpg";
import hierro from "@/assets/home/det-hierro-720.jpg";
import salon from "@/assets/home/det-salon-1400.jpg";
import ventanal from "@/assets/home/det-ventanal-720.jpg";
import facade from "@/assets/home/facade-1400.jpg";
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import { getServiceSlug, type ServiceKey } from "@/shared/i18n/services";
import { formatMessage } from "@/shared/lib/format";
import Button from "@/shared/ui/atoms/Button.astro";
import SectionHeading from "@/shared/ui/molecules/SectionHeading.astro";
import Section from "@/shared/ui/molecules/Section.astro";
import ServiceCard from "./ServiceCard.astro";

/** 02 Services: six featured services as an editorial mosaic. */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const copy = t.home.services;

type HomeService = Exclude<ServiceKey, "investment" | "valuation">;

const CARDS: readonly {
  readonly service: HomeService;
  readonly image: ImageMetadata;
  readonly size: "xl" | "l" | "m" | "wide";
}[] = [
  { service: "saleBrokerage", image: facade, size: "xl" },
  { service: "rentalManagement", image: salon, size: "l" },
  { service: "personalShopper", image: hierro, size: "m" },
  { service: "renovations", image: ventanal, size: "m" },
  { service: "interiorDesign", image: chimenea, size: "m" },
  { service: "advisory", image: cielo, size: "wide" },
];
---

<Section id="servicios" labelledBy="services-heading" name="services">
  <div class="mb-10 flex flex-wrap items-end justify-between gap-x-10 gap-y-5">
    <SectionHeading id="services-heading" number="02" tag={copy.eyebrow} heading={copy.heading} />
    <p data-reveal class="m-0 max-w-[44ch] text-lg text-fg/85">
      {copy.lead}
    </p>
  </div>
  <div class="grid gap-4.5 md:grid-cols-6 lg:grid-cols-12 lg:gap-5.5">
    {CARDS.map((card, index) => {
      const name = t.serviceNames[card.service];
      return (
        <ServiceCard
          href={getLocalizedPath("serviceDetail", locale, {
            service: getServiceSlug(card.service, locale),
          })}
          number={String(index + 1).padStart(2, "0")}
          name={name}
          summary={copy.summaries[card.service]}
          ctaLabel={copy.cardCta}
          image={card.image}
          imageAlt={formatMessage(t.media.conceptualImageAlt, { subject: name })}
          size={card.size}
          revealDelay={(index % 3) * 0.08}
        />
      );
    })}
  </div>
  <div class="mt-8.5">
    <Button href={getLocalizedPath("services", locale)}>{copy.allServices}</Button>
  </div>
</Section>
