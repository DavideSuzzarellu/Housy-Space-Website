---
import type { ImageMetadata, ImageOutputFormat } from "astro";
import { getImage } from "astro:assets";
import posterLandscape from "@/assets/home/hero-poster.jpg";
import posterPortrait from "@/assets/home/hero-poster-v.jpg";
import type { HomeContent } from "@/features/agency/application/homeContent";
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import Button from "@/shared/ui/atoms/Button.astro";

/**
 * Hero (reference `.hero3`): full-viewport video with the page H1, a two-line claim and the two
 * main CTAs bottom-left over a dark gradient; the scroll cue sits bottom-right.
 */
interface Props {
  locale: Locale;
  content: HomeContent["hero"];
  /** Id of the section the scroll cue jumps to. */
  nextSectionId: string;
}

const { locale, content, nextSectionId } = Astro.props;
const t = getDictionary(locale);

const PORTRAIT_MEDIA = "(max-aspect-ratio: 4/5)";
const LANDSCAPE_MEDIA = "(min-aspect-ratio: 4/5)";
const LANDSCAPE_SMALL_MEDIA = `${LANDSCAPE_MEDIA} and (max-width: 1440px)`;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

/** The poster is the LCP image: AVIF first, WebP fallback, one width per viewport and density. */
async function posterSet(src: ImageMetadata, widths: number[], format: ImageOutputFormat) {
  const image = await getImage({ src, format, widths });
  return { src: image.src, srcset: image.srcSet.attribute };
}

const LANDSCAPE_WIDTHS = [960, 1440, 1920];
const PORTRAIT_WIDTHS = [480, 608];
const [landscapeAvif, landscapeWebp, portraitAvif, portraitWebp] = await Promise.all([
  posterSet(posterLandscape, LANDSCAPE_WIDTHS, "avif"),
  posterSet(posterLandscape, LANDSCAPE_WIDTHS, "webp"),
  posterSet(posterPortrait, PORTRAIT_WIDTHS, "avif"),
  posterSet(posterPortrait, PORTRAIT_WIDTHS, "webp"),
]);
---

<section
  id="hero"
  aria-labelledby="home-hero-heading"
  data-hero
  class="group surface-dark relative h-svh min-h-120 overflow-hidden bg-canvas md:min-h-130"
>
  <!-- Poster = frame 0 of the video, pixel for pixel (the only eager image of the page; never animated, so the swap is invisible) -->
  <picture class="absolute inset-0">
    <source media={PORTRAIT_MEDIA} type="image/avif" srcset={portraitAvif.srcset} sizes="100vw" />
    <source media={PORTRAIT_MEDIA} type="image/webp" srcset={portraitWebp.srcset} sizes="100vw" />
    <source type="image/avif" srcset={landscapeAvif.srcset} sizes="100vw" />
    <img
      src={landscapeWebp.src}
      srcset={landscapeWebp.srcset}
      sizes="100vw"
      width={posterLandscape.width}
      height={posterLandscape.height}
      alt=""
      fetchpriority="high"
      decoding="async"
      class="size-full object-cover"
    />
  </picture>

  <!--
    Video: starts after the page has loaded and the browser is idle; skipped on reduced motion,
    Save-Data and 2G. Same cut as hero-corto.*, re-encoded smaller (no audio): 1280 px up to
    1440 px wide, 1920 px above, 540 px for portrait screens. WebM first, MP4 fallback.
  -->
  <video
    data-hero-video
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-[600ms] ease-in-out group-data-playing:opacity-100"
  >
    <source
      src={`${base}/media/hero/hero-corto-1280.webm`}
      type="video/webm"
      media={LANDSCAPE_SMALL_MEDIA}
    />
    <source
      src={`${base}/media/hero/hero-corto-1280.mp4`}
      type="video/mp4"
      media={LANDSCAPE_SMALL_MEDIA}
    />
    <source
      src={`${base}/media/hero/hero-corto-1920.webm`}
      type="video/webm"
      media={LANDSCAPE_MEDIA}
    />
    <source
      src={`${base}/media/hero/hero-corto-1920.mp4`}
      type="video/mp4"
      media={LANDSCAPE_MEDIA}
    />
    <source src={`${base}/media/hero/hero-corto-v-540.webm`} type="video/webm" />
    <source src={`${base}/media/hero/hero-corto-v-540.mp4`} type="video/mp4" />
  </video>

  <!-- Gradient shade: darker at the top for the header, a clean cut at the bottom -->
  <div aria-hidden="true" class="hero-shade pointer-events-none absolute inset-0"></div>

  <!-- Text block: heading, claim and CTAs over a gradient that darkens towards the bottom -->
  <div class="hero-text pointer-events-none absolute inset-x-0 bottom-0 z-2 pb-[calc(74px+env(safe-area-inset-bottom,0px))] min-[760px]:pb-[clamp(4.5rem,10vh,7rem)]">
    <div class="pointer-events-auto px-5.5 min-[760px]:pl-[clamp(1.5rem,4.5vw,4.5rem)]">
      <h1
        id="home-hero-heading"
        class="mb-[clamp(0.75rem,1.8vh,1.125rem)] text-[clamp(1.6875rem,7.6vw,2.125rem)] leading-[1.05] font-extrabold tracking-[0.03em] text-paper min-[760px]:text-[clamp(1.875rem,4.2vw,3.75rem)]"
      >
        <span class="block">{content.headingFirst}</span>
        <span class="block font-normal">{content.headingSecond}</span>
      </h1>
      <p class="mb-[clamp(1.5rem,3.4vh,2.375rem)] text-[clamp(0.875rem,1.5vw,1.3125rem)] leading-normal tracking-[0.02em] text-paper/92 min-[900px]:whitespace-nowrap">
        <span class="block font-bold min-[900px]:inline">{content.subFirst}</span>{" "}
        <span class="block min-[900px]:inline">{content.subSecond}</span>
      </p>
      <div class="flex flex-wrap gap-3 max-[759px]:gap-2">
        <Button href={getLocalizedPath("valuation", locale)} variant="heroSolid" size="hero" arrow>
          {content.primaryCta}
        </Button>
        <Button href={getLocalizedPath("about", locale)} variant="heroGhost" size="hero" arrow>
          {content.ctaLabel}
        </Button>
      </div>
    </div>
  </div>

  <!-- Scroll cue: hairline with an accent segment sliding down it -->
  <a
    href={`#${nextSectionId}`}
    aria-label={t.a11y.scrollDown}
    class="absolute right-[clamp(1.375rem,4.5vw,4.5rem)] bottom-5.5 z-2 hidden h-13.5 w-7 min-[760px]:block"
  >
    <span class="absolute top-0 left-3.25 h-13.5 w-px overflow-hidden bg-fg/30">
      <span class="animate-scroll-cue absolute -top-4 left-0 h-4 w-px bg-turquoise motion-reduce:animate-none"></span>
    </span>
  </a>
</section>

<style>
  .hero-text::before {
    content: "";
    position: absolute;
    inset: -34vh 0 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--color-ink) 50%, transparent) 46%,
      color-mix(in srgb, var(--color-ink) 82%, transparent) 100%
    );
  }
  .hero-shade {
    --shade: var(--color-ink);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--shade) 50%, transparent) 0%,
      color-mix(in srgb, var(--shade) 8%, transparent) 26%,
      transparent 55%,
      color-mix(in srgb, var(--shade) 25%, transparent) 100%
    );
    mask-image: linear-gradient(180deg, #000 70%, transparent 100%);
  }
</style>

<script>
  import { afterPaintedFrames } from "./heroReveal";

  const PAINTED_FRAMES = 4;

  interface NetworkInformation {
    saveData?: boolean;
    effectiveType?: string;
  }
  const connection = (navigator as Navigator & { connection?: NetworkInformation }).connection;
  // Save-Data or a 2G link: keep the poster, never download megabytes of video.
  const SAVE_DATA =
    connection?.saveData === true || /(^|-)2g$/.test(connection?.effectiveType ?? "");

  let observer: IntersectionObserver | undefined;
  let active: { hero: HTMLElement; video: HTMLVideoElement } | undefined;
  let visible = true;

  /** Plays only while the hero is on screen and the tab is visible (saves battery and data). */
  function sync(): void {
    if (active === undefined) return;
    if (visible && !document.hidden) void active.video.play().catch(() => undefined);
    else active.video.pause();
  }

  /** After the `load` event, when the browser is idle: the video never competes with the LCP. */
  function whenIdle(callback: () => void): void {
    const schedule = (): void => {
      if (typeof window.requestIdleCallback === "function")
        window.requestIdleCallback(callback, { timeout: 300 });
      else window.setTimeout(callback, 200);
    };
    if (document.readyState === "complete") schedule();
    else window.addEventListener("load", schedule, { once: true });
  }

  function maybePlayVideo(): void {
    const hero = document.querySelector<HTMLElement>("[data-hero]");
    const video = hero?.querySelector<HTMLVideoElement>("[data-hero-video]");
    if (hero == null || video == null) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || SAVE_DATA) return;
    // Reveal only after real frames were painted, so poster and video are identical at the swap.
    video.addEventListener(
      "playing",
      () => afterPaintedFrames(video, PAINTED_FRAMES, () => hero.setAttribute("data-playing", "")),
      { once: true },
    );
    whenIdle(() => {
      // The visitor may already have navigated away.
      if (!hero.isConnected) return;
      active = { hero, video };
      // The first observer callback says whether the hero is on screen: nothing downloads before.
      visible = false;
      observer = new IntersectionObserver(
        (entries) => {
          visible = entries.some((entry) => entry.isIntersecting);
          sync();
        },
        { threshold: 0.02 },
      );
      observer.observe(hero);
    });
  }

  function stopVideo(): void {
    observer?.disconnect();
    active?.video.pause();
    active = undefined;
  }

  document.addEventListener("astro:page-load", maybePlayVideo);
  document.addEventListener("astro:before-preparation", stopVideo);
  document.addEventListener("visibilitychange", sync);
</script>
