---
import posterLandscape from "@/assets/home/hero-poster.jpg";
import posterPortrait from "@/assets/home/hero-poster-v.jpg";
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";

/**
 * Hero: full-viewport video only (no text overlay).
 * The heading lives in the HomePresentation section below (§11.1 reference structure).
 */
interface Props {
  locale: Locale;
  /** Id of the section the scroll cue jumps to. */
  nextSectionId: string;
}

const { locale, nextSectionId } = Astro.props;
const t = getDictionary(locale);

const PORTRAIT_MEDIA = "(max-aspect-ratio: 4/5)";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section
  id="hero"
  aria-label={t.home.hero.label}
  data-hero
  class="surface-dark relative h-svh min-h-120 overflow-hidden bg-canvas md:min-h-130"
>
  <!-- Poster (shown before video loads or on reduced motion / no-JS) -->
  <picture class="absolute inset-0">
    <source media={PORTRAIT_MEDIA} srcset={posterPortrait.src} type="image/jpeg" />
    <img
      src={posterLandscape.src}
      alt=""
      fetchpriority="high"
      decoding="async"
      class="size-full object-cover"
    />
  </picture>

  <!-- Video (loads after page ready, skipped on reduced motion / Save-Data) -->
  <video
    data-hero-video
    muted
    loop
    playsinline
    aria-hidden="true"
    class="absolute inset-0 hidden size-full object-cover"
  >
    <source src={`${base}/media/hero/hero-corto.webm`} type="video/webm" media="(min-aspect-ratio: 4/5)" />
    <source src={`${base}/media/hero/hero-corto.mp4`} type="video/mp4" media="(min-aspect-ratio: 4/5)" />
    <source src={`${base}/media/hero/hero-corto-v.webm`} type="video/webm" />
    <source src={`${base}/media/hero/hero-corto-v.mp4`} type="video/mp4" />
  </video>

  <!-- Gradient shade (bottom) -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-linear-to-b from-transparent via-transparent via-50% to-ink/70"
  ></div>

  <!-- Scroll cue -->
  <a
    href={`#${nextSectionId}`}
    aria-label={t.a11y.scrollDown}
    class="absolute bottom-14.5 left-1/2 z-2 -ml-3.5 h-13.5 w-7 md:bottom-5.5"
  >
    <span class="absolute inset-x-0 top-0 h-7 w-full rounded-full border border-white/40"></span>
    <span class="absolute top-2 left-1/2 h-2.5 w-px -translate-x-px animate-bounce bg-white/60"></span>
  </a>
</section>

<script>
  const SAVE_DATA =
    "connection" in navigator &&
    (navigator as unknown as { connection: { saveData: boolean } }).connection.saveData;

  function maybePlayVideo(): void {
    const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
    if (video === null) return;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced || SAVE_DATA) return;
    video.classList.remove("hidden");
    void video.play().catch(() => {
      /* autoplay blocked — poster stays visible */
    });
  }

  function stopVideo(): void {
    const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
    if (video === null) return;
    video.pause();
    video.classList.add("hidden");
  }

  document.addEventListener("astro:page-load", maybePlayVideo);
  document.addEventListener("astro:before-preparation", stopVideo);
</script>
