---
import type { PageContent, PageItem } from "@/features/pages/application/pages";
import { groupItems } from "@/features/pages/application/pages";
import PageItems from "@/features/pages/ui/PageItems.astro";
import type { Locale } from "@/shared/i18n/config";
import { resolveContentHref } from "@/shared/i18n/contentLinks";
import Container from "@/shared/ui/atoms/Container.astro";
import PaperHero from "@/shared/ui/organisms/PaperHero.astro";

/**
 * Contact page of the reference: oversize head, "choose how to talk to us" cards, the form
 * beside its intro, and the FAQ. The copy and links come from the editorial file
 * (`contact.{locale}.json`); the form itself is the shared LeadForm through PageItems.
 */
interface Props {
  locale: Locale;
  content: PageContent;
  crumbs: readonly { readonly label: string; readonly href?: string }[];
}

const { locale, content, crumbs } = Astro.props;

const kicker = content.head.items.find((item) => item.kind === "tag")?.text;
const subtitle = content.head.items.find((item) => item.kind === "lead")?.text;

const section = (id: string) => content.sections.find((s) => s.id === id);
const pick = <K extends PageItem["kind"]>(items: readonly PageItem[], kind: K) =>
  items.find((item): item is Extract<PageItem, { kind: K }> => item.kind === kind);

const formas = section("formas")?.items ?? [];
const formulario = section("formulario")?.items ?? [];
const preguntas = section("preguntas");

const buttons = pick(formas, "buttons");
const ICONS: Record<string, string> = {
  tel: "M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z",
  mailto: "M3 6h18v12H3zM3 7l9 6 9-6",
  chat: "M4 5h16v11H9l-5 4z",
  form: "M4 20h4L19 9l-4-4L4 16z",
};
const kindOf = (href: string) =>
  href.startsWith("tel:")
    ? "tel"
    : href.startsWith("mailto:")
      ? "mailto"
      : href.includes("wa.me")
        ? "chat"
        : "form";
const valueOf = (href: string) =>
  href.startsWith("tel:")
    ? href.slice(4).replace(/^\+34(\d{3})(\d{3})(\d{3})$/, "+34 $1 $2 $3")
    : href.startsWith("mailto:")
      ? href.slice(7)
      : "";
---

<div data-contact-view>
  <PaperHero
    locale={locale}
    title={content.head.heading}
    kicker={kicker}
    subtitle={subtitle}
    crumbs={crumbs}
    size="xl"
  />

  <section id="formas" class="surface-stone bg-canvas py-[clamp(2.75rem,5vw,4.75rem)]">
    <Container>
      <div class="mb-[clamp(1.25rem,2.6vw,2.125rem)] max-w-[64ch]">
        <PageItems
          locale={locale}
          units={groupItems(formas.filter((item) => item.kind !== "buttons"))}
        />
      </div>
      {buttons !== undefined && (
        <ul class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-4" role="list">
          {buttons.items.map((button) => {
            const kind = kindOf(button.href);
            const value = valueOf(button.href);
            return (
              <li class="group relative flex min-w-0 flex-col gap-2.5 border border-line-strong bg-canvas p-[clamp(1.25rem,2vw,1.75rem)]">
                <span
                  aria-hidden="true"
                  class="absolute inset-x-[-1px] top-[-1px] h-[3px] origin-left scale-x-0 bg-turquoise transition-transform duration-[450ms] group-focus-within:scale-x-100 group-hover:scale-x-100"
                ></span>
                <span
                  aria-hidden="true"
                  class="grid size-12 place-items-center bg-card text-accent"
                >
                  <svg
                    viewBox="0 0 24 24"
                    class="size-[26px]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d={ICONS[kind]} />
                  </svg>
                </span>
                <h3 class="mt-1.5 text-[clamp(0.9375rem,1.2vw,1.0625rem)] leading-[1.3] tracking-[0.06em]">
                  <a
                    href={resolveContentHref(button.href, locale)}
                    class="after:absolute after:inset-0 after:content-['']"
                    {...(button.href.startsWith("https://")
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    {button.label}
                  </a>
                </h3>
                {value !== "" && (
                  <p class="text-[0.8125rem] font-bold tracking-[0.05em] [overflow-wrap:anywhere]">
                    {value}
                  </p>
                )}
              </li>
            );
          })}
        </ul>
      )}
    </Container>
  </section>

  <section id="formulario" class="bg-canvas py-[clamp(2.75rem,5vw,4.75rem)]">
    <Container>
      <div class="grid items-start gap-[clamp(1.5rem,4vw,4rem)] lg:grid-cols-[4fr_8fr]">
        <div class="lg:sticky lg:top-32">
          <PageItems
            locale={locale}
            units={groupItems(formulario.filter((item) => item.kind !== "form"))}
          />
        </div>
        <div class="min-w-0 border border-line-strong bg-white p-[clamp(1.25rem,3vw,2.5rem)]">
          <PageItems
            locale={locale}
            units={groupItems(formulario.filter((item) => item.kind === "form"))}
          />
        </div>
      </div>
    </Container>
  </section>

  {preguntas !== undefined && (
    <section id={preguntas.id} class="surface-stone bg-canvas py-[clamp(2.75rem,5vw,4.75rem)]">
      <Container>
        <PageItems locale={locale} units={groupItems(preguntas.items)} />
      </Container>
    </section>
  )}
</div>
