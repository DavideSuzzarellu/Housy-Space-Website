---
import { COMPANY } from "@/features/agency/domain/company";
import {
  COMPANY_EMAIL,
  CONTACT_PHONE,
  phoneDisplay,
  SOCIAL_LINKS,
  telHref,
} from "@/features/agency/domain/contact";
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { resolveContentHref } from "@/shared/i18n/contentLinks";
import { getLocalizedPath } from "@/shared/i18n/routes";
import Button from "@/shared/ui/atoms/Button.astro";
import Emphasis from "@/shared/ui/atoms/Emphasis.astro";
import SocialLinks from "@/shared/ui/molecules/SocialLinks.astro";

/**
 * Closing panel of the about page (reference `nx-end`): the call to talk with the social links,
 * "where we are" (the main navigation links to `#donde-estamos`), a pointer to the reviews and the
 * company data in a closed `<details>`. All company data comes from `company.ts` / `contact.ts`.
 */
interface Props {
  locale: Locale;
  title: string;
  text: string;
  actions: readonly { readonly label: string; readonly href: string; readonly solid: boolean }[];
  opinions: { readonly label: string; readonly text: string };
}

const { locale, title, text, actions, opinions } = Astro.props;
const t = getDictionary(locale);
const ta = t.about;
const place = `${COMPANY.address.street}, ${COMPANY.address.postalCode} ${COMPANY.address.city}`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(place)}`;
const LABEL = "text-[0.6875rem] leading-[1.4] font-bold tracking-[0.22em] text-accent uppercase";
/** Text link of the reference (`nx-a`): small capitals with a rule under them. */
const LINK =
  "inline-block border-b border-current pb-1 text-[0.71875rem] leading-[1.3] font-semibold tracking-[0.13em] text-fg uppercase transition-colors hover:text-accent focus-visible:text-accent";
const [primary, ...others] = actions;
---

<div
  id="contacto-nosotros"
  class="cut-b mt-[clamp(1.625rem,4.8vh,3.25rem)] grid gap-y-[clamp(1rem,2.8vh,1.875rem)] bg-bg-soft px-[clamp(1.375rem,5vw,4.25rem)] pt-[clamp(1.5rem,4.8vh,3.125rem)] pb-[clamp(1.125rem,3.2vh,2.125rem)] [--cut:clamp(1.25rem,2.8vw,2.5rem)] min-[900px]:grid-cols-[7fr_4fr] min-[900px]:gap-x-[clamp(2.25rem,6vw,5.5rem)]"
>
  <div>
    <h2 data-no-rule class="max-w-[22ch] text-[clamp(1.5625rem,2.65vw,2.375rem)] leading-[1.08]">
      <Emphasis text={title} />
    </h2>
    <p class="mt-[clamp(0.75rem,2.4vh,1.5rem)] max-w-[44ch] text-[clamp(0.96875rem,1.2vw,1.09375rem)] leading-[1.6] tracking-normal text-muted normal-case">
      {text}
    </p>
    <div class="mt-[clamp(0.875rem,2.8vh,1.875rem)] flex flex-wrap items-center gap-x-6.5 gap-y-3.5">
      {primary !== undefined && (
        <Button
          href={resolveContentHref(primary.href, locale)}
          variant="solid"
          class="leading-[1.2] py-[0.9375rem]!"
        >
          {primary.label}
        </Button>
      )}
      {others.map((action) => (
        <a href={resolveContentHref(action.href, locale)} class={LINK}>
          {action.label}
        </a>
      ))}
      <SocialLinks
        links={SOCIAL_LINKS}
        label={t.contact.socialLabel}
        newTabLabel={t.a11y.opensInNewTab}
        class="border-l border-line-strong pl-5"
      />
    </div>
  </div>

  <div class="grid content-start gap-y-[clamp(0.875rem,2.6vh,1.625rem)] min-[720px]:grid-cols-2 min-[720px]:gap-x-[clamp(1.5rem,4vw,3rem)] min-[900px]:grid-cols-1">
    <div id="donde-estamos" class="scroll-mt-12 border-t border-fg pt-3.5 normal-case">
      <h3 class:list={["mb-2.5", LABEL]}>{ta.whereWeAre.title}</h3>
      <p class="text-[0.9375rem] leading-[1.55] tracking-normal">
        <span class="block">{COMPANY.address.street}</span>
        {COMPANY.address.postalCode} {COMPANY.address.city}
      </p>
      <p class="mt-1.5 text-[0.9375rem] leading-[1.55] tracking-normal text-muted">
        {t.footer.hours}
      </p>
      <a
        href={directionsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class:list={["mt-2.5", LINK]}
      >
        {ta.whereWeAre.howToGet}
        <span class="sr-only"> {t.a11y.opensInNewTab}</span>
      </a>
    </div>
    <div id="opiniones" class="border-t border-fg pt-3.5 normal-case">
      <h3 class:list={["mb-2.5", LABEL]}>{opinions.label}</h3>
      <p class="max-w-[30ch] text-[clamp(0.90625rem,1.15vw,1.03125rem)] leading-[1.45] font-bold tracking-[0.005em]">
        {opinions.text}
      </p>
      <a href={`${getLocalizedPath("home", locale)}#resenas`} class:list={["mt-2.5", LINK]}>
        {ta.reviews.heading}
      </a>
    </div>
  </div>

  <details class="group border-t border-line-strong pt-3.5 min-[900px]:col-span-full">
    <summary class="inline-block cursor-pointer list-none text-[0.6875rem] leading-[1.4] font-semibold tracking-[0.16em] text-muted uppercase hover:text-fg [&::-webkit-details-marker]:hidden">
      <span class="border-b border-current pb-[3px] group-open:hidden">{ta.companyData.show}</span>
      <span class="hidden border-b border-current pb-[3px] group-open:inline">
        {ta.companyData.hide}
      </span>
    </summary>
    <div class="mt-5 normal-case">
      <h3 class:list={["mb-2.5", LABEL]}>{ta.whereWeAre.companyDataLabel}</h3>
      <ul class="text-[0.8125rem] leading-[1.7] tracking-[0.01em]" role="list">
        <li>{COMPANY.legalName}</li>
        <li>
          {t.footer.taxIdLabel} {COMPANY.taxId}
        </li>
        <li>
          {t.footer.aicatLabel}: AICAT nº {COMPANY.aicatNumber}
        </li>
        <li>{place}</li>
        <li>
          {t.contact.phoneLabel}
          <a href={telHref(CONTACT_PHONE)} class="hover:text-accent">
            {phoneDisplay(CONTACT_PHONE)}
          </a>
        </li>
        <li>
          {t.contact.emailLabel}
          <a href={`mailto:${COMPANY_EMAIL}`} class="hover:text-accent">
            {COMPANY_EMAIL}
          </a>
        </li>
      </ul>
    </div>
  </details>
</div>
