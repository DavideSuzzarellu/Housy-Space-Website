---
import type { HomeContent } from "@/features/agency/application/homeContent";
import type { FormField } from "@/features/pages/infrastructure/pageSchema";
import LeadForm from "@/features/leads/ui/LeadForm.astro";
import type { Locale } from "@/shared/i18n/config";
import Container from "@/shared/ui/atoms/Container.astro";
import Emphasis from "@/shared/ui/atoms/Emphasis.astro";

/** Home-page private consultation form (§11.1 "Contact form" section). */
interface Props {
  locale: Locale;
  content: HomeContent["contact"];
}

const { locale, content } = Astro.props;

const fields: FormField[] = [
  {
    kind: "field",
    name: "nombre",
    label: content.fieldNameLabel,
    type: "text",
    required: true,
    full: false,
  },
  {
    kind: "field",
    name: "email",
    label: content.fieldEmailLabel,
    type: "email",
    required: false,
    full: false,
  },
  {
    kind: "field",
    name: "mensaje",
    label: content.fieldMessageLabel,
    type: "textarea",
    required: true,
    full: true,
  },
  {
    kind: "field",
    name: "consent",
    label: content.fieldConsentLabel,
    type: "consent",
    required: true,
    full: true,
  },
  { kind: "submit", label: content.submitLabel },
];
---

<section
  id="contacto"
  aria-labelledby="home-contact-heading"
  data-section="contact"
  class="defer-render surface-dark bg-canvas py-[clamp(2.75rem,5vw,4.125rem)]"
>
  <Container class="max-w-2xl">
    <h2
      id="home-contact-heading"
      data-reveal
      class="font-heading text-[clamp(2rem,4vw,3rem)] leading-tight text-fg"
    >
      <Emphasis text={content.heading} />
    </h2>
    <p data-reveal class="mt-3 text-muted">
      {content.lead}
    </p>
    <LeadForm locale={locale} id="home-cf" mode="whatsapp" fields={fields} />
  </Container>
</section>
