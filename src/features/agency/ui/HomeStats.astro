---
import type { HomeContent } from "@/features/agency/application/homeContent";
import type { Locale } from "@/shared/i18n/config";
import { getDictionary } from "@/shared/i18n";
import { getLocalizedPath } from "@/shared/i18n/routes";
import Button from "@/shared/ui/atoms/Button.astro";
import Container from "@/shared/ui/atoms/Container.astro";
import SectionHeading from "@/shared/ui/molecules/SectionHeading.astro";

/**
 * "Cinco años" figures (reference `#cifras`): heading and intro with a CTA to the sold-properties
 * listing, then the five-year achievements as a 4-column hairline table (number, optional "+",
 * unit, caption) that counts up on scroll, and a note.
 * The final figure is in the HTML: the count-up only restarts the visible digits.
 */
interface Props {
  locale: Locale;
  content: HomeContent["stats"];
}

const { locale, content } = Astro.props;
const moreThan = getDictionary(locale).home.stats.moreThan;

const stats = [
  {
    number: content.stat1Number,
    plus: content.stat1Plus,
    unit: content.stat1Unit,
    label: content.stat1Label,
  },
  {
    number: content.stat2Number,
    plus: content.stat2Plus,
    unit: content.stat2Unit,
    label: content.stat2Label,
  },
  {
    number: content.stat3Number,
    plus: content.stat3Plus,
    unit: content.stat3Unit,
    label: content.stat3Label,
  },
  {
    number: content.stat4Number,
    plus: content.stat4Plus,
    unit: content.stat4Unit,
    label: content.stat4Label,
  },
];
---

<section
  id="cifras"
  aria-labelledby="stats-heading"
  class="defer-render surface-stone bg-canvas py-[clamp(2.375rem,6.2vh,3.625rem)]"
>
  <Container>
    <div class="mb-[clamp(1.125rem,2.2vw,1.75rem)] flex flex-wrap items-end justify-between gap-x-10 gap-y-3.5">
      <div class="max-w-161">
        <SectionHeading
          id="stats-heading"
          heading={content.heading}
          size="home"
          rule={false}
          class="[&_em]:block"
        />
        <p
          data-reveal
          class="mt-[clamp(0.75rem,1.3vw,1.125rem)] text-[clamp(0.9375rem,1.12vw,1.03125rem)] leading-[1.6] tracking-[0.03em] text-fg-2 normal-case"
        >
          {content.intro}
        </p>
      </div>
      <Button
        href={`${getLocalizedPath("sale", locale)}#pisos-vendidos`}
        variant="solid"
        arrow
        class="leading-none! max-[759px]:w-full"
      >
        {content.ctaLabel}
      </Button>
    </div>

    <ul class="m-0 grid list-none grid-cols-2 gap-px border-y border-line-strong bg-line-strong p-0 min-[900px]:grid-cols-4">
      {stats.map((stat, index) => (
        <li
          data-reveal
          style={`--reveal-delay: ${index * 0.1}s`}
          class="flex min-w-0 flex-col gap-1.5 bg-stone px-[clamp(0.875rem,3vw,1.375rem)] pt-[clamp(1rem,1.8vw,1.5rem)] pb-[clamp(0.875rem,1.6vw,1.375rem)] max-[899px]:odd:pl-0 max-[899px]:even:pr-0 min-[900px]:px-[clamp(1rem,2.2vw,1.875rem)] min-[900px]:first:pl-0 min-[900px]:last:pr-0"
        >
          <p class="m-0 flex flex-wrap items-baseline gap-x-2.5 gap-y-1 text-[clamp(2.125rem,3.6vw,3.25rem)] leading-none font-black tracking-[-0.02em] text-fg">
            <span aria-hidden="true">
              {stat.plus && <span class="mr-[0.02em] font-normal">+</span>}
              <span class="stat-count" style={`--target: ${stat.number}`}>
                <span class="stat-final">{stat.number}</span>
              </span>
            </span>
            <span class="sr-only">
              {stat.plus ? `${moreThan} ` : ""}
              {stat.number}
            </span>
            <span class="text-[clamp(0.656rem,0.9vw,0.781rem)] leading-[1.3] font-semibold tracking-[0.2em] text-petrol uppercase">
              {stat.unit}
            </span>
          </p>
          <p class="m-0 max-w-[26ch] text-[clamp(0.719rem,0.95vw,0.8125rem)] leading-[1.65] tracking-[0.05em] text-muted normal-case">
            {stat.label}
          </p>
        </li>
      ))}
    </ul>

    <p
      data-reveal
      class="mt-[clamp(0.875rem,1.6vw,1.25rem)] max-w-[62ch] text-[clamp(0.719rem,0.95vw,0.8125rem)] leading-[1.65] tracking-[0.05em] text-muted normal-case"
    >
      {content.note}
    </p>
  </Container>
</section>

<style>
  /*
   * Count-up with no JavaScript: a registered integer property runs 0 to the figure while the row
   * scrolls into view, and a counter prints it. Without scroll-driven animations, or with reduced
   * motion, the real number in the HTML (.stat-final) is shown as it is.
   */
  @property --count {
    syntax: "<integer>";
    inherits: false;
    initial-value: 0;
  }

  @keyframes stat-count {
    to {
      --count: var(--target);
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .stat-count {
        counter-reset: stat var(--count);
        font-variant-numeric: tabular-nums;
        animation: stat-count cubic-bezier(0.2, 0.7, 0.2, 1) both;
      }

      /* Separate rule on purpose (a minifier folds the timeline into the shorthand, which browsers reject). */
      li > p > span > .stat-count {
        animation-timeline: view();
        animation-range: entry 10% entry 90%;
      }

      .stat-count::before {
        content: counter(stat);
      }

      .stat-final {
        display: none;
      }
    }
  }
</style>
