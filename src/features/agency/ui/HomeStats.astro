---
import type { HomeContent } from "@/features/agency/application/homeContent";
import type { Locale } from "@/shared/i18n/config";
import { getDictionary } from "@/shared/i18n";
import { getLocalizedPath } from "@/shared/i18n/routes";
import Emphasis from "@/shared/ui/atoms/Emphasis.astro";
import Button from "@/shared/ui/atoms/Button.astro";
import Container from "@/shared/ui/atoms/Container.astro";

/**
 * Stats section: five-year achievements as a 4-column hairline table (number, optional "+",
 * unit, caption) that counts up on scroll, a note, and a CTA to the sold-properties listing.
 * The final figure is in the HTML: the count-up only restarts the visible digits.
 */
interface Props {
  locale: Locale;
  id: string;
  content: HomeContent["stats"];
}

const { locale, id, content } = Astro.props;
const moreThan = getDictionary(locale).home.stats.moreThan;

const stats = [
  {
    number: content.stat1Number,
    plus: content.stat1Plus,
    unit: content.stat1Unit,
    label: content.stat1Label,
  },
  {
    number: content.stat2Number,
    plus: content.stat2Plus,
    unit: content.stat2Unit,
    label: content.stat2Label,
  },
  {
    number: content.stat3Number,
    plus: content.stat3Plus,
    unit: content.stat3Unit,
    label: content.stat3Label,
  },
  {
    number: content.stat4Number,
    plus: content.stat4Plus,
    unit: content.stat4Unit,
    label: content.stat4Label,
  },
];
---

<section
  id={id}
  aria-labelledby="stats-heading"
  class="surface-stone bg-canvas pt-[clamp(3rem,5.6vw,5rem)] pb-[clamp(3.25rem,6vw,5.25rem)]"
>
  <Container>
    <div class="mb-[clamp(1.625rem,3.4vw,2.75rem)]">
      <p data-reveal class="mb-2.5 text-[0.6875rem] tracking-[0.16em] text-accent uppercase">
        {content.eyebrow}
      </p>
      <h2
        id="stats-heading"
        data-reveal
        data-no-rule
        class="max-w-[24em] text-[clamp(1.875rem,3.5vw,3.125rem)] leading-[1.06] tracking-[-0.005em] text-balance"
      >
        <Emphasis text={content.heading} />
      </h2>
    </div>

    <ul class="m-0 grid list-none grid-cols-2 gap-px border-y border-line-strong bg-line-strong p-0 min-[900px]:grid-cols-4">
      {stats.map((stat, index) => (
        <li
          data-reveal
          style={`--reveal-delay: ${index * 0.1}s`}
          class="flex min-w-0 flex-col gap-2.5 bg-stone px-[clamp(0.875rem,3vw,1.375rem)] py-4.5 max-[899px]:odd:pl-0 max-[899px]:even:pr-0 min-[900px]:px-[clamp(1rem,2.2vw,1.875rem)] min-[900px]:pt-[clamp(1.375rem,2.6vw,2.25rem)] min-[900px]:pb-[clamp(1.25rem,2.4vw,2rem)] min-[900px]:first:pl-0 min-[900px]:last:pr-0"
        >
          <p class="m-0 flex flex-wrap items-baseline gap-x-2.5 gap-y-1 text-[clamp(2.125rem,9vw,3.375rem)] leading-none font-black tracking-[-0.02em] text-fg min-[900px]:text-[clamp(2.5rem,4.8vw,4.25rem)]">
            <span aria-hidden="true">
              {stat.plus && <span class="mr-[0.02em] font-normal">+</span>}
              <span data-count={stat.number}>{stat.number}</span>
            </span>
            <span class="sr-only">
              {stat.plus ? `${moreThan} ` : ""}
              {stat.number}
            </span>
            <span class="text-[clamp(0.656rem,0.9vw,0.781rem)] leading-[1.3] font-semibold tracking-[0.2em] text-petrol uppercase">
              {stat.unit}
            </span>
          </p>
          <p class="m-0 max-w-[26ch] text-[clamp(0.719rem,0.95vw,0.8125rem)] leading-[1.65] tracking-[0.05em] text-muted">
            {stat.label}
          </p>
        </li>
      ))}
    </ul>

    <div class="mt-[clamp(1.625rem,3.2vw,2.5rem)] flex flex-wrap items-center justify-between gap-x-7 gap-y-4">
      <p
        data-reveal
        class="m-0 max-w-[52ch] text-[clamp(0.75rem,1vw,0.875rem)] leading-[1.7] tracking-[0.04em] text-fg"
      >
        {content.note}
      </p>
      <div data-reveal class="max-[560px]:w-full">
        <Button
          href={`${getLocalizedPath("sale", locale)}#pisos-vendidos`}
          variant="solid"
          size="lg"
          arrow
          class="max-[560px]:w-full"
        >
          {content.ctaLabel}
        </Button>
      </div>
    </div>
  </Container>
</section>

<script>
  import { initStatsCount } from "./statsCount";

  document.addEventListener("astro:page-load", initStatsCount);
</script>
