---
import type { HomeContent } from "@/features/agency/application/homeContent";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import Button from "@/shared/ui/atoms/Button.astro";
import Container from "@/shared/ui/atoms/Container.astro";

/**
 * Intro section: the site headline and primary CTA, in its own light section below the
 * hero video. Matches the `#presentacion` / `.hi2` section of the HousySpace reference.
 */
interface Props {
  locale: Locale;
  id: string;
  content: HomeContent["hero"];
}

const { locale, id, content } = Astro.props;
---

<section
  id={id}
  aria-labelledby="presentation-heading"
  class="relative overflow-hidden bg-canvas py-[clamp(4rem,10vw,7.5rem)]"
>
  <!-- Decorative geometric grid (§11.1 reference visual) -->
  <svg
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 h-full w-full"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect x="5%" y="8%" width="34%" height="58%" fill="none" stroke="currentColor" stroke-width="0.6" class="text-line" opacity="0.6" />
    <rect x="42%" y="3%" width="46%" height="72%" fill="none" stroke="currentColor" stroke-width="0.6" class="text-line" opacity="0.5" />
    <rect x="68%" y="30%" width="28%" height="52%" fill="none" stroke="currentColor" stroke-width="0.4" class="text-line" opacity="0.3" />
    <line x1="39%" y1="8%" x2="39%" y2="66%" stroke="currentColor" stroke-width="0.4" class="text-line" opacity="0.4" />
    <line x1="5%" y1="66%" x2="88%" y2="66%" stroke="currentColor" stroke-width="0.4" class="text-line" opacity="0.35" />
  </svg>

  <Container class="relative">
    <div
      class="grid gap-[clamp(1.75rem,3vw,2.5rem)] min-[900px]:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] min-[900px]:items-end"
    >
      <h1
        id="presentation-heading"
        data-reveal
        class="font-sans font-normal uppercase tracking-[-0.005em] leading-[1.06] text-[clamp(2.5rem,4.9vw,4.625rem)]"
      >
        <span class="block text-balance">{content.headingFirst}</span>
        <span class="block italic text-muted text-balance">{content.headingSecond}</span>
      </h1>
      <div data-reveal class="min-[900px]:pb-1">
        <Button href={getLocalizedPath("about", locale)} variant="solid" size="lg" arrow>
          {content.ctaLabel}
        </Button>
      </div>
    </div>
  </Container>
</section>
