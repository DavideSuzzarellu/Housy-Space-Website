---
import type { HomeContent } from "@/features/agency/application/homeContent";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import Button from "@/shared/ui/atoms/Button.astro";
import HairlineThread from "@/shared/ui/atoms/HairlineThread.astro";
import Container from "@/shared/ui/atoms/Container.astro";

/**
 * Intro section: the site headline and primary CTA, in its own light section below the
 * hero video. Matches the `#presentacion` / `.hi2` section of the HousySpace reference.
 */
interface Props {
  locale: Locale;
  id: string;
  content: HomeContent["hero"];
}

const { locale, id, content } = Astro.props;
---

<section
  id={id}
  aria-labelledby="presentation-heading"
  class="relative overflow-clip bg-canvas pt-[clamp(0.25rem,1.6vw,1.25rem)]"
>
  <!-- Decorative geometric grid (§11.1 reference visual) -->
  <svg
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 h-full w-full"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect
      x="5%"
      y="8%"
      width="34%"
      height="58%"
      fill="none"
      stroke="currentColor"
      stroke-width="0.6"
      class="text-line"
      opacity="0.6"
    />
    <rect
      x="42%"
      y="3%"
      width="46%"
      height="72%"
      fill="none"
      stroke="currentColor"
      stroke-width="0.6"
      class="text-line"
      opacity="0.5"
    />
    <rect
      x="68%"
      y="30%"
      width="28%"
      height="52%"
      fill="none"
      stroke="currentColor"
      stroke-width="0.4"
      class="text-line"
      opacity="0.3"
    />
    <line
      x1="39%"
      y1="8%"
      x2="39%"
      y2="66%"
      stroke="currentColor"
      stroke-width="0.4"
      class="text-line"
      opacity="0.4"
    />
    <line
      x1="5%"
      y1="66%"
      x2="88%"
      y2="66%"
      stroke="currentColor"
      stroke-width="0.4"
      class="text-line"
      opacity="0.35"
    />
  </svg>

  <Container class="relative">
    <HairlineThread position="top" />
    <div class="relative isolate mx-auto max-w-[1040px]">
      <p
        data-reveal
        class="mb-[clamp(1.375rem,2.6vw,1.875rem)] flex items-center gap-4 text-[0.6875rem] tracking-[0.24em] text-accent uppercase before:h-px before:w-8.5 before:flex-none before:bg-taupe/70 max-[479px]:tracking-[0.18em] max-[479px]:before:hidden"
      >
        {content.eyebrow}
      </p>
      <div class="grid gap-[clamp(1.5rem,3vw,2.25rem)]">
        <h1
          id="presentation-heading"
          data-reveal="words"
          class="font-sans leading-[1.06] font-normal tracking-[-0.005em] uppercase text-[clamp(1.875rem,3.5vw,3.125rem)]"
        >
          <span data-words-line="rise" class="block font-black text-balance">
            {content.headingFirst}
          </span>{" "}
          <span data-words-line="type" class="block text-muted text-balance">
            {content.headingSecond}
          </span>
        </h1>
        <div data-reveal style="--reveal-delay: 1.05s">
          <Button href={getLocalizedPath("about", locale)} variant="solid" size="xl" arrow>
            {content.ctaLabel}
          </Button>
        </div>
      </div>
    </div>
    <HairlineThread position="bottom" />
  </Container>
</section>
