---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import ArrowLabel from "@/shared/ui/atoms/ArrowLabel.astro";
import { PHOTO_PICTURE } from "@/shared/lib/images";

/** Image-led service tile of the home services mosaic. */
interface Props {
  href: string;
  number: string;
  name: string;
  summary: string;
  ctaLabel: string;
  image: ImageMetadata;
  imageAlt: string;
  size: "xl" | "l" | "m" | "wide";
  /** Stagger for the scroll reveal, in seconds. */
  revealDelay?: number;
}

const {
  href,
  number,
  name,
  summary,
  ctaLabel,
  image,
  imageAlt,
  size,
  revealDelay = 0,
} = Astro.props;

const SIZES = {
  xl: "md:col-span-3 lg:col-span-7 lg:min-h-130",
  l: "md:col-span-3 lg:col-span-5 lg:min-h-130",
  m: "md:col-span-3 lg:col-span-4 lg:min-h-100",
  wide: "md:col-span-6 lg:col-span-12 lg:min-h-90",
} as const;

const HEADINGS = {
  xl: "text-[clamp(1.875rem,3.3vw,3rem)]",
  l: "text-[clamp(1.625rem,2.5vw,2.25rem)]",
  m: "text-[clamp(1.625rem,2.5vw,2.25rem)]",
  wide: "text-[clamp(1.625rem,2.5vw,2.25rem)]",
} as const;
---

<a
  href={href}
  data-reveal
  style={`--reveal-delay: ${revealDelay}s`}
  class:list={[
    "group relative block min-h-85 overflow-hidden bg-bg-deep text-white no-underline",
    "after:absolute after:inset-0 after:bg-linear-to-b after:from-ink/0 after:from-30% after:via-ink/55 after:via-62% after:to-ink/92",
    size === "wide" &&
      "lg:after:bg-linear-to-r lg:after:from-ink/0 lg:after:from-40% lg:after:via-ink/0 lg:after:to-ink/60",
    SIZES[size],
  ]}
>
  <Picture
    {...PHOTO_PICTURE}
    src={image}
    alt={imageAlt}
    widths={[480, 640, 800, 1200]}
    sizes={
      size === "wide"
        ? "(min-width: 1120px) 70rem, calc(100vw - 2.75rem)"
        : "(min-width: 1024px) 40vw, (min-width: 768px) 50vw, calc(100vw - 2.75rem)"
    }
    class="absolute inset-0 size-full object-cover transition-[transform,filter] duration-1400 ease-brand group-hover:scale-106 group-hover:brightness-105 group-focus-visible:scale-106"
  />
  <div
    class:list={[
      "absolute inset-x-0 bottom-0 z-2 flex flex-col gap-2.5 p-[clamp(1.375rem,2.4vw,2.125rem)]",
      size === "wide" &&
        "lg:top-0 lg:left-auto lg:w-[48%] lg:justify-end lg:bg-linear-to-r lg:from-ink/0 lg:to-ink/85 lg:to-30%",
    ]}
  >
    <span aria-hidden="true" class="text-[0.9375rem] tracking-[0.08em] text-fg/85">
      {number}
    </span>
    <h3 class:list={["m-0 max-w-[16ch] leading-[1.06]", HEADINGS[size]]}>{name}</h3>
    <p class="m-0 max-w-[46ch] text-[0.9375rem] text-fg/90 transition-[opacity,translate] duration-500 ease-brand pointer-fine:translate-y-2 pointer-fine:opacity-0 pointer-fine:group-hover:translate-y-0 pointer-fine:group-hover:opacity-100 pointer-fine:group-focus-visible:translate-y-0 pointer-fine:group-focus-visible:opacity-100 motion-reduce:translate-y-0 motion-reduce:opacity-100">
      {summary}
    </p>
    <ArrowLabel>{ctaLabel}</ArrowLabel>
  </div>
</a>
