---
import type { HomeContent } from "@/features/agency/application/homeContent";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import Button from "@/shared/ui/atoms/Button.astro";
import Container from "@/shared/ui/atoms/Container.astro";
import SectionHeading from "@/shared/ui/molecules/SectionHeading.astro";

/**
 * "Nuestra filosofía" (reference `#filosofia`): the heading on the left, on the right a lead, the
 * paragraph ending in the brand phrase and a CTA to how we work on the about page.
 */
interface Props {
  locale: Locale;
  content: HomeContent["philosophy"];
}

const { locale, content } = Astro.props;
---

<section
  id="filosofia"
  aria-labelledby="philosophy-heading"
  data-section="philosophy"
  class="defer-render bg-canvas py-[clamp(2.375rem,6.2vh,3.625rem)]"
>
  <Container class="grid items-start gap-[22px] min-[900px]:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] min-[900px]:gap-[clamp(1.75rem,5vw,5rem)]">
    <div>
      <SectionHeading
        id="philosophy-heading"
        heading={content.heading}
        size="home"
        class="min-[900px]:[&_em]:block"
      />
    </div>
    <div
      data-reveal
      style="--reveal-delay: 0.12s"
      class="min-[900px]:border-l min-[900px]:border-fg/16 min-[900px]:pl-[clamp(1.375rem,3.4vw,3.25rem)]"
    >
      <p class="mb-[clamp(0.875rem,1.6vw,1.25rem)] text-[clamp(1.375rem,2.4vw,2.125rem)] leading-[1.18] font-normal tracking-[0.03em] text-fg">
        {content.lead} <strong class="font-extrabold">{content.leadStrong}</strong>
      </p>
      <p class="mb-[clamp(1.25rem,2.2vw,1.875rem)] max-w-[56ch] text-[clamp(0.9375rem,1.12vw,1.03125rem)] leading-[1.65] tracking-[0.03em] text-fg-2">
        <span class="normal-case">{content.text}</span>{" "}
        <strong class="inline-block font-extrabold text-fg shadow-[inset_0_-0.2em_0_color-mix(in_srgb,var(--color-turquoise)_45%,transparent)] min-[480px]:whitespace-nowrap">
          {content.quote}
        </strong>
      </p>
      <Button
        href={`${getLocalizedPath("about", locale)}#como-trabajamos`}
        variant="solid"
        size="wide"
        arrow
        class="leading-none! max-[479px]:w-full [&_svg]:w-3!"
      >
        {content.ctaLabel}
      </Button>
    </div>
  </Container>
</section>
