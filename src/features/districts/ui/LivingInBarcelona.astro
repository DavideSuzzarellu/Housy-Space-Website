---
import { Picture } from "astro:assets";
import type { HomeContent } from "@/features/agency/application/homeContent";
import { DISTRICT_IMAGES } from "./districtImages";
import { DISTRICTS } from "@/features/districts/domain/districts";
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import { formatMessage } from "@/shared/lib/format";
import { PHOTO_PICTURE } from "@/shared/lib/images";
import ArrowUpRight from "@/shared/ui/atoms/ArrowUpRight.astro";
import Button from "@/shared/ui/atoms/Button.astro";
import Container from "@/shared/ui/atoms/Container.astro";
import SectionHeading from "@/shared/ui/molecules/SectionHeading.astro";

/** Living in Barcelona: carousel of the 10 districts, native scroll with prev/next buttons. */
interface Props {
  locale: Locale;
  content: HomeContent["districts"];
}

const { locale, content } = Astro.props;
const copy = getDictionary(locale).home.living;

const NAV_BUTTON =
  "grid size-12 cursor-pointer place-items-center rounded-full border border-line text-fg transition-colors hover:bg-fg hover:text-canvas focus-visible:bg-fg focus-visible:text-canvas disabled:cursor-default disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-fg md:size-14";
---

<section
  id="descubre"
  aria-labelledby="living-heading"
  data-section="living"
  class="surface-stone overflow-hidden bg-canvas py-[clamp(2.75rem,5vw,4.125rem)]"
>
  <Container>
    <SectionHeading
      id="living-heading"
      heading={content.heading}
      class="mb-[clamp(1.125rem,2.2vw,1.75rem)]"
    />
    <div class="mb-[clamp(1.375rem,2.6vw,2.125rem)] flex flex-wrap items-center justify-between gap-x-5 gap-y-3.5">
      <Button
        href={getLocalizedPath("living", locale)}
        variant="solid"
        size="lg"
        arrow
        class="max-sm:w-full"
      >
        {content.ctaLabel}
      </Button>
      <div class="ml-auto flex gap-2.5">
        <button type="button" data-rail-step="-1" aria-label={copy.previous} class={NAV_BUTTON}>
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="size-5 fill-none stroke-current stroke-2"
          >
            <path d="M15 5 8 12l7 7"></path>
          </svg>
        </button>
        <button type="button" data-rail-step="1" aria-label={copy.next} class={NAV_BUTTON}>
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="size-5 fill-none stroke-current stroke-2"
          >
            <path d="m9 5 7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>
  </Container>
  <div
    data-rail
    role="region"
    aria-label={copy.railLabel}
    class="snap-x snap-mandatory scroll-px-[var(--rail-pad)] overflow-x-auto overscroll-x-contain [--rail-pad:max(1.375rem,calc((100%-70rem)/2))] [scrollbar-width:none]"
  >
    <ul class="flex w-max gap-[clamp(0.75rem,1.4vw,1.125rem)] px-[var(--rail-pad)] py-1.5">
      {DISTRICTS.map((district) => {
        const image = DISTRICT_IMAGES[district.slug];
        return (
          <li class="snap-start">
            <a
              href={getLocalizedPath("district", locale, { district: district.slug })}
              class="group surface-dark relative block aspect-4/5 w-[min(72vw,18.5rem)] overflow-hidden rounded-[1.25rem] bg-ink text-white no-underline after:absolute after:inset-0 after:bg-linear-to-b after:from-ink/0 after:from-40% after:to-ink/80 md:w-[clamp(14.375rem,23vw,18.5rem)]"
            >
              {image !== undefined && (
                <Picture
                  {...PHOTO_PICTURE}
                  src={image}
                  alt=""
                  widths={[280, 560]}
                  sizes="(min-width: 768px) 18.5rem, 72vw"
                  class="absolute inset-0 size-full object-cover transition-transform duration-800 ease-brand group-hover:scale-106 group-focus-visible:scale-106"
                />
              )}
              <span class="absolute right-19 bottom-[clamp(1.125rem,1.8vw,1.5rem)] left-[clamp(1rem,1.6vw,1.375rem)] z-1 flex flex-col gap-1.5">
                <small class="text-[0.625rem] leading-tight font-semibold tracking-[0.16em] text-white/80">
                  {formatMessage(copy.barrioCount, { count: district.barrioCount })}
                </small>
                <b class="text-[clamp(1.125rem,1.7vw,1.4375rem)] leading-[1.1] font-bold text-balance">
                  {district.name}
                </b>
              </span>
              <span
                aria-hidden="true"
                class="absolute right-[clamp(0.875rem,1.4vw,1.25rem)] bottom-[clamp(0.875rem,1.4vw,1.25rem)] z-1 grid size-11 place-items-center rounded-full bg-taupe text-petrol-dark transition-[background-color,rotate] duration-300 group-hover:rotate-45 group-hover:bg-stone group-focus-visible:rotate-45 group-focus-visible:bg-stone"
              >
                <ArrowUpRight class="size-3" />
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    const rail = document.querySelector<HTMLElement>("[data-rail]");
    if (rail === null) return;
    const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-rail-step]")];
    const sync = (): void => {
      const end = rail.scrollWidth - rail.clientWidth - 2;
      buttons.forEach((button) => {
        button.disabled =
          button.dataset["railStep"] === "1" ? rail.scrollLeft >= end : rail.scrollLeft <= 2;
      });
    };
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const direction = Number(button.dataset["railStep"]);
        rail.scrollBy({ left: direction * rail.clientWidth * 0.8, behavior: "smooth" });
      });
    });
    rail.addEventListener("scroll", sync, { passive: true });
    sync();
  });
</script>
