---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { linkBarrioNames } from "@/features/districts/application/linkBarrios";
import { percentDiff, rankOf } from "@/features/districts/domain/marketStats";
import type { MarketData, MarketDistrict } from "@/features/districts/infrastructure/marketSchema";
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import { figureFormat, formatMessage } from "@/shared/lib/format";
import { PHOTO_PICTURE } from "@/shared/lib/images";
import ArrowUpRight from "@/shared/ui/atoms/ArrowUpRight.astro";
import Button from "@/shared/ui/atoms/Button.astro";
import FactList from "@/shared/ui/molecules/FactList.astro";
import SectionHeading from "@/shared/ui/molecules/SectionHeading.astro";
import Section from "@/shared/ui/molecules/Section.astro";
import BarChart from "@/shared/ui/organisms/charts/BarChart.astro";
import LineChart from "@/shared/ui/organisms/charts/LineChart.astro";
import BarrioMap from "./BarrioMap.astro";
import BarrioTable from "./BarrioTable.astro";
import { DISTRICT_IMAGES } from "./districtImages";
import DistrictLocator from "./DistrictLocator.astro";
import { byDescending, SOURCES } from "./marketSources";
import MarketKpis from "./MarketKpis.astro";
import ZoneHead from "./ZoneHead.astro";

/** A district: history, official figures, landmarks and its barrios. */
interface Props {
  locale: Locale;
  district: MarketDistrict;
  market: MarketData;
}

const { locale, district, market } = Astro.props;
/** The district prose is still the Spanish source on this locale. */
const fallback = district.proseFallback;
const dictionary = getDictionary(locale);
const t = dictionary.zones;
const city = market.city;
/** Official order (the numbers of the map and the table). */
const barrios = market.barrios.filter((b) => b.district === district.slug);
const image: ImageMetadata | undefined = DISTRICT_IMAGES[district.slug];
const kpis = [
  { label: t.saleLabel, key: "sale", unit: `${t.saleUnit} · 2025`, cityValue: city.sale },
  { label: t.rentLabel, key: "rent", unit: `${t.rentUnit} · 2025`, cityValue: city.rent },
  {
    label: t.densityLabel,
    key: "density",
    unit: `${t.densityUnit} · 2026`,
    cityValue: city.density,
  },
] as const;
const format = figureFormat(locale);
const facts = [
  { label: t.population, value: `${format.format(district.population)} ${t.inhabitants}` },
  { label: t.area, value: `${format.format(district.area)} km²` },
  { label: t.barriosLabel, value: String(district.barrioCount) },
  { label: t.rentPerM2, value: `${format.format(district.rentPerM2)} ${t.saleUnit} · 2025` },
];
const ANCHORS = [
  { href: "#historia", label: t.anchorDistrict },
  { href: "#datos", label: t.anchorMarket },
  { href: "#lugares", label: t.anchorPlaces },
  { href: "#barrios", label: t.anchorBarrios },
] as const;
const crumbs = [
  { label: dictionary.property.detail.home, href: getLocalizedPath("home", locale) },
  { label: dictionary.nav.living, href: getLocalizedPath("living", locale) },
  { label: district.name },
];
const TAG = "text-[0.6875rem] tracking-[0.16em] text-accent";
---

<ZoneHead
  crumbs={crumbs}
  breadcrumbLabel={dictionary.property.detail.breadcrumb}
  tag={formatMessage(t.districtTag, { count: district.barrioCount })}
  heading={district.name}
  lead={district.lead}
  fallback={fallback}
  variant="district"
>
  <nav aria-label={t.districtNavLabel} class="mt-[34px] flex flex-wrap gap-x-8">
    {ANCHORS.map(({ href, label }) => (
      <a
        href={href}
        class="py-3.5 text-[0.6875rem] leading-3 font-medium tracking-[0.14em] hover:text-accent"
      >
        {label}
      </a>
    ))}
  </nav>
  {image !== undefined && (
    <figure
      slot="after"
      data-par-host
      class="relative mx-auto mt-[clamp(1.25rem,3.4vh,2.125rem)] mb-0 h-[clamp(17.5rem,50vh,33.75rem)] w-[calc(min(70rem,100%)-2.75rem)] overflow-hidden bg-card [clip-path:polygon(0_0,calc(100%-36px)_0,100%_36px,100%_100%,0_100%)]"
    >
      <Picture
        {...PHOTO_PICTURE}
        src={image}
        alt=""
        widths={[560, 1120]}
        sizes="(min-width: 1120px) 1076px, 100vw"
        priority
        data-par=".08"
        class="absolute top-[-6%] left-0 h-[112%] w-full [translate:0_var(--py,0px)] object-cover"
      />
    </figure>
  )}
</ZoneHead>

<Section id="historia" labelledBy="district-history" name="district-history" spacing="scale">
  <p class={TAG}>{t.anchorDistrict}</p>
  <SectionHeading
    id="district-history"
    size="xl"
    heading={formatMessage(t.livingIn, { name: district.name })}
    class="mt-3 mb-[27px]"
  />
  <div lang={fallback ? "es" : undefined} class="normal-case">
    {district.history.map((paragraph, index) => (
      <p
        class:list={[
          "mb-[22px] last:mb-0",
          index === 0
            ? "text-[clamp(1.0625rem,1.355vw,1.21875rem)] leading-[1.58]"
            : "text-[clamp(0.9375rem,1.12vw,1.008rem)] leading-[1.62]",
        ]}
      >
        {linkBarrioNames(paragraph, barrios).map((segment) =>
          segment.slug === undefined ? (
            segment.text
          ) : (
            <a
              href={getLocalizedPath("barrio", locale, {
                barrio: segment.slug,
              })}
              class="text-accent underline underline-offset-2 hover:text-fg"
            >
              {segment.text}
            </a>
          ),
        )}
      </p>
    ))}
  </div>
</Section>

<Section id="datos" labelledBy="district-data" name="district-data" surface="stone" spacing="scale">
  <div class="mb-6 grid items-start gap-x-[86px] gap-y-6 min-[900px]:grid-cols-[minmax(0,1fr)_300px]">
    <div>
      <p class={TAG}>{t.officialData}</p>
      <SectionHeading
        id="district-data"
        size="data"
        heading={t.marketHeading}
        class="mt-3 mb-[18px]"
      />
      <p
        lang={fallback ? "es" : undefined}
        class="max-w-[43.125rem] text-[clamp(1rem,1.3vw,1.1875rem)] leading-[1.5] normal-case"
      >
        {district.summary}
      </p>
    </div>
    <DistrictLocator slug={district.slug} class="hidden h-auto w-75 min-[900px]:block" />
  </div>
  <FactList facts={facts} variant="boxed" class="mb-[22px]" />
  <MarketKpis
    locale={locale}
    class="mt-3.5 mb-1.5"
    items={kpis.map((kpi) => ({
      label: kpi.label,
      value: district[kpi.key],
      unit: `${kpi.unit} · ${formatMessage(t.rankDistrict, {
        rank: rankOf(
          district[kpi.key],
          market.districts.map((d) => d[kpi.key]),
        ),
        total: market.districts.length,
      })}`,
      comparisons: [{ diff: percentDiff(district[kpi.key], kpi.cityValue), against: city.name }],
    }))}
  />
  <div class="mt-[18px] grid gap-3.5 min-[900px]:grid-cols-2">
    <LineChart
      title={t.saleChart}
      unit={t.saleUnit}
      locale={locale}
      provisionalLabel={t.provisional}
      sourcePrefix={t.sourcePrefix}
      source={SOURCES.sale(t)}
      sourceUrl={SOURCES.saleUrl}
      series={[
        { name: district.name, points: district.saleSeries, tone: "main" },
        { name: city.name, points: city.saleSeries, tone: "third" },
      ]}
    />
    <LineChart
      title={t.rentChart}
      unit={t.rentUnit}
      locale={locale}
      provisionalLabel={t.provisional}
      sourcePrefix={t.sourcePrefix}
      source={SOURCES.rent(t)}
      sourceUrl={SOURCES.rentUrl}
      series={[
        { name: district.name, points: district.rentSeries, tone: "main" },
        { name: city.name, points: city.rentSeries, tone: "third" },
      ]}
    />
    <BarChart
      title={t.saleBars}
      unit={`${t.saleUnit} · 2025`}
      locale={locale}
      sourcePrefix={t.sourcePrefix}
      source={SOURCES.sale(t)}
      sourceUrl={SOURCES.saleUrl}
      items={[
        ...byDescending(barrios, (b) => b.sale).map((b) => ({ label: b.name, value: b.sale })),
        {
          label: formatMessage(t.districtSuffix, { name: district.name }),
          value: district.sale,
          tone: "second" as const,
        },
        { label: city.name, value: city.sale, tone: "third" as const },
      ]}
    />
    <BarChart
      title={t.densityBars}
      unit={t.densityUnit}
      locale={locale}
      sourcePrefix={t.sourcePrefix}
      source={t.densitySource}
      items={[
        ...byDescending(barrios, (b) => b.density).map((b) => ({
          label: b.name,
          value: b.density,
        })),
        {
          label: formatMessage(t.districtSuffix, { name: district.name }),
          value: district.density,
          tone: "second" as const,
        },
        { label: city.name, value: city.density, tone: "third" as const },
      ]}
    />
  </div>
</Section>

<Section id="lugares" labelledBy="district-places" name="district-places" spacing="scale">
  <p class={TAG}>{t.placesTag}</p>
  <SectionHeading
    id="district-places"
    heading={formatMessage(t.placesHeading, { name: district.name })}
    class="mt-3"
  />
  <ol
    lang={fallback ? "es" : undefined}
    class="mt-[34px] grid gap-x-14 md:grid-cols-2 lg:grid-cols-3"
  >
    {district.landmarks.map((landmark, index) => (
      <li class="grid grid-cols-[44px_minmax(0,1fr)] border-t border-line-strong pt-[26px] pb-6">
        <b
          aria-hidden="true"
          class="text-[0.9375rem] leading-normal font-normal tracking-[0.06em] text-taupe-tx"
        >
          {String(index + 1).padStart(2, "0")}
        </b>
        <div>
          <h3 class="text-[clamp(1rem,1.5vw,1.3125rem)] leading-[1.2] font-bold">
            {landmark.name}
          </h3>
          <span class="mt-1.5 mb-2.5 block text-[0.65625rem] tracking-[0.14em] text-muted">
            {landmark.where}
          </span>
          <p class="text-[0.8125rem] leading-[1.6] normal-case">{landmark.text}</p>
        </div>
      </li>
    ))}
  </ol>
</Section>

<Section
  id="barrios"
  labelledBy="district-barrios"
  name="district-barrios"
  surface="stone"
  spacing="scale"
>
  <p class={TAG}>{t.barriosTag}</p>
  <SectionHeading
    id="district-barrios"
    heading={formatMessage(t.barriosCountOf, { count: district.barrioCount, name: district.name })}
    class="mt-3 mb-[26px]"
  />
  <p class="mt-[-4px] mb-[26px] text-[0.8125rem] leading-[1.7] text-muted">{t.barriosSub}</p>
  <div class="grid grid-cols-[minmax(0,1fr)] items-start gap-7 min-[980px]:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
    <BarrioMap locale={locale} market={market} district={district.slug} />
    <div class="mt-3.5 mb-1.5">
      <BarrioTable locale={locale} barrios={barrios} numbered />
    </div>
  </div>
</Section>

<Section id="vivir" labelledBy="district-cta" name="district-cta" spacing="scale">
  <div class="grid gap-x-[72px] gap-y-10 min-[960px]:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
    <div>
      <p class={TAG}>{formatMessage(t.livingIn, { name: district.name })}</p>
      <SectionHeading
        id="district-cta"
        size="data"
        heading={t.ctaHeading}
        class="mt-3 mb-4 text-balance"
      />
      <p class="max-w-[52ch]">{t.ctaText}</p>
      <div class="mt-7 flex flex-col items-start gap-2.5">
        <Button href={getLocalizedPath("valuation", locale)} variant="solid" arrow>
          {t.valueHere}
        </Button>
        <Button href={getLocalizedPath("mySearch", locale)} arrow>
          {t.searchHere}
        </Button>
      </div>
    </div>
    <nav aria-label={t.otherDistricts} class="grid grid-cols-2 content-start gap-x-7">
      <p class="col-span-full mb-2 text-[0.6875rem] tracking-[0.16em] text-taupe-tx">
        {t.allDistricts}
      </p>
      {market.districts.map((other) => (
        <a
          href={getLocalizedPath("district", locale, { district: other.slug })}
          aria-current={other.slug === district.slug ? "page" : undefined}
          class="border-b border-line py-[11px] text-[1.0625rem] leading-tight no-underline transition-colors hover:text-accent aria-[current=page]:text-taupe-tx aria-[current=page]:before:mr-2.5 aria-[current=page]:before:mb-[3px] aria-[current=page]:before:inline-block aria-[current=page]:before:size-1.5 aria-[current=page]:before:rotate-45 aria-[current=page]:before:bg-taupe aria-[current=page]:before:content-['']"
        >
          {other.name}
        </a>
      ))}
      <a
        href={getLocalizedPath("living", locale)}
        class="col-span-full mt-[18px] inline-flex items-center gap-3 py-[11px] text-[0.6875rem] font-medium tracking-[0.14em] no-underline hover:text-accent"
      >
        {t.mapAndSearch}
        <ArrowUpRight class="size-3" />
      </a>
    </nav>
  </div>
</Section>
