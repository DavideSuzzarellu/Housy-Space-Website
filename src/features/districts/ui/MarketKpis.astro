---
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { figureFormat, formatMessage } from "@/shared/lib/format";

/** Headline figures with their year, comparisons and rank. Every figure shows its year (§6.2). */
export interface Kpi {
  readonly label: string;
  readonly value: number;
  readonly unit: string;
  readonly comparisons: readonly { readonly diff: number; readonly against: string }[];
  /** Empty when the rank is already part of the unit line (districts). */
  readonly rank?: string;
}

interface Props {
  locale: Locale;
  items: readonly Kpi[];
  class?: string;
}

const { locale, items, class: className } = Astro.props;
const t = getDictionary(locale).zones;
const format = figureFormat(locale);
const signed = (diff: number) => `${diff > 0 ? "+" : "−"}${Math.abs(diff)} %`;
---

<div class:list={["grid gap-px border border-line bg-line min-[481px]:grid-cols-3", className]}>
  {items.map((item) => (
    <div class="flex min-w-0 flex-col gap-0.5 bg-canvas px-3.5 pt-3.5 pb-3">
      <span class="text-[0.625rem] leading-[1.3] tracking-[0.12em] text-muted">{item.label}</span>
      <b class="mt-1 font-heading text-[clamp(1.1875rem,calc(1.9vw-2px),1.5rem)] leading-[1.05] font-normal">
        {format.format(item.value)}
      </b>
      <span class="text-[0.625rem] text-muted">{item.unit}</span>
      {item.comparisons.map((comparison) => (
        <small
          class:list={["text-[0.625rem]", "mt-1", comparison.diff >= 0 ? "text-ok" : "text-ko"]}
        >
          {formatMessage(t.versus, { diff: signed(comparison.diff), against: comparison.against })}
        </small>
      ))}
      {item.rank !== undefined && (
        <span class="mt-2.5 block border-t border-line pt-[9px] text-[0.625rem] text-taupe-tx">
          {item.rank}
        </span>
      )}
    </div>
  ))}
</div>
