---
import { buildBarrioMap, TONES } from "@/features/districts/application/districtMap";
import type { MarketData } from "@/features/districts/infrastructure/marketSchema";
import shapes from "@/features/districts/infrastructure/shapes.json";
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import { figureFormat, formatMessage } from "@/shared/lib/format";

/** Barrios of a district on the map, coloured by sale price among the 73 barrios (reference `zd4-bmf`). */
interface Props {
  locale: Locale;
  market: MarketData;
  district: string;
}

const { locale, market, district } = Astro.props;
const t = getDictionary(locale).zones;
const format = figureFormat(locale);
const map = buildBarrioMap(market, shapes, district);
const stops = Array.from({ length: TONES }, (_, i) => i);
---

<figure class="m-0 border border-line bg-canvas p-[clamp(0.875rem,2vw,1.375rem)]">
  <div class="relative" style={`aspect-ratio:${map.width.toFixed(1)}/${map.height.toFixed(1)}`}>
    <svg viewBox={map.viewBox} class="absolute inset-0 size-full">
      {map.barrios.map((barrio) => (
        <a
          href={getLocalizedPath("barrio", locale, { barrio: barrio.slug })}
          aria-label={barrio.name}
          class="zbm outline-none"
        >
          <path
            d={barrio.d}
            style={`fill:var(--color-ramp-${barrio.tone})`}
            stroke="var(--color-canvas)"
            stroke-width="1.3"
            stroke-linejoin="round"
          ></path>
        </a>
      ))}
    </svg>
    <div aria-hidden="true">
      {map.barrios.map((barrio) => (
        <span
          class="pointer-events-none absolute grid size-6 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border border-fg/35 bg-canvas text-[0.625rem] leading-none font-medium shadow-[0_1px_3px_rgb(23_43_43/0.18)] max-[599px]:size-5.25"
          style={`left:${barrio.left.toFixed(2)}%;top:${barrio.top.toFixed(2)}%`}
        >
          {barrio.index}
        </span>
      ))}
    </div>
  </div>
  <div aria-hidden="true" class="mt-3.5 text-[0.625rem] text-muted">
    <span>{formatMessage(t.barriosLegend, { count: market.barrios.length })}</span>
    <div class="my-1.5 flex h-2">
      {stops.map((stop) => (
        <i class="flex-1" style={`background:var(--color-ramp-${stop})`} />
      ))}
    </div>
    <span class="flex justify-between">
      <b class="font-normal">{format.format(map.range.min)}</b>
      <b class="font-normal">
        {format.format(map.range.max)} {t.saleUnit}
      </b>
    </span>
  </div>
</figure>

<style>
  .zbm:hover path,
  .zbm:focus-visible path {
    stroke: var(--color-fg);
    stroke-width: 2.6;
  }
</style>
