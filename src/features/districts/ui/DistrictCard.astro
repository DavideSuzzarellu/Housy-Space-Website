---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import ArrowLabel from "@/shared/ui/atoms/ArrowLabel.astro";
import MediaCredit from "@/shared/ui/atoms/MediaCredit.astro";
import { PHOTO_PICTURE } from "@/shared/lib/images";

/** Large image card linking to a district page. */
interface Props {
  href: string;
  name: string;
  tag: string;
  text: string;
  ctaLabel: string;
  image: ImageMetadata;
  imageAlt: string;
  credit: string;
  shape: "landscape" | "portrait";
  revealDelay?: number;
}

const {
  href,
  name,
  tag,
  text,
  ctaLabel,
  image,
  imageAlt,
  credit,
  shape,
  revealDelay = 0,
} = Astro.props;

const SHAPES = {
  landscape: "aspect-4/5 md:aspect-[4/3.3]",
  portrait: "aspect-4/5",
} as const;
---

<a
  href={href}
  data-reveal
  style={`--reveal-delay: ${revealDelay}s`}
  class:list={[
    "group relative block overflow-hidden bg-bg-deep text-white no-underline after:absolute after:inset-0 after:bg-linear-to-b after:from-ink/0 after:from-35% after:to-ink/90",
    SHAPES[shape],
  ]}
>
  <Picture
    {...PHOTO_PICTURE}
    src={image}
    alt={imageAlt}
    widths={[480, 640, 800, 1200]}
    sizes="(min-width: 768px) 55vw, calc(100vw - 2.75rem)"
    class="absolute inset-0 size-full object-cover transition-transform duration-1600 ease-brand group-hover:scale-105 group-focus-visible:scale-105"
  />
  <div class="absolute inset-x-0 bottom-0 z-2 grid gap-2 p-[clamp(1.375rem,3vw,2.5rem)]">
    <p class="text-[0.6875rem] tracking-[0.16em] text-turquoise uppercase">{tag}</p>
    <h3 class="text-[clamp(2.5rem,5vw,4.5rem)] leading-none">{name}</h3>
    <p class="m-0 max-w-[42ch] text-fg/90">{text}</p>
    <ArrowLabel>{ctaLabel}</ArrowLabel>
  </div>
  <MediaCredit tone="onImage" class="absolute right-3 bottom-2.5 z-3">
    {credit}
  </MediaCredit>
</a>
