---
import { itemsOf, splitBlockHead, type PageContent } from "@/features/pages/application/pages";
import type { Locale } from "@/shared/i18n/config";
import Container from "@/shared/ui/atoms/Container.astro";
import IndexAdvice from "./service/IndexAdvice.astro";
import IndexCta from "./service/IndexCta.astro";
import IndexGroup from "./service/IndexGroup.astro";
import IndexHead from "./service/IndexHead.astro";
import IndexSituations from "./service/IndexSituations.astro";
import ServiceHead from "./ServiceHead.astro";

/** The services index: head with jump links, the service cards by group, situations, advice and contact. */
interface Props {
  locale: Locale;
  content: PageContent;
  crumbs: readonly { readonly label: string; readonly href?: string }[];
  /** Untranslated page: marks the Spanish text for screen readers and translators. */
  fallback?: boolean;
}

const { locale, content, crumbs, fallback = false } = Astro.props;
const SURFACES = {
  paper: "bg-canvas",
  stone: "surface-stone bg-canvas",
  dark: "surface-dark bg-canvas",
} as const;
---

<div lang={fallback ? "es" : undefined} data-page-view data-services-index>
  <ServiceHead locale={locale} head={content.head} crumbs={crumbs} />
  {content.sections.map((section, index) => {
    const { head, body } = splitBlockHead(section.items);
    const headingId = `${section.id ?? `section-${index}`}-h`;
    const list = itemsOf(body, "list")[0];
    return (
      <section
        id={section.id}
        aria-labelledby={headingId}
        class:list={[
          "scroll-mt-28 py-[55.8px]",
          index > 1 && "defer-render",
          SURFACES[section.surface],
        ]}
      >
        <Container>
          {section.layout === "indexGroup" && list !== undefined && (
            <>
              <IndexHead items={head} id={headingId} class="mb-[clamp(20px,2.4vw,32px)]" />
              <IndexGroup locale={locale} list={list} />
            </>
          )}
          {section.layout === "indexSituations" && list !== undefined && (
            <div class="grid gap-5.5 min-[900px]:gap-[clamp(24px,3vw,40px)]">
              <IndexHead items={head} id={headingId} />
              <IndexSituations locale={locale} list={list} />
            </div>
          )}
          {section.layout === "indexAdvice" && (
            <IndexAdvice locale={locale} items={section.items} id={headingId} />
          )}
          {section.layout === "indexCta" && <IndexCta locale={locale} items={section.items} />}
        </Container>
      </section>
    );
  })}
</div>
