---
interface Props {
  heading: string;
  links: readonly { readonly label: string; readonly href: string }[];
}

/** Related services closing each service page (reference `.svp-other`), ending with the link to the index. */
const { heading, links } = Astro.props;
---

<nav
  aria-labelledby="other-services"
  class="grid border-t border-line-strong min-[640px]:grid-cols-2 min-[640px]:gap-x-10 min-[1024px]:gap-x-16"
>
  <p
    id="other-services"
    class="pt-3.5 pb-2 text-[0.6875rem] tracking-[0.16em] text-accent min-[640px]:col-span-full"
  >
    {heading}
  </p>
  {links.map((link) => (
    <a
      href={link.href}
      class="flex items-baseline justify-between gap-3 border-b border-line py-3.25 font-heading text-[18px] leading-[1.05] no-underline transition-[color,padding] duration-300 hover:pl-2 hover:text-accent focus-visible:pl-2 focus-visible:text-accent motion-reduce:transition-none"
    >
      <span>{link.label}</span>
      <i aria-hidden="true" class="text-accent">
        →
      </i>
    </a>
  ))}
</nav>
