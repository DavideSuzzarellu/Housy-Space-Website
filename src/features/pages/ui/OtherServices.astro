---
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { getLocalizedPath } from "@/shared/i18n/routes";
import { getServiceSlug, SERVICE_KEYS, type ServiceKey } from "@/shared/i18n/services";

/** Links to the other services, closing each service page (reference `.svp-other`). */
interface Props {
  locale: Locale;
  current: ServiceKey;
}

const { locale, current } = Astro.props;
const t = getDictionary(locale);
---

<nav
  aria-labelledby="other-services"
  class="grid border-t border-line-strong min-[640px]:grid-cols-2 min-[640px]:gap-x-10 min-[1024px]:gap-x-16"
>
  <p
    id="other-services"
    class="pt-3.5 pb-2 text-[0.6875rem] tracking-[0.16em] text-accent min-[640px]:col-span-full"
  >
    {t.nav.otherServices}
  </p>
  {SERVICE_KEYS.filter((service) => service !== current).map((service) => (
    <a
      href={getLocalizedPath("serviceDetail", locale, {
        service: getServiceSlug(service, locale),
      })}
      class="flex items-baseline justify-between gap-3 border-b border-line py-3.25 font-heading text-[18px] leading-6 no-underline transition-[color,padding] duration-300 hover:pl-2 hover:text-accent focus-visible:pl-2 focus-visible:text-accent motion-reduce:transition-none"
    >
      <span>{t.serviceNames[service]}</span>
      <i aria-hidden="true" class="text-accent">
        →
      </i>
    </a>
  ))}
</nav>
