---
import type { PageContent } from "@/features/pages/application/pages";
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import type { ServiceKey } from "@/shared/i18n/services";
import ServiceSection from "./ServiceSection.astro";
import ServiceHead from "./ServiceHead.astro";

/** A service detail page: illustrated head, then its sections on their surfaces. */
interface Props {
  locale: Locale;
  service: ServiceKey;
  content: PageContent;
  crumbs: readonly { readonly label: string; readonly href?: string }[];
  /** Untranslated page: marks the Spanish text for screen readers and translators. */
  fallback?: boolean;
}

const { locale, service, content, crumbs, fallback = false } = Astro.props;
const t = getDictionary(locale);
---

<div lang={fallback ? "es" : undefined} data-page-view data-service-view>
  <ServiceHead locale={locale} head={content.head} crumbs={crumbs} talk={t.servicePage.talk} />
  {content.sections.map((section, index) => (
    <ServiceSection locale={locale} service={service} section={section} defer={index > 1} />
  ))}
</div>
