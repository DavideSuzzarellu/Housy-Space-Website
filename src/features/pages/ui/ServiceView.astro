---
import { groupItems, type PageContent } from "@/features/pages/application/pages";
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import type { ServiceKey } from "@/shared/i18n/services";
import Container from "@/shared/ui/atoms/Container.astro";
import OtherServices from "./OtherServices.astro";
import PageItems from "./PageItems.astro";
import ServiceHead from "./ServiceHead.astro";

/** A service detail page: illustrated head, then its sections on their surfaces. */
interface Props {
  locale: Locale;
  service: ServiceKey;
  content: PageContent;
  crumbs: readonly { readonly label: string; readonly href?: string }[];
  /** Untranslated page: marks the Spanish text for screen readers and translators. */
  fallback?: boolean;
}

const { locale, service, content, crumbs, fallback = false } = Astro.props;
const t = getDictionary(locale);
const SURFACES = {
  paper: "bg-canvas",
  stone: "surface-stone bg-canvas",
  dark: "surface-dark bg-canvas",
} as const;
---

<div lang={fallback ? "es" : undefined} data-page-view data-service-view>
  <ServiceHead locale={locale} head={content.head} crumbs={crumbs} talk={t.servicePage.talk} />
  {content.sections.map((section) => (
    <section
      id={section.id}
      class:list={[
        "py-[clamp(2.75rem,5vw,4.125rem)]",
        section.band
          ? "surface-dark bg-canvas py-[clamp(3.5rem,8vw,6.5rem)] text-center"
          : SURFACES[section.surface],
      ]}
    >
      <Container>
        <PageItems locale={locale} units={groupItems(section.items)} />
      </Container>
    </section>
  ))}
  <OtherServices locale={locale} current={service} />
</div>
