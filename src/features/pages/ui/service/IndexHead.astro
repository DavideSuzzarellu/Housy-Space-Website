---
import type { PageItem } from "@/features/pages/application/pages";
import Emphasis from "@/shared/ui/atoms/Emphasis.astro";

/** Tag and `*emphasised*` h2 of a services index section (reference `.sx-h`). */
interface Props {
  items: readonly PageItem[];
  /** Id of the h2, so the section can be labelled by it. */
  id: string;
  /** The light part drops to its own line (advice, situations). */
  stacked?: boolean;
  class?: string;
}

const { items, id, stacked = false, class: className } = Astro.props;
const tag = items.find((item) => item.kind === "tag");
const heading = items.find((item) => item.kind === "h2");
---

<div class={className}>
  {tag?.kind === "tag" && <p class="text-[0.6875rem] tracking-[0.16em] text-accent">{tag.text}</p>}
  {heading?.kind === "h2" && (
    <h2
      id={id}
      data-reveal
      class:list={[
        "mt-2.5 text-[clamp(25px,2.65vw,38px)]",
        stacked && "[&_em]:block max-[899px]:[&_em]:inline",
      ]}
    >
      <Emphasis text={heading.text} />
    </h2>
  )}
</div>
