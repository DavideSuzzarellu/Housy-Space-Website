---
import type { ItemOf } from "@/features/pages/application/pages";
import type { Locale } from "@/shared/i18n/config";
import Inline from "@/shared/ui/atoms/Inline.astro";

/** Three questions side by side (reference `.sx-trio`), each with its big word. */
interface Props {
  locale: Locale;
  list: ItemOf<"list">;
}

const { locale, list } = Astro.props;
---

<ul class="grid gap-7.5 min-[800px]:grid-cols-[repeat(3,1fr)] min-[800px]:gap-0">
  {list.items.map((entry) => (
    <li
      data-reveal
      class="min-[800px]:pr-[clamp(24px,3vw,40px)] min-[800px]:not-first:border-l min-[800px]:not-first:border-line-strong min-[800px]:not-first:pl-[clamp(24px,3vw,40px)]"
    >
      <b class="mb-4.5 block font-heading text-[clamp(54px,calc(6.4vw-2px),90px)] leading-[0.9] font-normal text-accent">
        {entry.kicker}
      </b>
      <h3 class="mb-2 text-[clamp(22px,1.9vw,26px)]">{entry.title}</h3>
      <p class="max-w-[36ch] text-[13.5px] leading-[1.6] text-muted">
        <Inline text={entry.text} locale={locale} />
      </p>
    </li>
  ))}
</ul>
