---
import { itemsOf, splitBlockHead, type PageItem } from "@/features/pages/application/pages";
import type { Locale } from "@/shared/i18n/config";
import Inline from "@/shared/ui/atoms/Inline.astro";
import IndexHead from "./IndexHead.astro";
import NumberedSteps from "./NumberedSteps.astro";

/**
 * "How we help you" block of the services index (reference `.sa25`): headline beside an intro
 * and four numbered steps on a hairline; the last bullet is turquoise. One column below 900 px.
 */
interface Props {
  locale: Locale;
  items: readonly PageItem[];
  id: string;
}

const { locale, items, id } = Astro.props;
const { head, body } = splitBlockHead(items);
const intro = itemsOf(body, "p")[0];
const steps = itemsOf(body, "steps")[0];
---

<div class="mb-[clamp(30px,3.8vw,54px)] grid gap-[clamp(24px,5vw,76px)] min-[900px]:gap-[clamp(14px,2.4vh,22px)]">
  <IndexHead items={head} id={id} stacked />
  {intro && (
    <p
      data-reveal
      class="max-w-[56ch] text-[clamp(15px,1.12vw,17px)] leading-[1.65] min-[900px]:max-w-none tracking-[0.03em] text-fg-2 normal-case"
    >
      <Inline text={intro.text} locale={locale} />
    </p>
  )}
</div>
{steps && <NumberedSteps item={steps} />}
