---
import type { ItemOf, PageItem } from "@/features/pages/application/pages";
import type { Locale } from "@/shared/i18n/config";
import Inline from "@/shared/ui/atoms/Inline.astro";
import BlockHead from "./BlockHead.astro";

/** What a service includes (reference `.sx-check`): sticky heading beside a two-column checklist. */
interface Props {
  locale: Locale;
  head: readonly PageItem[];
  list: ItemOf<"list">;
}

const { locale, head, list } = Astro.props;
---

<div class="grid gap-x-16 gap-y-2.5 min-[960px]:grid-cols-[4fr_7fr] min-[960px]:items-start">
  <BlockHead locale={locale} items={head} class="min-[960px]:sticky min-[960px]:top-30" />
  <ul class="grid gap-x-9 min-[700px]:grid-cols-2">
    {list.items.map((entry) => (
      <li
        data-reveal
        class="relative border-t border-line-strong py-4.5 pl-8 before:absolute before:top-6 before:left-0.5 before:h-[7px] before:w-3 before:-rotate-45 before:border-b-[1.6px] before:border-l-[1.6px] before:border-accent"
      >
        <b class="mb-[5px] block font-heading text-[19px] leading-[1.2] font-normal">
          {entry.title}
        </b>
        <span class="block text-[12.5px] leading-[1.55] text-muted">
          <Inline text={entry.text} locale={locale} />
        </span>
      </li>
    ))}
  </ul>
</div>
