---
import type { ItemOf } from "@/features/pages/application/pages";
import type { Locale } from "@/shared/i18n/config";
import Inline from "@/shared/ui/atoms/Inline.astro";

/**
 * Numbered process (reference `.svp-steps .svp-tl`, v46): slabs with a cut corner and a turquoise
 * bar that draws in; the last slab is petrol. As `list`, one step per row (reformas).
 */
interface Props {
  locale: Locale;
  item: ItemOf<"steps">;
  variant?: "timeline" | "list";
}

const { locale, item, variant = "timeline" } = Astro.props;
const count = item.items.length;
/** 3, 5 and 6 steps run in three columns; the rest in four (reference `.n3 .n5 .n6`). */
const THREE_COLUMNS = new Set([3, 5, 6]);
const list = variant === "list";
const SLAB =
  "relative bg-fg/5 px-5.5 pt-5 pb-5.5 min-[900px]:py-4 [clip-path:polygon(0_0,calc(100%-22px)_0,100%_22px,100%_100%,0_100%)] transition-[background-color,translate] duration-400 ease-brand hover:-translate-y-[3px] hover:bg-fg/[0.085] motion-reduce:transition-none before:absolute before:inset-x-0 before:top-0 before:h-[3px] before:origin-left before:bg-turquoise before:transition-transform before:duration-1100 before:ease-brand motion-reduce:before:transition-none [.motion-ready_&:not(.is-revealed)]:before:scale-x-0 last:bg-dark last:text-paper";
---

<ol
  class:list={[
    "grid",
    list
      ? "ml-auto max-w-205"
      : [
          "mt-[clamp(22px,4vh,40px)] grid-cols-1 gap-3 min-[620px]:grid-cols-2",
          THREE_COLUMNS.has(count) ? "min-[960px]:grid-cols-3" : "min-[960px]:grid-cols-4",
        ],
  ]}
>
  {item.items.map((entry, index) => (
    <li
      data-reveal
      class:list={[
        list
          ? "relative grid grid-cols-[90px_1fr] gap-x-5 gap-y-1 border-t border-line-strong py-6.5"
          : SLAB,
      ]}
    >
      <b
        aria-hidden="true"
        class:list={[
          "block leading-none",
          list
            ? "row-span-2 mb-2.5 font-heading text-[38px] font-normal text-turquoise-deep/55"
            : "mb-[clamp(10px,1.8vh,16px)] font-sans text-[clamp(34px,3.2vw,46px)] font-light tracking-[0.01em] text-accent in-[li:last-child]:text-turquoise",
        ]}
      >
        {String(index + 1).padStart(2, "0")}
      </b>
      <h3
        class:list={[
          "wrap-break-word",
          list
            ? "mb-2 text-[26px] min-[860px]:text-[18px]"
            : "mb-2 font-sans text-[clamp(14.5px,1.2vw,17px)] leading-[1.25] font-bold tracking-[0.03em]",
        ]}
      >
        {entry.title}
      </h3>
      <p
        class:list={[
          list
            ? "mb-3.5 max-w-137.5 text-[13px] text-muted"
            : "text-sm leading-[1.6] tracking-[0.02em] text-mid normal-case in-[li:last-child]:text-paper/85",
        ]}
      >
        <Inline text={entry.text} locale={locale} />
      </p>
    </li>
  ))}
</ol>
