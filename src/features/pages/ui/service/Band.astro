---
import { itemsOf, type PageItem } from "@/features/pages/application/pages";
import type { Locale } from "@/shared/i18n/config";
import Emphasis from "@/shared/ui/atoms/Emphasis.astro";
import Inline from "@/shared/ui/atoms/Inline.astro";

/** Dark band with the motto (reference `.sx-band`): the quote (light part in `*asterisks*`) and a line. */
interface Props {
  locale: Locale;
  items: readonly PageItem[];
}

const { locale, items } = Astro.props;
const quote = itemsOf(items, "bandQuote")[0];
const line = itemsOf(items, "p")[0];
---

{quote && (
  <p
    data-reveal
    class="mx-auto font-heading text-[clamp(22px,2.4vw,34px)] leading-[1.28] font-black tracking-[0.03em] text-balance text-fg after:mx-auto after:mt-6.5 after:block after:h-0.5 after:w-16 after:bg-turquoise [&_em]:font-normal"
  >
    <Emphasis text={quote.text} />
  </p>
)}
{line && (
  <p
    data-reveal
    class="mx-auto mt-5.5 max-w-[62ch] text-[clamp(15px,1.12vw,16.5px)] leading-[1.62] tracking-[0.28px] text-muted text-pretty"
  >
    <Inline text={line.text} locale={locale} />
  </p>
)}
