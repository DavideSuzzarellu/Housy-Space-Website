---
import type { ItemOf } from "@/features/pages/application/pages";
import type { Locale } from "@/shared/i18n/config";
import { resolveContentHref } from "@/shared/i18n/contentLinks";
import ArrowUpRight from "@/shared/ui/atoms/ArrowUpRight.astro";

/**
 * Everyday situations of the services index (reference `.sq26`): rounded paper rows with the
 * question, a line, the service that answers it and a round arrow. Two columns from 900 px.
 */
interface Props {
  locale: Locale;
  list: ItemOf<"list">;
}

const { locale, list } = Astro.props;
---

<ul class="grid gap-2.5 min-[900px]:grid-cols-2">
  {list.items.map((entry) => (
    <li data-reveal>
      <a
        href={entry.href === undefined ? undefined : resolveContentHref(entry.href, locale)}
        class="group grid h-full grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3.5 gap-y-2.5 rounded-[14px] bg-paper px-[clamp(16px,1.8vw,24px)] py-[clamp(14px,1.5vw,20px)] text-fg no-underline transition-[background-color,color,translate] duration-400 ease-brand hover:bg-dark hover:text-paper focus-visible:bg-dark focus-visible:text-paper min-[600px]:grid-cols-[minmax(0,1fr)_minmax(0,auto)_auto] min-[600px]:gap-x-[clamp(14px,2vw,28px)] min-[600px]:gap-y-0 min-[900px]:grid-cols-[minmax(0,1fr)_auto] min-[900px]:gap-x-7 min-[900px]:gap-y-2 min-[900px]:hover:-translate-y-[3px] min-[900px]:focus-visible:-translate-y-[3px] motion-reduce:transition-none"
      >
        <span class="block">
          <h3 class="font-sans text-[clamp(18px,1.65vw,23.76px)] leading-[1.15] text-inherit">
            {entry.title}
          </h3>
          <span class="mt-1.25 block text-[13.5px] leading-[1.5] text-muted normal-case transition-colors duration-400 group-hover:text-paper/80 group-focus-visible:text-paper/80">
            {entry.text}
          </span>
        </span>
        <span class="col-start-1 row-start-2 text-[10.5px] leading-[1.45] font-semibold tracking-[0.14em] text-accent transition-colors duration-400 group-hover:text-turquoise group-focus-visible:text-turquoise min-[600px]:col-start-2 min-[600px]:row-start-1 min-[600px]:max-w-[17em] min-[600px]:text-right min-[900px]:col-start-1 min-[900px]:row-start-2 min-[900px]:max-w-none min-[900px]:text-left">
          {entry.kicker}
        </span>
        <span
          aria-hidden="true"
          class="col-start-2 row-span-2 row-start-1 grid size-10 place-items-center rounded-full bg-dark text-paper transition-[background-color,color,rotate] duration-400 ease-brand group-hover:rotate-45 group-hover:bg-turquoise group-hover:text-ink group-focus-visible:rotate-45 group-focus-visible:bg-turquoise group-focus-visible:text-ink min-[600px]:col-start-3 min-[600px]:row-span-1 min-[600px]:size-11 min-[900px]:col-start-2 min-[900px]:row-span-2"
        >
          <ArrowUpRight class="size-3.25" />
        </span>
      </a>
    </li>
  ))}
</ul>
