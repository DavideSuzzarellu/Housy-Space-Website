---
import type { PageItem } from "@/features/pages/application/pages";
import Emphasis from "@/shared/ui/atoms/Emphasis.astro";
import Inline from "@/shared/ui/atoms/Inline.astro";
import type { Locale } from "@/shared/i18n/config";

/** Heading block of a service section (reference `.sx-h`): tag, h2 and lead. */
interface Props {
  locale: Locale;
  items: readonly PageItem[];
  /** Space below it; off when the body sits beside it. */
  spaced?: boolean;
  /** Heading limited to 760 px; off for the process blocks, whose title runs the full width. */
  narrow?: boolean;
  class?: string;
}

const { locale, items, spaced = true, narrow = true, class: className } = Astro.props;
---

{items.length > 0 && (
  <div
    class:list={[narrow && "max-w-190", spaced && "mb-[clamp(1.75rem,3.4vw,2.875rem)]", className]}
  >
    {items.map((item) => {
      if (item.kind === "tag")
        return <p class="text-[0.6875rem] tracking-[0.16em] text-accent">{item.text}</p>;
      if (item.kind === "h2")
        return (
          <h2 data-reveal class="mt-2.5 mb-0 text-[clamp(25px,2.8vw,38px)] first:mt-0">
            <Emphasis text={item.text} />
          </h2>
        );
      if (item.kind === "lead")
        return (
          <p class="mt-4 text-[clamp(15px,1.12vw,16.5px)] leading-[1.62] tracking-[0.28px] text-muted normal-case">
            <Inline text={item.text} locale={locale} />
          </p>
        );
      return null;
    })}
  </div>
)}
