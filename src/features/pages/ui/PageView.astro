---
import { Picture } from "astro:assets";
import { groupItems, type PageContent, type PageItem } from "@/features/pages/application/pages";
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { PHOTO_PICTURE } from "@/shared/lib/images";
import Container from "@/shared/ui/atoms/Container.astro";
import Emphasis from "@/shared/ui/atoms/Emphasis.astro";
import MediaCredit from "@/shared/ui/atoms/MediaCredit.astro";
import Breadcrumbs from "@/shared/ui/molecules/Breadcrumbs.astro";
import PaperHero from "@/shared/ui/organisms/PaperHero.astro";
import PageItems from "./PageItems.astro";

/** An editorial page: photo or plain head, then its sections on their surfaces (proposal v3). */
interface Props {
  locale: Locale;
  content: PageContent;
  crumbs: readonly { readonly label: string; readonly href?: string }[];
  /** Untranslated page: marks the Spanish text for screen readers and translators. */
  fallback?: boolean;
  /** Oversized plain head (the "Mi búsqueda" landing): big uppercase title, roomy padding. */
  hero?: boolean;
  /** Paper head of the reference (`PaperHero`: kicker, big title, lead) instead of the photo head. */
  paperHead?: boolean;
}

const { locale, content, crumbs, fallback = false, hero = false, paperHead = false } = Astro.props;
const t = getDictionary(locale);
const image = content.head.items.find((item) => item.kind === "image");
const headItems = content.head.items.filter(
  (item): item is PageItem & typeof item => item.kind !== "image",
);
const hasPhoto = !paperHead && content.head.photo && image !== undefined;
const tag = headItems.find((item) => item.kind === "tag");
const lead = headItems.find((item) => item.kind === "lead");
const SURFACES = {
  paper: "bg-canvas",
  stone: "surface-stone bg-canvas",
  dark: "surface-dark bg-canvas",
} as const;
---

<div lang={fallback ? "es" : undefined} data-page-view>
  {paperHead ? (
    <PaperHero
      locale={locale}
      title={content.head.heading}
      kicker={tag?.kind === "tag" ? tag.text : undefined}
      subtitle={lead?.kind === "lead" ? lead.text : undefined}
      crumbs={crumbs}
    />
  ) : (
    <section
      data-page-head
      class:list={[
        "relative isolate overflow-hidden",
        hero
          ? "pt-[clamp(1.625rem,4vw,3.25rem)] pb-[clamp(3.5rem,8vw,7rem)]"
          : "pt-8 pb-[clamp(2.75rem,6vw,4.5rem)]",
        hasPhoto
          ? "surface-dark flex min-h-[clamp(24rem,50vw,34rem)] flex-col justify-end bg-canvas"
          : "bg-canvas",
      ]}
    >
      {hasPhoto && (
        <>
          <Picture
            {...PHOTO_PICTURE}
            src={image.src}
            alt=""
            widths={[800, 1400]}
            sizes="100vw"
            priority
            class="absolute inset-0 -z-20 size-full object-cover"
          />
          <span
            aria-hidden="true"
            class="absolute inset-0 -z-10 bg-linear-to-b from-ink/55 to-ink/80"
          ></span>
          <MediaCredit tone="onImage" class="absolute right-4 bottom-2">
            {t.media.conceptualImage}
          </MediaCredit>
        </>
      )}
      <Container>
        <Breadcrumbs
          items={crumbs}
          label={t.property.detail.breadcrumb}
          class:list={[hero ? "mb-[clamp(1.875rem,4.4vw,3.625rem)]" : "mb-7"]}
        />
        {headItems
          .filter((item) => item.kind === "tag")
          .map((item) => (
            <p class="mb-3 text-[0.6875rem] tracking-[0.16em] text-accent">
              {item.kind === "tag" && item.text}
            </p>
          ))}
        <h1
          class:list={[
            hero
              ? "mt-4 mb-[clamp(1.5rem,3.4vw,2.5rem)] text-[clamp(2.375rem,6.4vw,5.75rem)] leading-none text-balance [&_em]:block"
              : "max-w-[22ch] text-[clamp(1.875rem,4.8vw,3.5rem)]",
          ]}
        >
          <Emphasis text={content.head.heading} />
        </h1>
        <div
          class:list={[
            "mt-4 max-w-[62ch] text-fg/90",
            hero &&
              "[&_p]:mb-[clamp(1.875rem,4vw,2.875rem)] [&_p]:max-w-[58ch] [&_p]:text-[clamp(0.875rem,1.35vw,1.0625rem)] [&_p]:leading-[1.8] [&_p]:text-fg/85",
          ]}
        >
          <PageItems
            locale={locale}
            buttonSize={hero ? "lg" : "md"}
            units={groupItems(headItems.filter((item) => item.kind !== "tag"))}
          />
        </div>
      </Container>
    </section>
  )}

  {content.sections.map((section, index) => (
    <section
      id={section.id}
      class:list={[
        hero ? "py-[clamp(3.5rem,7vw,6rem)]" : "py-[clamp(2.75rem,5vw,4.125rem)]",
        hero && section.id !== undefined && "[&_h2]:text-[clamp(1.75rem,3.6vw,3rem)]",
        hero &&
          index === content.sections.length - 1 &&
          "py-[clamp(4rem,9vw,8.75rem)] [&_h2]:max-w-[680px] [&_h2]:text-[clamp(2.25rem,4.2vw,3.75rem)] [&_h2]:leading-[1.08] [&_h2]:mb-6 [&_p]:mb-8.5 [&_p]:max-w-[32.25rem] [&_p]:text-[0.9375rem] [&_p]:text-fg/85",
        section.band
          ? "surface-dark bg-canvas py-[clamp(3.5rem,8vw,6.5rem)] text-center"
          : SURFACES[section.surface],
      ]}
    >
      <Container>
        <PageItems
          locale={locale}
          buttonSize={hero ? "lg" : "md"}
          units={groupItems(section.items)}
        />
      </Container>
    </section>
  ))}
</div>
