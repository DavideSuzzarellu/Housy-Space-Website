---
import type { PageItem, RenderUnit } from "@/features/pages/application/pages";
import type { Locale } from "@/shared/i18n/config";
import Inline from "@/shared/ui/atoms/Inline.astro";

/**
 * Long-text items of a legal page (reference `.lg`, design system `TextoLegal`): a narrow column
 * of sentence-case paragraphs under uppercase headings, disc lists and ruled tables. Zero JS.
 * Cards (international guide) are flattened into the same column. A `\n` in a paragraph is a line
 * break (`whitespace-pre-line`), as the reference's `<br>`.
 */
interface Props {
  locale: Locale;
  units: readonly RenderUnit<PageItem>[];
}

const { locale, units } = Astro.props;
const BODY = "max-w-[68ch] text-[0.9375rem] leading-[1.62] normal-case";
const flat = units.flatMap((unit) =>
  unit.type === "group"
    ? unit.items.flatMap((item) =>
        item.kind === "card" || item.kind === "article" ? item.items : [item],
      )
    : [unit.item],
);
---

{flat.map((item) => {
  switch (item.kind) {
    case "h2":
      return (
        <h2 class="mt-11 mb-3 text-[clamp(1.5625rem,2.6vw,1.9375rem)] first:mt-0">{item.text}</h2>
      );
    case "h3":
      return <h3 class="mt-6 mb-2 text-[clamp(1.0625rem,1.7vw,1.375rem)]">{item.text}</h3>;
    case "note":
      return (
        <p class:list={["mb-3.5", BODY]}>
          <Inline text={item.text} locale={locale} />
        </p>
      );
    case "pending":
      return (
        <p class:list={["my-4 border-l-2 border-accent bg-card p-4", BODY]}>
          <Inline text={item.text} locale={locale} />
        </p>
      );
    case "p":
    case "lead":
      return (
        <p class:list={["mb-3.5 whitespace-pre-line", BODY]}>
          <Inline text={item.text} locale={locale} />
        </p>
      );
    case "list":
      return (
        <ul class="mb-3.5 grid list-disc gap-2 pl-5">
          {item.items.map((entry) => (
            <li class={BODY}>
              {entry.title !== "" && <b class="font-bold">{entry.title} </b>}
              <Inline text={entry.text} locale={locale} />
            </li>
          ))}
        </ul>
      );
    case "table":
      return (
        <div class="mt-2 mb-4.5 overflow-x-auto">
          <table class="w-full min-w-160 border-collapse text-left text-xs leading-[1.6]">
            <thead>
              <tr>
                {item.head.map((cell) => (
                  <th
                    scope="col"
                    class="border-b border-line-strong pr-4 pb-2.5 text-[0.65625rem] leading-[1.4] font-medium tracking-[0.14em]"
                  >
                    {cell}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {item.rows.map((row) => (
                <tr>
                  {row.map((cell) => (
                    <td class="border-b border-line py-3.5 pr-4 align-top">
                      <Inline text={cell} locale={locale} />
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      );
    default:
      return null;
  }
})}
