---
import type { HomeContent } from "@/features/agency/application/homeContent";
import type { Testimonial } from "@/features/reviews/domain/review";
import { getDictionary } from "@/shared/i18n";
import type { Locale } from "@/shared/i18n/config";
import { formatDate } from "@/shared/lib/format";
import Button from "@/shared/ui/atoms/Button.astro";
import SectionHeading from "@/shared/ui/molecules/SectionHeading.astro";
import Section from "@/shared/ui/molecules/Section.astro";

/** Latest client reviews from Pages CMS. Renders nothing without any: never fake reviews. */
interface Props {
  locale: Locale;
  content: HomeContent["reviews"];
  testimonials: readonly Testimonial[];
}

const { locale, content, testimonials } = Astro.props;
const t = getDictionary(locale);
const copy = t.home.reviews;
const stars = (rating: number) => "★".repeat(rating).padEnd(5, "☆");
---

{testimonials.length > 0 && (
  <Section id="resenas" labelledBy="reviews-heading" name="reviews" surface="dark">
    <div class="mb-7.5 flex flex-wrap items-end justify-between gap-x-10 gap-y-4.5">
      <SectionHeading id="reviews-heading" heading={content.heading} />
      <Button href={content.mapsUrl} external newTabLabel={t.a11y.opensInNewTab}>
        {content.ctaLabel}
      </Button>
    </div>
    <ul class="grid gap-4 md:grid-cols-3">
      {testimonials.map((testimonial) => (
        <li class="flex flex-col gap-3 bg-white p-6 text-ink">
          <p role="img" class="text-petrol" aria-label={`${testimonial.rating} / 5`}>
            <span aria-hidden="true">{stars(testimonial.rating)}</span>
          </p>
          <p lang={testimonial.language} class="text-[0.9375rem] whitespace-pre-line normal-case">
            {testimonial.text}
          </p>
          <p class="mt-auto grid border-t border-ink/10 pt-4 text-[0.8125rem]">
            <b class="font-medium">{testimonial.author}</b>
            <time datetime={testimonial.date.toISOString()} class="text-xs text-ink/70">
              {formatDate(testimonial.date, locale)}
            </time>
          </p>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-xs text-muted">{copy.orderNotice}</p>
  </Section>
)}
